# nekozame os's live installer: nekozame os itself, live (niri with dms), carrying the
# nekozame os image it installs. Adapted from Bazzite's installer (Apache-2.0, see NOTICE.md).
# run with --cap-add sys_admin --security-opt label=disable
ARG BASE_IMAGE=ghcr.io/purplekairi1312/nekozame-os:stable
ARG INSTALL_IMAGE_PAYLOAD=ghcr.io/purplekairi1312/nekozame-os:stable

FROM $BASE_IMAGE
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=./.,target=/src \
    env BASE_IMAGE="$BASE_IMAGE" INSTALL_IMAGE_PAYLOAD="$INSTALL_IMAGE_PAYLOAD" /src/build.sh
