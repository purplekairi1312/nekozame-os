#!/usr/bin/bash
# the live desktop's welcome: install nekozame os, or look around first
if [[ ! -d /sys/firmware/efi ]]; then
    yad --undecorated --on-top --timeout=0 --button="Shut down:0" \
        --text="nekozame os needs UEFI. Turn off CSM/Legacy boot in your PC's UEFI settings, then start it again." || true
    systemctl poweroff
fi
yad --on-top --title="nekozame os" --text-align=center --buttons-layout=center --image=org.fedoraproject.AnacondaInstaller \
    --text="\n<span size='x-large'>Welcome to nekozame os 🦈</span>\n\nThis is nekozame os, running from the USB stick: look around, then install it.\nNothing on this computer changes until you do.\n" \
    --button="Install nekozame os:10" --button="Look around first:0"
[ $? -eq 10 ] && { liveinst & disown; }
exit 0
