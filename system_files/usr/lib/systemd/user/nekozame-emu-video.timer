# a few minutes after login, then every 6 hours: games started through nekozame also get
# theirs as they start; this tidies up (games gone) and covers games started from
# RetroArch's own menu
[Unit]
Description=nekozame's shaders kept up with your library

[Timer]
OnStartupSec=5min
OnUnitActiveSec=6h

[Install]
WantedBy=timers.target
