# before niri starts: on a first niri login, the dankmaterialshell config, so niri never
# writes its stock one (waybar, alacritty); and nekozame's shortcuts in it, once
[Unit]
Description=nekozame os: DankMaterialShell config for niri
Before=niri.service
ConditionPathExists=!%h/.local/state/nekozame/niri-config

[Service]
Type=oneshot
ExecStart=/usr/bin/nekozame-niri-config

[Install]
WantedBy=niri.service
