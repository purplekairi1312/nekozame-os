#!/usr/bin/python3
"""nekozame-audio-follow: sound goes to what you just connected, like on a phone.
plug in headphones and it moves to them, unplug and it comes back (to bluetooth
headphones if they're on, or the speakers); bluetooth headphones that connect take
over too. it's for machines like the steam deck, where the headphone jack and the
speakers are separate outputs and nothing moves the sound between them. choosing an
output yourself still works: this only acts when something is plugged or unplugged.
nekozame-audio-follow.service runs it."""
import json
import subprocess
import time


def pactl(*args):
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def outputs():
    """(bluetooth outputs, plugged-in headphone outputs, speaker outputs, the default)"""
    try:
        cards = json.loads(pactl("-f", "json", "list", "cards") or "[]")
        sinks = json.loads(pactl("-f", "json", "list", "sinks") or "[]")
    except ValueError:
        return None
    plugged = {(c["name"], p) for c in cards for p, v in c.get("ports", {}).items()
               if v.get("type") == "Headphones" and v.get("availability") == "available"}
    bt, phones, speakers = [], [], []
    for s in sinks:
        props, port = s.get("properties", {}), s.get("active_port") or ""
        if props.get("device.bus") == "bluetooth" or s["name"].startswith("bluez_output."):
            bt.append(s["name"])
        elif (props.get("device.name"), port) in plugged:
            phones.append(s["name"])
        elif "Speaker" in port:
            speakers.append(s["name"])
    return bt, phones, speakers, pactl("get-default-sink").strip()


def main():
    seen_bt, seen_phones = set(), set()
    first = True
    proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
    while True:
        now = outputs()
        if now:
            bt, phones, speakers, default = now
            new = [s for s in bt if s not in seen_bt] + [s for s in phones if s not in seen_phones]
            lost = (seen_bt - set(bt)) | (seen_phones - set(phones))
            if new and (not first or default not in bt):
                pick = new[0]  # what just came, bluetooth first
            elif lost:
                pick = (bt + phones + speakers + [None])[0]  # what's still there
            else:
                pick = None
            if pick and pick != default:
                pactl("set-default-sink", pick)
            seen_bt, seen_phones, first = set(bt), set(phones), False
        # wait for something to change on a card or an output
        while True:
            line = proc.stdout.readline()
            if not line:
                return  # pipewire went away: systemd starts this again
            if " on card " in line or " on sink " in line and ("'new'" in line or "'remove'" in line):
                time.sleep(0.5)  # let pipewire settle
                break


if __name__ == "__main__":
    main()
