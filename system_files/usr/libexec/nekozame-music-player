#!/usr/bin/python3
"""nekozame music's player: mpv in the background, so music keeps going while you
play a game, with a small control api for the app and for the card in steam's quick
access menu. the api only listens on this machine (127.0.0.1:47820).

  GET  /state                  what's playing, as json
  GET  /toggle /next /prev /stop
  GET  /volume?d=5             louder (or d=-5, quieter)
  POST /play  {"items": [{"url", "title", "artist"}], "append": false}
               with the token from $XDG_RUNTIME_DIR/nekozame-music.token (the app's)

websites can't use it: requests from a web page are turned away (only steam's own
menus and programs here get in), and loading music needs the token, which only
your user can read. nekozame-music-player.service runs it.
"""
import json
import os
import socket
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

PORT = 47820
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCK = os.path.join(RUN, "nekozame-music.sock")
YTDLP = os.path.expanduser("~/.local/share/nekozame/yt-dlp")
TOKEN_FILE = os.path.join(RUN, "nekozame-music.token")
TOKEN = os.urandom(16).hex()


class Mpv:
    """talks to mpv over its json ipc socket."""
    def __init__(self):
        self.lock = threading.Lock()
        self.req = 0
        self.proc = None
        self.start()

    def start(self):
        if os.path.exists(SOCK):
            os.remove(SOCK)
        self.proc = subprocess.Popen([
            "mpv", "--idle=yes", "--no-video", "--no-terminal", "--force-window=no",
            f"--input-ipc-server={SOCK}", "--ytdl-format=bestaudio/best",
            f"--script-opts=ytdl_hook-ytdl_path={YTDLP}", "--volume=70",
        ])
        for _ in range(50):
            if os.path.exists(SOCK):
                return
            time.sleep(0.1)

    def command(self, *args):
        with self.lock:
            if self.proc.poll() is not None:
                self.start()
            self.req += 1
            rid = self.req
            try:
                with socket.socket(socket.AF_UNIX) as s:
                    s.settimeout(3)
                    s.connect(SOCK)
                    s.sendall((json.dumps({"command": list(args), "request_id": rid}) + "\n").encode())
                    buf = b""
                    while True:
                        chunk = s.recv(65536)
                        if not chunk:
                            return None
                        buf += chunk
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            msg = json.loads(line)
                            if msg.get("request_id") == rid:
                                return msg.get("data") if msg.get("error") == "success" else None
            except (OSError, ValueError):
                return None

    def get(self, prop, default=None):
        v = self.command("get_property", prop)
        return default if v is None else v


mpv = None


def state():
    idle = mpv.get("idle-active", True)
    title = mpv.get("media-title", "")
    meta = mpv.get("metadata", {}) or {}
    artist = meta.get("artist") or meta.get("ARTIST") or ""
    if " — " in title and not artist:  # the app passes "artist — title"
        artist, title = title.split(" — ", 1)
    return {
        "idle": bool(idle),
        "title": "" if idle else title,
        "artist": "" if idle else artist,
        "paused": bool(mpv.get("pause", False)),
        "position": mpv.get("time-pos", 0) or 0,
        "duration": mpv.get("duration", 0) or 0,
        "volume": mpv.get("volume", 70),
        "track": (mpv.get("playlist-pos", -1) or 0) + 1,
        "tracks": mpv.get("playlist-count", 0),
    }


def play(items, append):
    for i, it in enumerate(items):
        title = it.get("title", "")
        if it.get("artist"):
            title = f'{it["artist"]} — {title}'
        flag = "append-play" if (append or i > 0) else "replace"
        opts = f"force-media-title={title}" if title else ""
        mpv.command("loadfile", it["url"], flag, -1, opts)
    mpv.command("set_property", "pause", False)


def from_a_website(headers):
    """a web page's request carries its address; steam's menus are about:blank (null)."""
    for h in ("Origin", "Referer"):
        v = headers.get(h, "")
        if v.startswith(("http://", "https://")) and not v.startswith("https://steamloopback.host"):
            return True
    return False


class Api(BaseHTTPRequestHandler):
    def reply(self, data, code=200):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")  # the card in steam's quick access
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if from_a_website(self.headers):
            return self.reply({"error": "not from websites"}, 403)
        u = urlparse(self.path)
        if u.path == "/state":
            return self.reply(state())
        if u.path == "/toggle":
            mpv.command("cycle", "pause")
        elif u.path == "/next":
            mpv.command("playlist-next", "force")
        elif u.path == "/prev":
            mpv.command("playlist-prev", "force")
        elif u.path == "/stop":
            mpv.command("stop")
        elif u.path == "/volume":
            d = float(parse_qs(u.query).get("d", ["5"])[0])
            mpv.command("add", "volume", d)
        else:
            return self.reply({"error": "unknown"}, 404)
        self.reply(state())

    def do_POST(self):
        if urlparse(self.path).path != "/play":
            return self.reply({"error": "unknown"}, 404)
        if from_a_website(self.headers) or self.headers.get("X-Nekozame-Token") != TOKEN:
            return self.reply({"error": "no"}, 403)
        n = int(self.headers.get("Content-Length", 0))
        data = json.loads(self.rfile.read(n) or b"{}")
        play(data.get("items", []), data.get("append", False))
        self.reply(state())

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def log_message(self, *a):
        pass


def main():
    global mpv
    mpv = Mpv()
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, TOKEN.encode())
    os.close(fd)
    ThreadingHTTPServer(("127.0.0.1", PORT), Api).serve_forever()


if __name__ == "__main__":
    main()
