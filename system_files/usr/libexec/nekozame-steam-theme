#!/usr/bin/python3
"""nekozame's steam theme, without decky: puts the nekozame colors into steam's own
pages (game mode, big picture, its menus, notifications, the store, the desktop
client) through steam's debugging port, which only listens on this machine, and
again whenever steam reloads one. nekozame-steam-theme.service runs it.
"""
import base64
import json
import os
import socket
import struct
import time
import urllib.request

CSS = "/usr/share/nekozame-os/steam/nekozame.css"
JS = "/usr/share/nekozame-os/steam/nekozame.js"  # swaps the colours steam sets itself
PORT = 8080
STEAM = os.path.expanduser("~/.local/share/Steam")
STYLE = ("(function(css){var s=document.getElementById('nekozame-theme');"
      "if(!s){s=document.createElement('style');s.id='nekozame-theme';"
      "(document.head||document.documentElement).appendChild(s);}"
      "if(s.textContent!==css){s.textContent=css;}})(%s)")


def evaluate(ws_url, expression, answer=False):
    """one devtools call over a bare websocket (the standard library has none). with
    answer, it returns the expression's value."""
    rest = ws_url.split("://", 1)[1]
    hostport, path = rest.split("/", 1)
    host, port = hostport.split(":")
    with socket.create_connection((host, int(port)), timeout=5) as s:
        key = base64.b64encode(os.urandom(16)).decode()
        s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                   f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        if b" 101 " not in s.recv(1024):
            return
        payload = json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {"expression": expression}}).encode()
        n = len(payload)
        head = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else
                                bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536 else
                                bytes([0x80 | 127]) + struct.pack(">Q", n))
        mask = os.urandom(4)
        s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))
        if not answer:
            s.recv(65536)  # the answer; nothing in it we need
            return None
        buf = b""
        def need(k):
            nonlocal buf
            while len(buf) < k:
                chunk = s.recv(1 << 16)
                if not chunk:
                    raise OSError("closed")
                buf += chunk
        while True:  # frames until our answer (id 1)
            need(2)
            n, off = buf[1] & 0x7F, 2
            if n == 126:
                need(4); n, off = struct.unpack(">H", buf[2:4])[0], 4
            elif n == 127:
                need(10); n, off = struct.unpack(">Q", buf[2:10])[0], 10
            need(off + n)
            msg, buf = json.loads(buf[off:off + n]), buf[off + n:]
            if msg.get("id") == 1:
                return msg.get("result", {}).get("result", {}).get("value")


def steam_page(t):
    """steam's own interface, and valve's store and community pages (the same dark
    blue design), but not people's profiles: they pick their own colours and art."""
    url = t.get("url", "")
    if t.get("type") != "page":
        return False
    if url.startswith(("https://steamloopback.host", "about:blank", "data:")):  # data: is the store view
        return True
    valve = url.startswith(("https://store.steampowered.com", "https://steamcommunity.com"))
    return valve and "/id/" not in url and "/profiles/" not in url


CDN = {}  # stylesheets fetched for pages that can't fetch them themselves


def hand_over_stylesheets(ws_url):
    """web pages (the store) load their styles from steam's cdn, which pages can't
    read; fetch those from here and give them to nekozame.js to recolour."""
    hrefs = json.loads(evaluate(ws_url, "JSON.stringify(window.__nekozameUnreadable ? "
                                        "window.__nekozameUnreadable() : [])", answer=True) or "[]")
    for href in hrefs:
        if not href.startswith("https://") or "steamstatic.com" not in href:
            continue
        if href not in CDN:
            with urllib.request.urlopen(href, timeout=10) as r:
                CDN[href] = r.read().decode("utf-8", "replace")
        evaluate(ws_url, "window.__nekozameCopy(%s, %s)" % (json.dumps(href), json.dumps(CDN[href])))


def main():
    while True:
        # steam opens its debugging port when this file is there
        if os.path.isdir(STEAM):
            flag = os.path.join(STEAM, ".cef-enable-remote-debugging")
            if not os.path.exists(flag):
                open(flag, "a").close()
        try:
            css = open(CSS).read()
            script = open(JS).read() if os.path.exists(JS) else ""
            with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json", timeout=3) as r:
                targets = json.load(r)
            for t in targets:
                if steam_page(t) and t.get("webSocketDebuggerUrl"):
                    try:
                        evaluate(t["webSocketDebuggerUrl"], STYLE % json.dumps(css))
                        if script:  # it only does its work once per page
                            evaluate(t["webSocketDebuggerUrl"], script)
                            if t.get("url", "").startswith("https://"):
                                hand_over_stylesheets(t["webSocketDebuggerUrl"])
                    except OSError:
                        pass
        except (OSError, ValueError):
            pass  # steam isn't running (yet)
        time.sleep(4)


if __name__ == "__main__":
    main()
