def say(*a):
    print(*a, flush=True)


def settings():
    s = {"roms": ["~/Emulation/roms"], "bios": "~/Emulation/bios",
         "media": ["~/Emulation/tools/downloaded_media", "~/ES-DE/downloaded_media"],
         "steam": {"roms": None, "names": "file"}}
    try:
        user = json.load(open(CONFIG))
        steam = {**s["steam"], **user.pop("steam", {})}
        s.update(user)
        s["steam"] = steam
    except (OSError, ValueError):
        pass
    ex = lambda p: os.path.expanduser(p)
    s["roms"] = [ex(p) for p in s["roms"]]
    s["bios"] = ex(s["bios"])
    s["media"] = [ex(p) for p in s["media"]]
    s["steam"]["roms"] = [ex(p) for p in (s["steam"]["roms"] or s["roms"][:1])]
    return s


def emulator_of(system):
    emu = SYSTEMS[system][1]
    return ("retroarch", emu[5:]) if emu.startswith("core:") else (emu, None)


def installed(app):
    return subprocess.run(["flatpak", "info", app], capture_output=True).returncode == 0


# --- games -----------------------------------------------------------------------

def games(root, system):
    """the games in root/system: one file each (a disc playlist, not its discs; a cue,
    not its bins)."""
    folder = os.path.join(root, system)
    exts = SYSTEMS[system][2]
    found, parts = [], set()
    for d, dirs, names in os.walk(folder, followlinks=True):
        dirs[:] = [x for x in dirs if not x.startswith(".") and x not in ("media", "images", "videos", "manuals")]
        for n in names:
            ext = n.rsplit(".", 1)[-1].lower() if "." in n else ""
            if ext not in exts:
                continue
            path = os.path.join(d, n)
            if ext in ("m3u", "cue", "gdi", "ccd"):  # the files they point at aren't games
                try:
                    for line in open(path, errors="replace"):
                        line = line.strip()
                        m = re.match(r'FILE\s+"?(.+?)"?\s+\w+$', line, re.I) if ext == "cue" else None
                        ref = m.group(1) if m else (line if ext == "m3u" and line and not line.startswith("#") else None)
                        if ext == "gdi":
                            ref = (line.split() + [""] * 5)[4].strip('"') or None
                        if ref:
                            parts.add(os.path.normpath(os.path.join(d, ref)))
                except OSError:
                    pass
            found.append(path)
    games = [p for p in found if os.path.normpath(p) not in parts]
    # a game in several formats side by side: the format earliest in the list wins
    best = {}
    for p in games:
        key = os.path.splitext(p)[0]
        rank = exts.index(p.rsplit(".", 1)[-1].lower())
        if key not in best or rank < best[key][0]:
            best[key] = (rank, p)
    return sorted(p for _, p in best.values())


def name_of(rom, system, s):
    """your file name (regions and versions included), or es-de's scraped name."""
    name = os.path.splitext(os.path.basename(rom))[0]
    if s["steam"].get("names") == "scraped":
        for gl in (os.path.join(HOME, "ES-DE/gamelists", system, "gamelist.xml"),):
            try:
                xml = open(gl, errors="replace").read()
                for g in re.finditer(r"<game>(.*?)</game>", xml, re.S):
                    path = re.search(r"<path>(.*?)</path>", g.group(1))
                    if path and os.path.basename(path.group(1)) == os.path.basename(rom):
                        scraped = re.search(r"<name>(.*?)</name>", g.group(1))
                        if scraped:
                            return scraped.group(1)
            except OSError:
                pass
    return name


# --- playing -----------------------------------------------------------------------

def core(name):
    """a retroarch core, downloaded from libretro's buildbot the first time."""
    path = os.path.join(RA_CORES, f"{name}_libretro.so")
    if not os.path.exists(path):
        os.makedirs(RA_CORES, exist_ok=True)
        say(f"getting retroarch's {name} core")
        tmp = path + ".zip"
        urllib.request.urlretrieve(f"{BUILDBOT}/{name}_libretro.so.zip", tmp)
        with zipfile.ZipFile(tmp) as z:
            z.extract(f"{name}_libretro.so", RA_CORES)
        os.remove(tmp)
    return path


def sync_saves(emu):
    folders = EMULATORS[emu].get("saves")
    if folders and shutil.which("nekozame-saves"):
        subprocess.run(["nekozame-saves", "sync", emu], timeout=600)


def launch(system, rom):
    emu, core_name = emulator_of(system)
    e = EMULATORS[emu]
    if emu == "retroarch":
        cmd = ["flatpak", "run", RA, "-f", "-L", core(core_name), rom]
    else:
        cmd = ["flatpak", "run", e["flatpak"]] + [a.replace("{rom}", rom) for a in e["run"]]
    try:
        sync_saves(emu)
    except (OSError, subprocess.SubprocessError) as err:
        say(f"saves didn't sync before playing: {err}")
    code = subprocess.call(cmd)
    try:
        sync_saves(emu)
    except (OSError, subprocess.SubprocessError) as err:
        say(f"saves didn't sync after playing: {err}")
    return code


# --- setup -------------------------------------------------------------------------

def set_ini(path, section, values):
    """key = value lines in an ini section, the rest of the file as it was."""
    lines = open(path, errors="replace").read().splitlines() if os.path.exists(path) else []
    out, in_section, done = [], False, set()
    for line in lines:
        m = re.match(r"\s*\[(.+)\]\s*$", line)
        if m:
            if in_section:
                out += [f"{k} = {v}" for k, v in values.items() if k not in done]
            in_section = m.group(1) == section
        elif in_section:
            k = line.split("=", 1)[0].strip()
            if k in values:
                out.append(f"{k} = {values[k]}")
                done.add(k)
                continue
        out.append(line)
    if in_section:
        out += [f"{k} = {v}" for k, v in values.items() if k not in done]
    elif section not in [re.sub(r"[\[\]\s]", "", l) for l in lines]:
        out += ["", f"[{section}]"] + [f"{k} = {v}" for k, v in values.items()]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(path + ".new", path)


def link_saves(emu):
    """saves/<emu>/<name> -> where the emulator keeps them, unless something's there."""
    for name, there in (EMULATORS[emu].get("saves") or {}).items():
        if not there:
            continue
        here = os.path.join(HOME, "Emulation/saves", emu, name)
        target = os.path.join(VAR, there)
        if os.path.lexists(here):
            continue  # yours (or emudeck's): kept as it is
        os.makedirs(target, exist_ok=True)
        os.makedirs(os.path.dirname(here), exist_ok=True)
        os.symlink(target, here)


def configure(emu, s):
    saves = os.path.join(HOME, "Emulation/saves")
    if emu == "pcsx2":
        ini = os.path.join(VAR, "net.pcsx2.PCSX2/config/PCSX2/inis/PCSX2.ini")
        for d in ("saves", "states"):
            os.makedirs(os.path.join(saves, "pcsx2", d), exist_ok=True)
        set_ini(ini, "Folders", {"Bios": s["bios"], "MemoryCards": f"{saves}/pcsx2/saves",
                                 "SaveStates": f"{saves}/pcsx2/states"})
        set_ini(ini, "UI", {"SetupWizardIncomplete": "false", "StartFullscreen": "true"})
    elif emu == "retroarch":
        cfg = os.path.join(VAR, RA, "config/retroarch/retroarch.cfg")
        if os.path.exists(cfg):
            text = open(cfg, errors="replace").read()
            if 'system_directory = "default"' in text or "system_directory" not in text:
                text = re.sub(r'^system_directory = .*$', "", text, flags=re.M).rstrip("\n")
                open(cfg, "w").write(text + f'\nsystem_directory = "{s["bios"]}"\n')
    link_saves(emu)


def setup(everything=False):
    s = settings()
    for d in ("roms", "bios", "saves"):
        os.makedirs(os.path.join(HOME, "Emulation", d), exist_ok=True)
    have = {}
    for system in SYSTEMS:
        os.makedirs(os.path.join(HOME, "Emulation/roms", system), exist_ok=True)
        n = sum(len(games(r, system)) for r in s["roms"])
        if n or everything:
            have[system] = n
    emus = sorted({emulator_of(x)[0] for x in have})
    for emu in emus:
        app = EMULATORS[emu]["flatpak"]
        if not installed(app):
            say(f"installing {app}")
            subprocess.run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", app])
        configure(emu, s)
        say(f"  ✓ {emu}")
    for system in have:
        emu, core_name = emulator_of(system)
        if core_name:
            try:
                core(core_name)
            except OSError as e:
                say(f"  ! {SYSTEMS[system][0]}: couldn't get the {core_name} core ({e})")
    say(f"ready: {', '.join(SYSTEMS[x][0] for x in have) or 'no games found yet'}")


# --- steam -------------------------------------------------------------------------

def steam_js():
    import importlib.machinery
    import importlib.util
    path = "/usr/libexec/nekozame-steam-theme"
    spec = importlib.util.spec_from_loader("steam_theme", importlib.machinery.SourceFileLoader("steam_theme", path))
    theme = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(theme)
    with urllib.request.urlopen(f"http://127.0.0.1:{theme.PORT}/json", timeout=3) as r:
        ws = next(t["webSocketDebuggerUrl"] for t in json.load(r) if t.get("title") == "SharedJSContext")
    return lambda js, wait=False: theme.evaluate(ws, js, answer=True, wait=wait)


def grids():
    import glob
    return glob.glob(os.path.join(HOME, ".local/share/Steam/userdata/[1-9]*/config/grid"))


def art(system, rom, s):
    """es-de's scraped art for a game: cover, banner, logo, wide."""
    base = os.path.splitext(os.path.basename(rom))[0]
    found = {}
    for media in s["media"]:
        for kind, folders in (("p", ["covers", "3dboxes"]), ("_hero", ["fanart", "screenshots", "titlescreens"]),
                              ("_logo", ["marquees"]), ("", ["screenshots", "titlescreens", "fanart"])):
            if kind in found:
                continue
            for folder in folders:
                for ext in ("png", "jpg"):
                    p = os.path.join(media, system, folder, f"{base}.{ext}")
                    if os.path.exists(p):
                        found[kind] = p
                        break
                if kind in found:
                    break
    return found


_pygame = None


def pygame_ready():
    """pygame for drawing covers (the deck has it), or None."""
    global _pygame
    if _pygame is None:
        try:
            os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
            import pygame
            pygame.display.init()
            pygame.display.set_mode((1, 1))
            pygame.font.init()
            _pygame = pygame
        except Exception:
            _pygame = False
    return _pygame or None


def font(pg, px, bold):
    f = subprocess.run(["fc-match", "-f", "%{file}", "Noto Sans:bold" if bold else "Noto Sans"],
                       capture_output=True, text=True).stdout or None
    return pg.font.Font(f, px)


def wrap(f, text, width, most):
    lines, line = [], ""
    for word in text.split():
        trial = f"{line} {word}".strip()
        if f.size(trial)[0] <= width or not line:
            line = trial
        else:
            lines.append(line)
            line = word
    if line:
        lines.append(line)
    if len(lines) > most:
        lines = lines[:most]
        while f.size(lines[-1] + "…")[0] > width and " " in lines[-1]:
            lines[-1] = lines[-1].rsplit(" ", 1)[0]
        lines[-1] += "…"
    return lines


def labeled_cover(src, name, dest):
    """the cover, fitted to steam's shape, with a band under it: the game's name and,
    in pink, what tells its versions apart (the regions and revisions in brackets)."""
    pg = pygame_ready()
    W, H = 600, 900
    DEEP, PINK, WHITE = (67, 58, 85), (255, 192, 229), (255, 255, 255)
    cover = pg.image.load(src)
    title = re.sub(r"\s*[\(\[].*$", "", name).strip() or name
    details = name[len(title):].strip()
    big, small = font(pg, 36, True), font(pg, 27, False)
    t_lines = wrap(big, title, W - 48, 2)
    d_lines = wrap(small, details, W - 48, 3) if details else []
    band = 28 + len(t_lines) * big.get_linesize() + (8 + len(d_lines) * small.get_linesize() if d_lines else 0) + 24
    canvas = pg.Surface((W, H))
    # behind it: the cover itself, filling and blurred, darkened
    cw, ch = cover.get_size()
    k = max(W / cw, H / ch)
    fill = pg.transform.smoothscale(cover, (max(1, int(cw * k)), max(1, int(ch * k))))
    blur = pg.transform.smoothscale(pg.transform.smoothscale(fill, (24, 36)), (W, H))
    canvas.blit(blur, (0, 0))
    veil = pg.Surface((W, H), pg.SRCALPHA)
    veil.fill((*DEEP, 150))
    canvas.blit(veil, (0, 0))
    # the cover, whole, above the band
    area = H - band
    k = min(W / cw, area / ch)
    fitted = pg.transform.smoothscale(cover, (max(1, int(cw * k)), max(1, int(ch * k))))
    canvas.blit(fitted, ((W - fitted.get_width()) // 2, (area - fitted.get_height()) // 2))
    # the band
    strip = pg.Surface((W, band), pg.SRCALPHA)
    strip.fill((*DEEP, 240))
    canvas.blit(strip, (0, H - band))
    pg.draw.rect(canvas, PINK, (0, H - band, W, 4))
    y = H - band + 24
    for line in t_lines:
        img = big.render(line, True, WHITE)
        canvas.blit(img, ((W - img.get_width()) // 2, y))
        y += big.get_linesize()
    y += 8
    for line in d_lines:
        img = small.render(line, True, PINK)
        canvas.blit(img, ((W - img.get_width()) // 2, y))
        y += small.get_linesize()
    pg.image.save(canvas, dest)


def put_art(appid, system, rom, name, s):
    found = art(system, rom, s)
    for grid in grids():
        for f in os.listdir(grid):  # what was there before (another type, an old cover)
            if re.match(rf"{appid}(p|_hero|_logo|)\.(png|jpg)$", f):
                os.remove(os.path.join(grid, f))
        for kind, path in found.items():
            dest = os.path.join(grid, f"{appid}{kind}.{path.rsplit('.', 1)[-1]}")
            if kind == "p" and s["steam"].get("labels", True) and pygame_ready():
                try:
                    labeled_cover(path, name, os.path.join(grid, f"{appid}p.png"))
                    continue
                except Exception as e:  # a broken picture: the plain one
                    say(f"  ! {name}: {e}")
            shutil.copyfile(path, dest)


def collect(js, added):
    """a collection per system (Saturn, PlayStation 2...) with its games, and one with
    all of them."""
    by_system = {EVERYTHING: [a["appid"] for a in added.values()]} if added else {}
    for a in added.values():
        by_system.setdefault(SYSTEMS[a["system"]][0], []).append(a["appid"])
    for name, ids in sorted(by_system.items()):
        n = js("""(async () => {
            const name = %s;
            let c = collectionStore.userCollections.find(c => c.displayName === name);
            if (!c) { c = collectionStore.NewUnsavedCollection(name, undefined, []); await c.Save();
                      c = collectionStore.userCollections.find(c => c.displayName === name) || c; }
            const apps = %s.map(id => appStore.GetAppOverviewByAppID(id)).filter(Boolean);
            c.AsDragDropCollection().AddApps(apps);
            await c.Save();
            return c.allApps.length;
        })()""" % (json.dumps(name), json.dumps(ids)), wait=True)
        say(f"  {name}: {n} games")


def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {}


def steam_add(systems=None):
    s = settings()
    js = steam_js()
    added = load_state()
    exe = shutil.which("nekozame-emu") or "/usr/bin/nekozame-emu"
    count = 0
    for root in s["steam"]["roms"]:
        for system in SYSTEMS:
            if systems and system not in systems:
                continue
            for rom in games(root, system):
                if rom in added:
                    continue
                name = name_of(rom, system, s)
                options = shlex.join(["launch", system, rom])
                appid = js("SteamClient.Apps.AddShortcut(%s, %s, %s, %s)" % (
                    json.dumps(name), json.dumps(exe), json.dumps(os.path.dirname(exe)), json.dumps(options)), wait=True)
                if not appid:
                    say(f"  ! {name}: steam didn't add it")
                    continue
                js("SteamClient.Apps.SetShortcutName(%d, %s)" % (appid, json.dumps(name)))
                js("SteamClient.Apps.SetShortcutLaunchOptions(%d, %s)" % (appid, json.dumps(options)))
                put_art(appid, system, rom, name, s)
                added[rom] = {"appid": appid, "system": system}
                count += 1
                if count % 20 == 0:
                    say(f"  {count} added")
                    save_state(added)
    save_state(added)
    collect(js, added)
    say(f"{count} games added to steam ({len(added)} in all). restart steam to see all their art.")


def steam_refresh():
    """the art and collections again, for the games already in steam."""
    s = settings()
    js = steam_js()
    added = load_state()
    for i, (rom, a) in enumerate(added.items(), 1):
        put_art(a["appid"], a["system"], rom, name_of(rom, a["system"], s), s)
        if i % 50 == 0:
            say(f"  {i} done")
    collect(js, added)
    say(f"{len(added)} games refreshed. restart steam to see the new art.")


def save_state(added):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".new", "w") as f:
        json.dump(added, f, indent=1)
    os.replace(STATE + ".new", STATE)


def steam_remove():
    js = steam_js()
    added = load_state()
    for rom, a in added.items():
        js("SteamClient.Apps.RemoveShortcut(%d)" % a["appid"])
        for grid in grids():
            for f in os.listdir(grid):
                if f.startswith(str(a["appid"])):
                    os.remove(os.path.join(grid, f))
    tabs(js, remove=True)
    # the collections nekozame made, once they're empty
    for name in sorted({SYSTEMS[a["system"]][0] for a in added.values()} | {EVERYTHING}):
        js("""(async () => {
            const c = collectionStore.userCollections.find(c => c.displayName === %s);
            if (c && c.allApps.length === 0) await c.Delete();
        })()""" % json.dumps(name), wait=True)
    save_state({})
    say(f"{len(added)} games taken out of steam, with their collections (your games and saves are untouched)")


def tabs(js=None, remove=False):
    """tabmaster's tabs (when it's installed): "Apps", your non-steam apps without the
    emulated games; "Emulation", the games; steam's own non-steam tab hidden. other
    tabs you made stay. remove takes ours out and brings steam's back."""
    if not os.path.isdir(os.path.dirname(TABMASTER)):
        if not remove:
            say("  no tabmaster (it comes with nekozame's decky plugins: ujust nekozame-decky)")
        return
    js = js or steam_js()
    user = js("BigInt.asUintN(32, BigInt(App.m_CurrentUser.strSteamID)).toString()")
    coll = js("collectionStore.userCollections.find(c => c.displayName === %s)?.id" % json.dumps(EVERYTHING))
    try:
        cfg = json.load(open(TABMASTER))
    except (OSError, ValueError):
        cfg = {}
    users = cfg.setdefault("usersDict", {})
    me = users.setdefault(user, {"tabs": {}, "friends": [], "friendsGames": {}})
    t = me.get("tabs") or {}
    if not t:  # tabmaster starts from steam's tabs
        for i, (tid, title) in enumerate([("GreatOnDeck", "Great On Deck"), ("AllGames", "All Games"),
                                          ("Installed", "Installed"), ("Favorites", "Favorites"),
                                          ("Collections", "Collections"), ("DesktopApps", "Non-steam"),
                                          ("Soundtracks", "Soundtracks")]):
            t[tid] = {"id": tid, "title": title, "position": i}
    for tid in ("nekozame-apps", "nekozame-emulation"):
        t.pop(tid, None)
    if "DesktopApps" in t:
        t["DesktopApps"]["position"] = -1 if not remove else max(p["position"] for p in t.values()) + 1
    if not remove:
        if not coll:
            say("  no emulation collection yet (nekozame-emu steam add makes it)")
            return
        last = max([p["position"] for p in t.values()] + [0])
        every = 1 | 2 | 8192  # games, software, music
        t["nekozame-apps"] = {"id": "nekozame-apps", "title": "Apps", "position": last + 1,
                              "filters": [{"type": "platform", "inverted": False, "params": {"platform": "nonSteam"}},
                                          {"type": "collection", "inverted": True, "params": {"id": coll, "name": EVERYTHING}}],
                              "filtersMode": "and", "categoriesToInclude": every, "autoHide": False}
        t["nekozame-emulation"] = {"id": "nekozame-emulation", "title": "Emulation", "position": last + 2,
                                   "filters": [{"type": "collection", "inverted": False, "params": {"id": coll, "name": EVERYTHING}}],
                                   "filtersMode": "and", "categoriesToInclude": every, "autoHide": False}
    # positions in order again, the hidden ones staying hidden
    shown = sorted((p for p in t.values() if p["position"] >= 0), key=lambda p: p["position"])
    for i, p in enumerate(shown):
        p["position"] = i
    me["tabs"] = t
    os.makedirs(os.path.dirname(TABMASTER), exist_ok=True)
    with open(TABMASTER + ".new", "w") as f:
        json.dump(cfg, f, indent=4)
    os.replace(TABMASTER + ".new", TABMASTER)
    say("  tabmaster's tabs " + ("taken out" if remove else "are set: Apps and Emulation")
        + " (they show once decky restarts: reboot, or sudo systemctl restart plugin_loader)")


def systems_list():
    s = settings()
    for system, (name, emu, _) in SYSTEMS.items():
        n = sum(len(games(r, system)) for r in s["roms"])
        say(f"  {'●' if n else '○'} {system:16} {name:24} {emu.replace('core:', 'retroarch: '):28} {n or ''}")


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "launch" and len(argv) == 3:
        return launch(argv[1], argv[2])
    if cmd == "setup":
        return setup("--all" in argv)
    if cmd == "steam" and argv[1:2] == ["add"]:
        return steam_add(argv[2:] or None)
    if cmd == "steam" and argv[1:2] == ["remove"]:
        return steam_remove()
    if cmd == "steam" and argv[1:2] == ["refresh"]:
        return steam_refresh()
    if cmd == "steam" and argv[1:2] == ["tabs"]:
        return tabs()
    if cmd == "systems":
        return systems_list()
    say(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
