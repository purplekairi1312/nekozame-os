             "opera": "Opera", "fbneo": "FinalBurn Neo", "mame": "MAME"}


def video_settings(s=None):
    v = {**VIDEO, "shaders": {}, **(s or settings()).get("video", {})}
    v.setdefault("look", "manual" if v["shaders"] else "none")
    if "shaderSystems" in v:  # the first version: one shader for a list of systems
        if v.get("shader") in SHADERS:
            v["shaders"] = {**{x: v["shader"] for x in v["shaderSystems"]}, **v["shaders"]}
        v.pop("shader", None)
        v.pop("shaderSystems", None)
    return v


def machine():
    """this machine's screen and graphics: (width, height), and "handheld", "igpu" or "dgpu"."""
    import glob
    product = ""
    try:
        product = open("/sys/devices/virtual/dmi/id/product_name").read().strip()
    except OSError:
        pass
    if product in ("Jupiter", "Galileo"):  # the steam deck, lcd and oled
        return (1280, 800), "handheld", "Steam Deck"
    screens = []
    for status in glob.glob("/sys/class/drm/card*-*/status"):
        try:
            if open(status).read().strip() != "connected":
                continue
            mode = open(os.path.join(os.path.dirname(status), "modes")).readline().strip()
            screens.append(tuple(int(x) for x in mode.split("x")))
        except (OSError, ValueError):
            continue
    screen = max(screens, key=lambda wh: wh[1], default=(1920, 1080))  # the tallest one connected
    tier = "igpu"
    for dev in glob.glob("/sys/class/drm/card[0-9]/device"):
        try:
            vendor = open(f"{dev}/vendor").read().strip()
            vram = int(open(f"{dev}/mem_info_vram_total").read()) if os.path.exists(f"{dev}/mem_info_vram_total") else 0
        except (OSError, ValueError):
            continue
        if vendor == "0x10de" or (vendor == "0x1002" and vram > 2 << 30):  # nvidia, or amd with its own memory
            tier = "dgpu"
    return screen, tier, {"dgpu": "graphics card", "igpu": "built-in graphics"}[tier]


def scale_for(system, v, m):
    """the internal resolution scale for SYSTEM: the setting, fitted to what its emulator offers."""
    (w, h), tier, _ = m
    res = v["resolution"]
    if res == "native" or is_crt_look(system, v):
        return 1  # a crt shader is made for the console's own resolution
    if res == "recommended":
        want = min(-(-h // NATIVE[system]), CAPS[tier][system])  # enough to fill the screen
    else:
        want = int(res)
    return max([x for x in SCALES[system] if x <= max(want, 1)] or [1])


def core_dir(core_name):
    """the folder retroarch keeps a core's own settings in: its name (Beetle PSX HW...)."""
    import glob
    if core_name in CORE_DIRS:
        return CORE_DIRS[core_name]
    for info in glob.glob(os.path.join(HOME, ".local/share/flatpak/app", RA, "current/active/files/share/libretro/info", f"{core_name}_libretro.info")) + \
            glob.glob(f"/var/lib/flatpak/app/{RA}/current/active/files/share/libretro/info/{core_name}_libretro.info"):
        m = re.search(r'^corename\s*=\s*"([^"]+)"', open(info, errors="replace").read(), re.M)
        if m:
            return m.group(1)
    return None


def video_config(emu, s):
    """the video settings into EMU's own settings."""
    v, m = video_settings(s), machine()
    (w, h), _, _ = m
    wide_ratio = "16:10" if abs(w / h - 1.6) < 0.05 else "16:9"
    aspect, base = v["aspect"], os.path.join(VAR, RA, "config/retroarch")
    if emu == "retroarch":
        set_cfg(os.path.join(base, "retroarch.cfg"), {"aspect_ratio_index": 24 if aspect == "stretch" else 22})
        psx = scale_for("psx", v, m)
        opts = {"Beetle PSX HW": {"beetle_psx_hw_internal_resolution": "1x(native)" if psx == 1 else f"{psx}x",
                                  "beetle_psx_hw_widescreen_hack": "enabled" if aspect == "wide" else "disabled",
                                  "beetle_psx_hw_widescreen_hack_aspect_ratio": wide_ratio},
                "Mupen64Plus-Next": {"mupen64plus-EnableNativeResFactor": str(scale_for("n64", v, m)),
                                     "mupen64plus-aspect": "16:9 adjusted" if aspect == "wide" else "4:3"}}
        for core, o in opts.items():
            set_cfg(os.path.join(base, "retroarch-core-options.cfg"), o)
            set_cfg(os.path.join(base, "config", core, f"{core}.opt"), o)
        retroarch_shaders(v, m, s, base)
    elif emu == "pcsx2":
        ini = os.path.join(VAR, "net.pcsx2.PCSX2/config/PCSX2/inis/PCSX2.ini")
        set_ini(ini, "EmuCore/GS", {"upscale_multiplier": scale_for("ps2", v, m),
                                    "AspectRatio": {"console": "Auto 4:3/3:2", "wide": "16:9", "stretch": "Stretch"}[aspect]})
        set_ini(ini, "EmuCore", {"EnableWideScreenPatches": "true" if aspect == "wide" else "false"})
    elif emu == "dolphin":
        set_ini(os.path.join(VAR, "org.DolphinEmu.dolphin-emu/config/dolphin-emu/GFX.ini"), "Settings",
                {"InternalResolution": scale_for("gc", v, m),
                 "AspectRatio": {"console": 0, "wide": 1, "stretch": 3}[aspect],  # auto, 16:9, stretch
                 "wideScreenHack": "True" if aspect == "wide" else "False"})
    elif emu == "ppsspp":
        ini = os.path.join(VAR, "org.ppsspp.PPSSPP/config/ppsspp/PSP/SYSTEM/ppsspp.ini")
        set_ini(ini, "Graphics", {"InternalResolution": scale_for("psp", v, m)})
        set_ini(ini, "DisplayLayout.Landscape", {"DisplayStretch": "True" if aspect == "stretch" else "False"})


def write_preset(path, name, preset):
    """a preset pointing at retroarch's own (yours, if one is there, kept aside). written
    only when it changes: the refresh goes over the whole library every few hours"""
    text = f'{OURS}: {name}\n#reference "{GLSL}/{preset}.glslp"\n'
    if os.path.exists(path):
        old = open(path, errors="replace").read()
        if old == text:
            return
        if OURS not in old:
            shutil.copyfile(path, path + ".before-nekozame")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def game_preset(system, rom, s=None):
    """with the real display look: this game's preset, written as it starts (a new game
    plays on its display straight away, before the daily tidy-up has seen it)."""
    s = s or settings()
    v = video_settings(s)
    if v.get("look") != "real" or system not in ERAS or emulator_of(system)[0] != "retroarch":
        return
    core = core_dir(emulator_of(system)[1])
    if not core:
        return
    base = os.path.join(VAR, RA, "config/retroarch")
    home = home_region(v)
    light = machine()[1] != "dgpu"
    mine = display_for(system, folder_region(system, v))
    d = display_for(system, game_region(os.path.basename(rom), system, v))
    roots = [os.path.join(r, system) for r in (s.get("roms") or [])]
    if d and (d != mine or os.path.dirname(rom) not in roots):
        stem = os.path.splitext(os.path.basename(rom))[0]
        write_preset(os.path.join(base, "config", core, f"{stem}.glslp"), d, DISPLAYS[d][light])
    if mine and os.path.dirname(rom) in roots:
        write_preset(os.path.join(base, "config", core, f"{system}.glslp"), mine, DISPLAYS[mine][light])


def retroarch_shaders(v, m, s, base):
    """the presets retroarch picks itself: per game (the game's file name), per folder
    (roms/megadrivejp: the folder's name), per core. "real" writes a folder's and the
    games that differ from it; "manual" one per core. the ones nekozame-emu wrote before
    and doesn't want now go (yours come back)."""
    import glob
    light = m[1] != "dgpu"
    look = v.get("look", "manual")
    want = {}  # path: (name, preset)
    cores = set()
    if look == "real":
        home = home_region(v)
        for root in (s.get("roms") or []):
            for system in SYSTEMS:
                if emulator_of(system)[0] != "retroarch" or system not in ERAS:
                    continue
                core = core_dir(emulator_of(system)[1])
                folder = os.path.join(root, system)
                if not core or not os.path.isdir(folder):
                    continue
                cores.add(core)
                mine = display_for(system, folder_region(system, v))
                if mine:
                    want[os.path.join(base, "config", core, f"{system}.glslp")] = (mine, DISPLAYS[mine][light])
                for g in games(root, system):
                    d = display_for(system, game_region(os.path.basename(g), system, v))
                    # a game unlike its folder, or in a folder of its own (a game's discs)
                    if d and (d != mine or os.path.dirname(g) != folder):
                        stem = os.path.splitext(os.path.basename(g))[0]
                        want[os.path.join(base, "config", core, f"{stem}.glslp")] = (d, DISPLAYS[d][light])
    elif look == "clean":
        for system in SYSTEMS:
            if emulator_of(system)[0] == "retroarch" and system in ERAS:
                core = core_dir(emulator_of(system)[1])
                era, width = ERAS[system]
                d = width if era == "lcd" else "sharp-monitor"
                if core:
                    cores.add(core)
                    want[os.path.join(base, "config", core, f"{system}.glslp")] = (d, DISPLAYS[d][light])
    elif look == "manual":
        for x, name in v["shaders"].items():
            if x in SYSTEMS and name in SHADERS and emulator_of(x)[0] == "retroarch":
                core = core_dir(emulator_of(x)[1])
                if core:
                    cores.add(core)
                    want.setdefault(os.path.join(base, "config", core, f"{core}.glslp"), (name, SHADERS[name][0]))
    for path, (name, preset) in want.items():
        write_preset(path, name, preset)
    # what nekozame-emu wrote before and doesn't want now
    for path in glob.glob(os.path.join(base, "config", "*", "*.glslp")):
        if path not in want and OURS in open(path, errors="replace").read():
            os.remove(path)
            if os.path.exists(path + ".before-nekozame"):
                os.replace(path + ".before-nekozame", path)
    # opengl and shaders on for the cores that have them (the presets are glsl)
    everything = {core_dir(emulator_of(x)[1]) for x in SYSTEMS if emulator_of(x)[0] == "retroarch"}
    for core in sorted(c for c in everything if c):
        cfg = os.path.join(base, "config", core, f"{core}.cfg")
        if core in cores:
            set_cfg(cfg, {"video_driver": "gl", "video_shader_enable": "true"})
        elif os.path.exists(cfg):
            unset_cfg(cfg, {"video_driver", "video_shader_enable"})


def video(argv):
    """nekozame-emu video: how games look on this machine. no arguments: a menu."""
    s = settings()
    v, m = video_settings(s), machine()
    (w, h), tier, what = m
    if argv[:1] == ["aspect"] and argv[1:2] and argv[1] in ("console", "wide", "stretch"):
        v["aspect"] = argv[1]
    elif argv[:1] == ["resolution"] and argv[1:2] and (argv[1] in ("native", "recommended") or argv[1].isdigit()):
        v["resolution"] = argv[1] if not argv[1].isdigit() else int(argv[1])
    elif argv[:1] == ["refresh"]:
        # the presets again, for the library as it is now (games added, renamed, gone):
        # the timer runs it after login and every few hours
        if installed(EMULATORS["retroarch"]["flatpak"]) and s.get("roms"):
            video_config("retroarch", s)
        return 0
    elif argv[:1] == ["look"] and argv[1:2] and argv[1] in ("real", "clean", "manual", "none"):
        v["look"] = argv[1]
    elif argv[:1] == ["region"] and argv[1:2] and argv[1] in LOOK_REGIONS:
        v["region"] = argv[1]
    elif argv[:1] == ["imports"] and argv[1:2] and argv[1] in ("own", "home"):
        v["imports"] = argv[1]
    elif argv[:1] == ["shader"] and argv[1:2] == ["suggested"]:
        v["look"] = "manual"
        v["shaders"] = {x: name for x, name in SUGGESTED.items() if x in SYSTEMS}
    elif argv[:1] == ["shader"] and argv[1:2] and (argv[1] in SHADERS or argv[1] == "off"):
        systems = [x for x in argv[2:] if x in SYSTEMS]
        v["look"] = "manual"
        if argv[1] == "off" and not argv[2:]:
            v["shaders"] = {}  # off everywhere
        for x in systems:
            if argv[1] == "off":
                v["shaders"].pop(x, None)
            else:
                v["shaders"][x] = argv[1]
    elif argv[:1] == ["shaders"]:
        for name, (_, what, _) in SHADERS.items():
            say(f"  {name:16} {what}")
        return 0
    elif argv[:1] in ([], ["menu"]) and shutil.which("gum") and sys.stdin.isatty():
        v = video_menu(v, m)
    elif argv[:1] != ["show"]:
        say(video.__doc__ + "\n  nekozame-emu video look real|clean|manual|none\n"
            "  nekozame-emu video region eu|us|jp       yours, for games that came out everywhere\n"
            "  nekozame-emu video imports own|home      other regions' games on their display, or yours\n"
            "  nekozame-emu video refresh               the shaders again for new, renamed or removed games\n"
            "  nekozame-emu video aspect console|wide|stretch\n"
            "  nekozame-emu video resolution recommended|native|NUMBER\n"
            "  nekozame-emu video shader NAME SYSTEM...   (off SYSTEM..., or off for none)\n"
            "  nekozame-emu video shader suggested        the community's usual one for each system\n"
            "  nekozame-emu video shaders                 the shaders there are\n  nekozame-emu video show")
        return 1
    if argv[:1] != ["show"]:
        save_setting("video", v)
        s = settings()
        for emu in ("retroarch", "pcsx2", "dolphin", "ppsspp"):
            if installed(EMULATORS[emu]["flatpak"]):
                video_config(emu, s)
    say(f"this machine: {w}x{h}, {what}")
    say(f"  aspect ratio: {v['aspect']}")
    say("  resolution: " + ", ".join(f"{SYSTEMS[x][0]} {scale_for(x, v, m)}x" for x in ("psx", "n64", "ps2", "gc", "psp")))
    look = v.get("look", "manual")
    if look == "real":
        imports = ", imports on yours" if v.get("imports") == "home" else ""
        say(f"  shaders: real display look per region and platform ({LOOK_REGIONS[home_region(v)]}{imports})")
    elif look == "clean":
        say("  shaders: sharp pixels, no CRT shader")
    elif look == "manual":
        by = {}
        for x, name in v["shaders"].items():
            if x in SYSTEMS:
                by.setdefault(name, []).append(SYSTEMS[x][0])
        say("  shaders: " + ("; ".join(f"{name} ({', '.join(sorted(set(xs)))})" for name, xs in by.items()) or "none"))
    else:
        say("  shaders: none")
    return 0


def gum(*args):
    r = subprocess.run(["gum", *args], stdout=subprocess.PIPE, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def show_picture(path, cols=60):
    """a picture in the terminal (kitty graphics, through tmux too: kitty-logo); where the
    terminal can't, where it is instead."""
    if not os.path.exists(path):
        return
    if shutil.which("kitty-logo") and subprocess.run(["kitty-logo", "--probe"], capture_output=True).returncode == 0:
        r = subprocess.run(["kitty-logo", path, str(cols)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        rows = r.stdout.split()[0] if r.returncode == 0 and r.stdout.split() else None
        if rows and os.path.exists(rows):
            sys.stdout.write(open(rows).read() + "\n")
            sys.stdout.flush()
            return
    say(f"  Picture of each look: {path}")


def video_menu(v, m):
    (w, h), tier, what = m
    rec = ", ".join(f"{SYSTEMS[x][0]} {scale_for(x, {**v, 'resolution': 'recommended', 'shader': 'off'}, m)}x"
                    for x in ("psx", "n64", "ps2", "gc", "psp"))
    say(f"  This computer: {w}x{h}, {what}")
    SHAPE = {"console": "The console's own shape (recommended)", "wide": "Widescreen, where the game allows it",
             "stretch": "Stretched to fill the screen"}
    show_picture(os.path.join(USR, "share/nekozame-os/emulation/shapes.png"))
    pick = gum("choose", "--header", "What shape should the picture be?",
               "--selected", SHAPE.get(v["aspect"], SHAPE["console"]), *SHAPE.values())
    v["aspect"] = next((k for k, n in SHAPE.items() if n == pick), v["aspect"])
    SHARP = {"recommended": f"As sharp as this computer handles (recommended): {rec}",
             "native": "Like the original console", "number": "Choose it yourself"}
    pick = gum("choose", "--header", "How sharp should 3D games be? (PlayStation, N64, PS2, GameCube, PSP)",
               "--selected", SHARP.get(str(v["resolution"]), SHARP["recommended"]), *SHARP.values())
    if pick == SHARP["number"]:
        n = gum("input", "--placeholder", "2", "--header", "How many times the original (2 is twice as sharp):")
        v["resolution"] = int(n) if n and n.isdigit() else v["resolution"]
    elif pick:
        v["resolution"] = next(k for k, n in SHARP.items() if n == pick)
    # the look: an old TV, sharp pixels, per system, or none
    REAL = "Real display look: the display each game was most likely played on, per region and platform (recommended)"
    CLEAN = "Sharp pixels, no CRT shader"
    MANUAL = "Choose a shader for each system"
    NONE = "No shader"
    sel = {"real": REAL, "clean": CLEAN, "manual": MANUAL}.get(v.get("look"), REAL)
    show_picture(os.path.join(USR, "share/nekozame-os/emulation/looks.png"))
    pick = gum("choose", "--header", "Shaders: how should old games look?", "--selected", sel, REAL, CLEAN, MANUAL, NONE)
    if pick == REAL:
        v["look"] = "real"
        home = home_region(v)
        r = gum("choose", "--header", "Where did you grow up playing? Games sold everywhere look like they did there.",
                "--selected", LOOK_REGIONS[home], *LOOK_REGIONS.values())
        v["region"] = next((k for k, n in LOOK_REGIONS.items() if n == r), home)
        OWN = "On their own region's display (recommended)"
        HOME = "On my region's display, like an import"
        r = gum("choose", "--header", "Games from other regions:",
                "--selected", HOME if v.get("imports") == "home" else OWN, OWN, HOME)
        v["imports"] = "home" if r == HOME else "own"
        say("  Each game now gets the display it was most likely played on, per region and platform.")
        return v
    if pick in (CLEAN, NONE):
        v["look"] = "clean" if pick == CLEAN else "none"
        return v
    if pick != MANUAL:
        return v
    v["look"] = "manual"
    # shaders, one at a time: pick one, then the systems that get it
    names = {SYSTEMS[x][0]: x for x in SYSTEMS if emulator_of(x)[0] == "retroarch"}
    while True:
        pick = gum("choose", "--header", "Shaders, for the systems RetroArch plays (done when you're finished)",
                   "done", "suggested: the community's usual one for each system (CRTs, handheld screens)",
                   "off: none, for the systems you pick next",
                   *[f"{n}: {what}" for n, (_, what, _) in SHADERS.items()])
        if not pick or pick == "done":
            break
        name = pick.split(":")[0]
        if name == "suggested":
            v["shaders"] = {x: n for x, n in SUGGESTED.items() if x in SYSTEMS}
            continue
        chosen = [SYSTEMS[x][0] for x, n in v["shaders"].items() if n == name and x in SYSTEMS]
        pick = gum("choose", "--no-limit", "--header", f"The systems with {name} (tab to pick, enter when done)",
                   "--selected", ",".join(chosen), *sorted(names))
        if pick is None:
            continue
        picked = {names[n] for n in pick.splitlines() if n in names}
        for x in [x for x, n in v["shaders"].items() if n == name and x not in picked]:
            del v["shaders"][x]  # unpicked: this shader off for them
        for x in picked:
            if name == "off":
                v["shaders"].pop(x, None)
            else:
                v["shaders"][x] = name
    return v


# --- retroachievements -------------------------------------------------------------
# you log in once per machine; only the login token is kept (never the password), in a
# file only you can read, and given to every emulator that has achievements.
# "achievements" in emulation.json: {"enabled": true, "hardcore": false}
RA_LOGIN = os.path.join(HOME, ".config/nekozame/retroachievements.json")


def cheevos_login():
    try:
        return json.load(open(RA_LOGIN))
    except (OSError, ValueError):
        return None


def cheevos_config(emu, s):
    """the retroachievements login and mode into EMU's own settings. without a login made
    here, each emulator's own (if you logged in inside it) is left as it is."""
    login = cheevos_login()
    if not login:
        return
    a = {"enabled": True, "hardcore": False, **s.get("achievements", {})}
    on, hard = a["enabled"], a["enabled"] and a["hardcore"]
    user, token = login["username"], login["token"]
    if emu == "retroarch":
        set_cfg(os.path.join(VAR, RA, "config/retroarch/retroarch.cfg"),
                {"cheevos_enable": "true" if on else "false", "cheevos_username": user, "cheevos_token": token,
                 "cheevos_password": "", "cheevos_hardcore_mode_enable": "true" if hard else "false"})
    elif emu == "pcsx2":
        set_ini(os.path.join(VAR, "net.pcsx2.PCSX2/config/PCSX2/inis/PCSX2.ini"), "Achievements",
                {"Enabled": "true" if on else "false", "ChallengeMode": "true" if hard else "false",
                 "Username": user, "Token": token})  # pcsx2 moves the token to its secrets file
    elif emu == "dolphin":
        set_ini(os.path.join(VAR, "org.DolphinEmu.dolphin-emu/config/dolphin-emu/RetroAchievements.ini"), "Achievements",
                {"Enabled": "True" if on else "False", "HardcoreEnabled": "True" if hard else "False",
                 "Username": user, "ApiToken": token})
    elif emu == "ppsspp":
        set_ini(os.path.join(VAR, "org.ppsspp.PPSSPP/config/ppsspp/PSP/SYSTEM/ppsspp.ini"), "Achievements",
                {"AchievementsEnable": "True" if on else "False", "AchievementsChallengeMode": "True" if hard else "False",
                 "AchievementsUserName": user, "AchievementsToken": token})


def achievements(argv):
    """nekozame-emu achievements: retroachievements on this machine's emulators.

  nekozame-emu achievements login       your retroachievements.org account
  nekozame-emu achievements hardcore on|off   hardcore: no save states, rewind or cheats
  nekozame-emu achievements on|off      achievements in the emulators, or not
  nekozame-emu achievements logout      the login taken off this machine"""
    s = settings()
    a = {"enabled": True, "hardcore": False, **s.get("achievements", {})}
    if argv[:1] == ["login"]:
        user = argv[1] if argv[1:2] else (gum("input", "--placeholder", "username", "--header", "RetroAchievements username")
                                          if shutil.which("gum") else input("RetroAchievements username: "))
        if not user:
            return 1
        import getpass
        pw = (gum("input", "--password", "--header", f"Password for {user} (only used to log in, not kept)")
              if shutil.which("gum") and sys.stdin.isatty() else getpass.getpass("Password (not kept): "))
        if not pw:
            return 1
        req = urllib.request.Request("https://retroachievements.org/dorequest.php",
                                     data=urllib.parse.urlencode({"r": "login2", "u": user, "p": pw}).encode(),
                                     headers={"User-Agent": "nekozame-emu/1.0"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                answer = json.load(r)
        except urllib.error.HTTPError as err:  # a wrong login comes back as 401, with the reason
            try:
                answer = json.loads(err.read() or b"{}")
            except ValueError:
                answer = {"Error": str(err)}
        except (OSError, ValueError) as err:
            say(f"couldn't reach retroachievements.org: {err}")
            return 1
        if not answer.get("Success") or not answer.get("Token"):
            say(f"retroachievements said no: {answer.get('Error', 'wrong username or password')}")
            return 1
        os.makedirs(os.path.dirname(RA_LOGIN), exist_ok=True)
        fd = os.open(RA_LOGIN + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"username": answer.get("User", user), "token": answer["Token"]}, f)
        os.replace(RA_LOGIN + ".new", RA_LOGIN)
        say(f"logged in as {answer.get('User', user)}")
    elif argv[:1] == ["logout"]:
        if os.path.exists(RA_LOGIN):
            save_setting("achievements", {**a, "enabled": False})
            for emu in ("retroarch", "pcsx2", "dolphin", "ppsspp"):
                if installed(EMULATORS[emu]["flatpak"]):
                    cheevos_config(emu, settings())
            os.remove(RA_LOGIN)
            save_setting("achievements", a)
        say("logged out on this machine: achievements off in its emulators")
    elif argv[:1] == ["hardcore"] and argv[1:2] in (["on"], ["off"]):
        a["hardcore"] = argv[1] == "on"
        save_setting("achievements", a)
    elif argv[:1] in (["on"], ["off"]):
        a["enabled"] = argv[0] == "on"
        save_setting("achievements", a)
    elif argv:
        say(achievements.__doc__)
        return 1
    s = settings()
    for emu in ("retroarch", "pcsx2", "dolphin", "ppsspp"):
        if installed(EMULATORS[emu]["flatpak"]):
            cheevos_config(emu, s)
    login = cheevos_login()
    a = {"enabled": True, "hardcore": False, **s.get("achievements", {})}
    say(f"retroachievements: {'logged in as ' + login['username'] if login else 'not logged in'}, "
        f"{'on' if a['enabled'] else 'off'}, {'hardcore' if a['hardcore'] else 'normal'} mode")
    return 0


def setup(everything=False):
    s = settings()
    for d in ("roms", "bios", "saves"):
        os.makedirs(os.path.join(HOME, "Emulation", d), exist_ok=True)
    have = {}
    for system in SYSTEMS:
        os.makedirs(os.path.join(HOME, "Emulation/roms", system), exist_ok=True)
        n = sum(len(games(r, system)) for r in s["roms"])
        if n or everything:
            have[system] = n
    emus = sorted({emulator_of(x)[0] for x in have})
    for emu in emus:
        app = EMULATORS[emu]["flatpak"]
        if not installed(app):
            say(f"installing {app}")
            subprocess.run(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", app])
        configure(emu, s)
        say(f"  ✓ {emu}")
    for system in have:
        emu, core_name = emulator_of(system)
        if core_name:
            try:
                core(core_name)
            except OSError as e:
                say(f"  ! {SYSTEMS[system][0]}: couldn't get the {core_name} core ({e})")
    say(f"ready: {', '.join(SYSTEMS[x][0] for x in have) or 'no games found yet'}")


# --- steam -------------------------------------------------------------------------

def steam_js():
    import importlib.machinery
    import importlib.util
    path = f"{USR}/libexec/nekozame-steam-theme"
    spec = importlib.util.spec_from_loader("steam_theme", importlib.machinery.SourceFileLoader("steam_theme", path))
    theme = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(theme)

    class Patient:  # steam answers slowly with a big library: wait up to a minute
        def __getattr__(self, name):
            return getattr(socket, name)

        def create_connection(self, address, timeout=None):
            return socket.create_connection(address, timeout=60)
    theme.socket = Patient()
    with urllib.request.urlopen(f"http://127.0.0.1:{theme.PORT}/json", timeout=3) as r:
        ws = next(t["webSocketDebuggerUrl"] for t in json.load(r) if t.get("title") == "SharedJSContext")
    return lambda js, wait=False: theme.evaluate(ws, js, answer=True, wait=wait)


def grids():
    import glob
    return glob.glob(os.path.join(HOME, ".local/share/Steam/userdata/[1-9]*/config/grid"))


def art(system, rom, s):
    """es-de's scraped art for a game: cover, banner, logo, wide."""
    base = os.path.splitext(os.path.basename(rom))[0]
    found = {}
    for media in s["media"]:
        for kind, folders in (("p", ["covers", "3dboxes"]), ("_hero", ["fanart", "screenshots", "titlescreens"]),
                              ("_logo", ["marquees"]), ("", ["screenshots", "titlescreens", "fanart"])):
            if kind in found:
                continue
            for folder in folders:
                for ext in ("png", "jpg"):
                    p = os.path.join(media, system, folder, f"{base}.{ext}")
                    if os.path.exists(p):
                        found[kind] = p
                        break
                if kind in found:
                    break
    return found


# --- 3d boxes ------------------------------------------------------------------------
# a game's 3d box made from its cover, for games with a cover and no scraped box: the
# cover on the front, a spine in the colours of the cover's edge with the game's logo down
# it (its marquee, when there is one), seen from the left so the spine shows, lit, with a
# soft shadow. what the case is follows the system (how deep, how
# glossy, a keep case's plastic rim); its shape follows the cover, so a super famicom's
# box stays wide and a snes's tall.
BOXES = os.path.join(HOME, ".local/state/nekozame/boxes.json")  # the boxes nekozame made
COVERS_SEEN = os.path.join(HOME, ".local/state/nekozame/covers-seen.json")  # each covers folder's time, last look
BOX_CASES = {"cardboard": dict(depth=0.22, gloss=0.0), "clamshell": dict(depth=0.14, gloss=0.35),
             "jewel": dict(depth=0.09, gloss=0.55), "keep": dict(depth=0.11, gloss=0.4)}
BOX_CASE = {
    **{s: "clamshell" for s in ("megadrive", "megadrivejp", "genesis", "mastersystem", "gamegear", "sega32x",
                                "sega32xjp", "sega32xna", "pcengine", "tg16", "ngp", "ngpc", "neogeo")},
    **{s: "jewel" for s in ("psx", "saturn", "saturnjp", "segacd", "megacd", "megacdjp", "pcenginecd", "tg-cd",
                            "neogeocd", "dreamcast", "3do", "pcfx")},
    **{s: "keep" for s in ("ps2", "ps3", "ps4", "gc", "wii", "wiiu", "xbox", "switch", "psp", "nds", "n3ds")},
}  # everything else: cardboard
BOX_RIM = {"ps2": (20, 20, 24), "gc": (20, 20, 24), "psp": (20, 20, 24), "wii": (238, 238, 240),
           "wiiu": (40, 120, 200), "ps3": (30, 40, 60), "ps4": (24, 70, 160), "switch": (210, 30, 40),
           "xbox": (40, 110, 50), "nds": (240, 240, 242), "n3ds": (240, 240, 242)}


def box_face(pg, dest, src, x0, x1, top0, bot0, top1, bot1, shade):
    """src stretched onto a quadrilateral with upright left and right edges, column by
    column (the perspective of a box turned about its upright axis)"""
    w, sw = x1 - x0, src.get_width()
    for i in range(w):
        t = i / max(1, w - 1)
        top, bot = top0 + (top1 - top0) * t, bot0 + (bot1 - bot0) * t
        h = int(round(bot - top))
        if h <= 0:
            continue
        col = pg.transform.smoothscale(src.subsurface((min(sw - 1, int(t * (sw - 1))), 0, 1, src.get_height())), (1, h))
        v = int(255 * max(0.0, min(1.0, shade(t))))
        if v < 255:
            col.fill((v, v, v), special_flags=pg.BLEND_MULT)
        dest.blit(col, (x0 + i, int(round(top))))


def box_render(pg, cover_path, system, out_path, height=900, logo_path=None):
    kind = BOX_CASE.get(system, "cardboard")
    case = BOX_CASES[kind]
    cover = pg.image.load(cover_path).convert_alpha()
    if system in BOX_RIM:  # a keep case: the cover under clear plastic, in a rim of the case's colour
        b = max(4, cover.get_width() // 40)
        framed = pg.Surface((cover.get_width() + 2 * b, cover.get_height() + 2 * b), pg.SRCALPHA)
        framed.fill((*BOX_RIM[system], 255))
        framed.blit(cover, (b, b))
        cover = framed
    cw, ch = cover.get_size()
    fw = int(height * cw / ch)
    # turned enough that the spine reads, even a jewel case's thin one
    spine_w = max(8, int(fw * max(0.13, case["depth"]) * 0.9))
    front_w = int(fw * 0.8)  # the front, foreshortened
    persp, margin = 0.06, int(height * 0.08)  # how much the far edges shrink; room for the shadow
    W, H = spine_w + front_w + 2 * margin, height + 2 * margin
    out = pg.Surface((W, H), pg.SRCALPHA)
    shadow = pg.Surface((W, H), pg.SRCALPHA)  # on the floor, soft
    for r in range(12, 0, -1):
        pg.draw.ellipse(shadow, (0, 0, 0, 10 + (12 - r) * 4),
                        (margin - r * 4, margin + height * 0.98 - r, spine_w + front_w + r * 8, r * 5))
    out.blit(shadow, (0, 0))
    xj, top_j, bot_j = margin + spine_w, margin, margin + height  # the nearest edge: full height
    # the spine: the colours of the cover's left edge, row by row (a real spine has its own
    # art: its colours read true, its words wouldn't), darker, its far edge shrunk
    edge = cover.subsurface((0, 0, max(2, cw // 30), ch)).copy()
    sw_ = max(24, int(ch * spine_w / height))  # the spine at the cover's scale
    strip = pg.transform.smoothscale(pg.transform.smoothscale(edge, (1, max(8, ch // 6))), (sw_, ch))
    if logo_path:  # the game's logo, read from top to bottom like a spine's title
        try:
            logo = pg.transform.rotate(pg.image.load(logo_path).convert_alpha(), -90)
            logo = logo.subsurface(logo.get_bounding_rect(min_alpha=8)).copy()
            lw, lh = logo.get_size()
            k = min(sw_ * 0.8 / lw, ch * 0.62 / lh)
            logo = pg.transform.smoothscale(logo, (max(1, int(lw * k)), max(1, int(lh * k))))
            strip.blit(logo, ((sw_ - logo.get_width()) // 2, int(ch * 0.2)))
        except (pg.error, OSError, ValueError):
            pass
    sh = height * persp * 0.6
    box_face(pg, out, strip, margin, xj, top_j + sh / 2, bot_j - sh / 2, top_j, bot_j, lambda t: 0.8 + 0.12 * t)
    sh = height * persp  # the front: the cover, its far edge shrunk, lit from the left
    box_face(pg, out, cover, xj, xj + front_w, top_j, bot_j, top_j + sh / 2, bot_j - sh / 2, lambda t: 1.0 - 0.1 * t)
    if kind == "jewel":  # a dark clear rim round the insert, and the hinge down its left side
        rimw, hinge = max(3, front_w // 70), int(front_w * 0.075)
        for i in range(front_w):
            top, bot = top_j + sh / 2 * i / front_w, bot_j - sh / 2 * i / front_w
            if i < hinge:
                pg.draw.line(out, (12, 12, 16, 55 if i % max(3, hinge // 6) else 110), (xj + i, top), (xj + i, bot))
            elif i > front_w - rimw:
                pg.draw.line(out, (12, 12, 16, 170), (xj + i, top), (xj + i, bot))
            pg.draw.line(out, (12, 12, 16, 170), (xj + i, top), (xj + i, top + rimw))
            pg.draw.line(out, (12, 12, 16, 170), (xj + i, bot - rimw), (xj + i, bot))
    if case["gloss"]:  # plastic catches the light: a soft sheen across the front
        sheen = pg.Surface((W, H), pg.SRCALPHA)
        for i in range(front_w):
            a = int(case["gloss"] * 90 * max(0.0, 1 - abs(i / front_w - 0.28) / 0.22) ** 2)
            if a:
                pg.draw.line(sheen, (255, 255, 255, a), (xj + i, top_j), (xj + i, bot_j))
        out.blit(sheen, (0, 0))
    pg.draw.line(out, (255, 255, 255, 70), (xj, top_j + 1), (xj, bot_j - 1), 2)  # the near edge, lit
    pg.image.save(out.subsurface(out.get_bounding_rect(min_alpha=4)).copy(), out_path)


def make_boxes(systems=None, again=False):
    """3d boxes for the games with a cover and no box (again: the ones nekozame made, redone)"""
    pg = pygame_ready()
    if not pg:
        say("3d boxes need pygame")
        return 1
    s = settings()
    try:
        made = set(json.load(open(BOXES)))
    except (OSError, ValueError):
        made = set()
    count = 0
    for root in s["roms"]:
        for system in SYSTEMS:
            if systems and system not in systems:
                continue
            for rom in games(root, system):
                base = os.path.splitext(os.path.basename(rom))[0]
                cover = next((p for m in s["media"] for ext in ("png", "jpg")
                              for p in [os.path.join(m, system, "covers", f"{base}.{ext}")] if os.path.exists(p)), None)
                if not cover:
                    continue
                out = os.path.join(s["media"][0], system, "3dboxes", f"{base}.png")
                have = any(os.path.exists(os.path.join(m, system, "3dboxes", f"{base}.{ext}"))
                           for m in s["media"] for ext in ("png", "jpg"))
                if have and not (again and out in made):
                    continue  # a scraped box (or one made before): kept
                logo = next((p for m in s["media"] for ext in ("png", "jpg")
                             for p in [os.path.join(m, system, "marquees", f"{base}.{ext}")] if os.path.exists(p)), None)
                os.makedirs(os.path.dirname(out), exist_ok=True)
                try:
                    box_render(pg, cover, system, out + ".part.png", logo_path=logo)
                    os.replace(out + ".part.png", out)
                except (pg.error, OSError, ValueError) as err:
                    say(f"  {system}/{base}: {err}")
                    continue
                made.add(out)
                count += 1
                if count % 100 == 0:
                    say(f"  {count} boxes")
                    os.makedirs(os.path.dirname(BOXES), exist_ok=True)
                    json.dump(sorted(made), open(BOXES, "w"))
    os.makedirs(os.path.dirname(BOXES), exist_ok=True)
    json.dump(sorted(made), open(BOXES, "w"))
    say(f"{count} 3d boxes made (the layouts' 3d box pictures show them)")


def new_boxes():
    """3d boxes for covers that came since the last look (from scraping in the frontend,
    say): only the systems whose covers folder changed are gone through. only with
    "autoBoxes": true in emulation.json; the frontend's scraper brings screenscraper's own
    3d boxes, which look better (nekozame-emu boxes makes them by hand)."""
    s = settings()
    if not s.get("autoBoxes", False):
        return
    # a share that isn't there yet (just after boot, away from home): left alone this
    # round. looking into each system's folder would ask for it to be mounted again and
    # again, until systemd gives up on it
    media = [m for m in s["media"] if os.path.isdir(m)]
    if not media:
        return
    try:
        seen = json.load(open(COVERS_SEEN))
    except (OSError, ValueError):
        seen = {}
    changed = []
    for system in SYSTEMS:
        times = []
        for m in media:
            try:
                times.append(os.stat(os.path.join(m, system, "covers")).st_mtime)
            except OSError:
                pass
        if times and max(times) != seen.get(system):
            changed.append(system)
            seen[system] = max(times)
    if changed:
        make_boxes(changed)
        os.makedirs(os.path.dirname(COVERS_SEEN), exist_ok=True)
        json.dump(seen, open(COVERS_SEEN, "w"))


_pygame = None


def pygame_ready():
    """pygame for drawing covers (the deck has it), or None."""
    global _pygame
    if _pygame is None:
        try:
            os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
            os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
            import pygame
            pygame.display.init()
            pygame.display.set_mode((1, 1))
            pygame.font.init()
            _pygame = pygame
        except Exception:
            _pygame = False
    return _pygame or None


def font(pg, px, bold):
    f = subprocess.run(["fc-match", "-f", "%{file}", "Noto Sans:bold" if bold else "Noto Sans"],
                       capture_output=True, text=True).stdout or None
    return pg.font.Font(f, px)


def wrap(f, text, width, most):
    lines, line = [], ""
    for word in text.split():
        trial = f"{line} {word}".strip()
        if f.size(trial)[0] <= width or not line:
            line = trial
        else:
            lines.append(line)
            line = word
    if line:
        lines.append(line)
    if len(lines) > most:
        lines = lines[:most]
        while f.size(lines[-1] + "…")[0] > width and " " in lines[-1]:
            lines[-1] = lines[-1].rsplit(" ", 1)[0]
        lines[-1] += "…"
    return lines


def labeled_cover(src, name, dest):
    """the cover, fitted to steam's shape, with a band under it: the game's name and,
    in pink, what tells its versions apart (the regions and revisions in brackets)."""
    pg = pygame_ready()
    W, H = 600, 900
    DEEP, PINK, WHITE = (67, 58, 85), (255, 192, 229), (255, 255, 255)
    cover = pg.image.load(src)
    title = re.sub(r"\s*[\(\[].*$", "", name).strip() or name
    details = name[len(title):].strip()
    big, small = font(pg, 36, True), font(pg, 27, False)
    t_lines = wrap(big, title, W - 48, 2)
    d_lines = wrap(small, details, W - 48, 3) if details else []
    band = 28 + len(t_lines) * big.get_linesize() + (8 + len(d_lines) * small.get_linesize() if d_lines else 0) + 24
    canvas = pg.Surface((W, H))
    # behind it: the cover itself, filling and blurred, darkened
    cw, ch = cover.get_size()
    k = max(W / cw, H / ch)
    fill = pg.transform.smoothscale(cover, (max(1, int(cw * k)), max(1, int(ch * k))))
    blur = pg.transform.smoothscale(pg.transform.smoothscale(fill, (24, 36)), (W, H))
    canvas.blit(blur, (0, 0))
    veil = pg.Surface((W, H), pg.SRCALPHA)
    veil.fill((*DEEP, 150))
    canvas.blit(veil, (0, 0))
    # the cover, whole, above the band
    area = H - band
    k = min(W / cw, area / ch)
    fitted = pg.transform.smoothscale(cover, (max(1, int(cw * k)), max(1, int(ch * k))))
    canvas.blit(fitted, ((W - fitted.get_width()) // 2, (area - fitted.get_height()) // 2))
    # the band
    strip = pg.Surface((W, band), pg.SRCALPHA)
    strip.fill((*DEEP, 240))
    canvas.blit(strip, (0, H - band))
    pg.draw.rect(canvas, PINK, (0, H - band, W, 4))
    y = H - band + 24
    for line in t_lines:
        img = big.render(line, True, WHITE)
        canvas.blit(img, ((W - img.get_width()) // 2, y))
        y += big.get_linesize()
    y += 8
    for line in d_lines:
        img = small.render(line, True, PINK)
        canvas.blit(img, ((W - img.get_width()) // 2, y))
        y += small.get_linesize()
    pg.image.save(canvas, dest)


def put_art(appid, system, rom, name, s):
    found = art(system, rom, s)
    for grid in grids():
        for f in os.listdir(grid):  # what was there before (another type, an old cover)
            if re.match(rf"{appid}(p|_hero|_logo|)\.(png|jpg)$", f):
                os.remove(os.path.join(grid, f))
        for kind, path in found.items():
            dest = os.path.join(grid, f"{appid}{kind}.{path.rsplit('.', 1)[-1]}")
            if kind == "p" and s["steam"].get("labels", True) and pygame_ready():
                try:
                    labeled_cover(path, name, os.path.join(grid, f"{appid}p.png"))
                    continue
                except Exception as e:  # a broken picture: the plain one
                    say(f"  ! {name}: {e}")
            shutil.copyfile(path, dest)


def collect(js, added, quiet=False):
    """a collection per system (Saturn, PlayStation 2...) with its games, and one with
    all of them."""
    by_system = {EVERYTHING: [a["appid"] for a in added.values()]} if added else {}
    for a in added.values():
        by_system.setdefault(SYSTEMS[a["system"]][0], []).append(a["appid"])
    for name, ids in sorted(by_system.items()):
        n = js("""(async () => {
            const name = %s;
            let c = collectionStore.userCollections.find(c => c.displayName === name);
            if (!c) { c = collectionStore.NewUnsavedCollection(name, undefined, []); await c.Save();
                      c = collectionStore.userCollections.find(c => c.displayName === name) || c; }
            const apps = %s.map(id => appStore.GetAppOverviewByAppID(id)).filter(Boolean);
            c.AsDragDropCollection().AddApps(apps);
            await c.Save();
            return c.allApps.length;
        })()""" % (json.dumps(name), json.dumps(ids)), wait=True)
        if not quiet:
            say(f"  {name}: {n} games")


def emulator_apps(js):
    """the emulators steam has as apps (by their flatpak) into their own collection"""
    ids = [e["flatpak"] for e in EMULATORS.values() if e.get("flatpak")] + OTHER_EMULATORS
    found = [sc["appid"] for sc in steam_shortcuts()
             if any(i in sc.get("exe", "") + " " + sc.get("launchoptions", "") for i in ids)]
    js("""(async () => {
        const name = %s;
        let c = collectionStore.userCollections.find(c => c.displayName === name);
        if (!c) { c = collectionStore.NewUnsavedCollection(name, undefined, []); await c.Save();
                  c = collectionStore.userCollections.find(c => c.displayName === name) || c; }
        c.AsDragDropCollection().AddApps(%s.map(id => appStore.GetAppOverviewByAppID(id)).filter(Boolean));
        await c.Save();
    })()""" % (json.dumps(EMULATORS_COLLECTION), json.dumps(found)), wait=True)
    return len(found)


def port_apps(js):
    """the ports steam has (nekozame-ports installed them) into their own collection"""
    try:
        installed = json.load(open(PORT_STATE)).get("installed", {}).values()
    except (OSError, ValueError):
        return 0
    marks = [i["app"] for i in installed if i.get("app")] + ["/nekozame/ports/"]
    found = [sc["appid"] for sc in steam_shortcuts()
             if any(m in sc.get("exe", "") + " " + sc.get("launchoptions", "") for m in marks)]
    if not found:
        return 0
    js("""(async () => {
        const name = %s;
        let c = collectionStore.userCollections.find(c => c.displayName === name);
        if (!c) { c = collectionStore.NewUnsavedCollection(name, undefined, []); await c.Save();
                  c = collectionStore.userCollections.find(c => c.displayName === name) || c; }
        c.AsDragDropCollection().AddApps(%s.map(id => appStore.GetAppOverviewByAppID(id)).filter(Boolean));
        await c.Save();
    })()""" % (json.dumps(PORTS_COLLECTION), json.dumps(found)), wait=True)
    return len(found)


def steam_watch():
    """steam keeps big collections only while it runs (its cloud won't store thousands of
    games in one), so each time steam starts, once your library is in: the emulation
    collections again (a couple of seconds). also makes 3d boxes for new covers, every
    10 minutes. runs as nekozame-emu-collections.service."""
    import threading
    import time
    boxes, last = None, time.time()  # the first look 10 minutes after starting, once the network is up
    while True:
        if (boxes is None or not boxes.is_alive()) and time.time() - last > 600:
            # every 10 minutes, apart from steam: boxes for new covers
            boxes, last = threading.Thread(target=new_boxes, daemon=True), time.time()
            boxes.start()
        try:
            added = load_state()
            if added:
                js = steam_js()
                ready = js("(window.__nekozameCollected ? 'done' : '') + "
                           # collectionsFromStorage first: asking for userCollections before steam
                           # has loaded them breaks the library page until steam restarts
                           "(window.collectionStore && collectionStore.collectionsFromStorage && "
                           "collectionStore.userCollections.length && appStore.GetAppOverviewByAppID(%d) ? 'in' : '')"
                           % next(iter(added.values()))["appid"])
                if ready == "in":
                    tidy(js, added)  # stray copies of games, out
                    repair(js, added)  # names or launch options that didn't stick
                    collect(js, added, quiet=True)
                    emulator_apps(js)
                    port_apps(js)
                    js("window.__nekozameCollected = true")
                    say(f"emulation collections back in steam ({len(added)} games)")
        except (OSError, ValueError, StopIteration, KeyError):
            pass  # steam isn't up (yet)
        time.sleep(10)


def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {}


def steam_add(systems=None):
    s = settings()
    js = steam_js()
    added = load_state()
    exe = shutil.which("nekozame-emu") or os.path.realpath(__file__)
    count, fresh = 0, {}
    for root in s["steam"]["roms"]:
        for system in SYSTEMS:
            if systems and system not in systems:
                continue
            for rom in games(root, system):
                if rom in added:
                    continue
                name = name_of(rom, system, s)
                options = shlex.join(["launch", system, rom])
                appid = js("SteamClient.Apps.AddShortcut(%s, %s, %s, %s)" % (
                    json.dumps(name), json.dumps(exe), json.dumps(os.path.dirname(exe)), json.dumps(options)), wait=True)
                if not appid:
                    say(f"  ! {name}: steam didn't add it")
                    continue
                js("SteamClient.Apps.SetShortcutName(%d, %s)" % (appid, json.dumps(name)))
                js("SteamClient.Apps.SetShortcutLaunchOptions(%d, %s)" % (appid, json.dumps(options)))
                put_art(appid, system, rom, name, s)
                added[rom] = fresh[rom] = {"appid": appid, "system": system}
                count += 1
                if count % 20 == 0:
                    say(f"  {count} added")
                    save_state(added)
                if len(fresh) >= 200:  # into their collections as they come (not in Apps)
                    collect(js, fresh, quiet=True)
                    fresh = {}
    save_state(added)
    tidy(js, added)
    collect(js, added)
    say(f"{count} games added to steam ({len(added)} in all). restart steam to see all their art.")


def steam_shortcuts():
    """(appid, exe, launch options) of every shortcut in steam (its shortcuts.vdf)."""
    import glob
    out = []
    for path in glob.glob(os.path.join(HOME, ".local/share/Steam/userdata/[1-9]*/config/shortcuts.vdf")):
        data = open(path, "rb").read()
        i, cur = 0, {}

        def cstr(i):
            j = data.index(b"\0", i)
            return data[i:j].decode(errors="replace"), j + 1
        try:
            while i < len(data):
                t = data[i]
                i += 1
                if t == 8:
                    continue
                k, i = cstr(i)
                k = k.lower()
                if t == 0:
                    if k.isdigit():
                        if cur.get("appid"):
                            out.append(cur)
                        cur = {}
                elif t == 1:
                    v, i = cstr(i)
                    cur[k] = v
                elif t == 2:
                    cur[k] = struct.unpack("<I", data[i:i + 4])[0]
                    i += 4
        except (ValueError, struct.error):
            pass
        if cur.get("appid"):
            out.append(cur)
    return out


def repair(js, added):
    """games whose name or launch options didn't stick when they were added (steam
    names a new entry after its program, nekozame-emu, until it's renamed): set again."""
    s = settings()
    by_id = {a["appid"]: (rom, a["system"]) for rom, a in added.items()}
    unnamed = js("JSON.stringify(%s.filter(id => appStore.GetAppOverviewByAppID(id)?.display_name === 'nekozame-emu'))"
                 % json.dumps(sorted(by_id)))
    unnamed = set(json.loads(unnamed or "[]"))
    no_options = {sc["appid"] for sc in steam_shortcuts() if sc["appid"] in by_id and not sc.get("launchoptions")}
    for appid in sorted(unnamed | no_options):
        rom, system = by_id[appid]
        if appid in unnamed:
            js("SteamClient.Apps.SetShortcutName(%d, %s)" % (appid, json.dumps(name_of(rom, system, s))))
        if appid in no_options:
            js("SteamClient.Apps.SetShortcutLaunchOptions(%d, %s)" % (appid, json.dumps(shlex.join(["launch", system, rom]))))
    if unnamed or no_options:
        say(f"  {len(unnamed)} names and {len(no_options)} launch options set again")


def tidy(js, added):
    """nekozame game entries steam has but nekozame has no record of (a second copy
    of a game, when steam was too slow to answer): taken out."""
    known = {a["appid"] for a in added.values()}
    extra = [sc["appid"] for sc in steam_shortcuts()
             if sc.get("exe", "").strip('"').endswith("nekozame-emu") and sc["appid"] not in known
             and (sc.get("launchoptions", "").startswith("launch ") or not sc.get("launchoptions"))]
    for appid in extra:
        js("SteamClient.Apps.RemoveShortcut(%d)" % appid)
    if extra:
        say(f"  {len(extra)} doubled entries taken out")


def steam_refresh():
    """the art and collections again, for the games already in steam."""
    s = settings()
    js = steam_js()
    added = load_state()
    for i, (rom, a) in enumerate(added.items(), 1):
        put_art(a["appid"], a["system"], rom, name_of(rom, a["system"], s), s)
        if i % 50 == 0:
            say(f"  {i} done")
    collect(js, added)
    say(f"{len(added)} games refreshed. restart steam to see the new art.")


def save_state(added):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".new", "w") as f:
        json.dump(added, f, indent=1)
    os.replace(STATE + ".new", STATE)


def steam_remove():
    js = steam_js()
    added = load_state()
    for rom, a in added.items():
        js("SteamClient.Apps.RemoveShortcut(%d)" % a["appid"])
        for grid in grids():
            for f in os.listdir(grid):
                if f.startswith(str(a["appid"])):
                    os.remove(os.path.join(grid, f))
    tabs(js, remove=True)
    # the collections nekozame made, once they're empty
    for name in sorted({SYSTEMS[a["system"]][0] for a in added.values()} | {EVERYTHING}):
        js("""(async () => {
            const c = collectionStore.userCollections.find(c => c.displayName === %s);
            if (c && c.allApps.length === 0) await c.Delete();
        })()""" % json.dumps(name), wait=True)
    save_state({})
    say(f"{len(added)} games taken out of steam, with their collections (your games and saves are untouched)")


def tabs(js=None, remove=False):
    """tabmaster's tabs (when it's installed): "Apps", your non-steam apps without the
    emulated games and the emulators; "Emulation", the games and the emulators; steam's
    own non-steam tab hidden. other
    tabs you made stay. remove takes ours out and brings steam's back."""
    if not os.path.isdir(os.path.dirname(TABMASTER)):
        if not remove:
            say("  no tabmaster (it comes with nekozame's decky plugins: ujust nekozame-decky)")
        return
    js = js or steam_js()
    user = js("BigInt.asUintN(32, BigInt(App.m_CurrentUser.strSteamID)).toString()")
    coll = js("collectionStore.userCollections.find(c => c.displayName === %s)?.id" % json.dumps(EVERYTHING))
    if coll and not remove:
        emulator_apps(js)
        port_apps(js)
    emus = js("collectionStore.userCollections.find(c => c.displayName === %s)?.id" % json.dumps(EMULATORS_COLLECTION))
    ports = js("collectionStore.userCollections.find(c => c.displayName === %s)?.id" % json.dumps(PORTS_COLLECTION))
    try:
        cfg = json.load(open(TABMASTER))
    except (OSError, ValueError):
        cfg = {}
    users = cfg.setdefault("usersDict", {})
    me = users.setdefault(user, {"tabs": {}, "friends": [], "friendsGames": {}})
    t = me.get("tabs") or {}
    if not t:  # tabmaster starts from steam's tabs
        for i, (tid, title) in enumerate([("GreatOnDeck", "Great On Deck"), ("AllGames", "All Games"),
                                          ("Installed", "Installed"), ("Favorites", "Favorites"),
                                          ("Collections", "Collections"), ("DesktopApps", "Non-steam"),
                                          ("Soundtracks", "Soundtracks")]):
            t[tid] = {"id": tid, "title": title, "position": i}
    for tid in ("nekozame-apps", "nekozame-emulation", "nekozame-ports"):
        t.pop(tid, None)
    if "DesktopApps" in t:
        t["DesktopApps"]["position"] = -1 if not remove else max(p["position"] for p in t.values()) + 1
    if not remove:
        if not coll:
            say("  no emulation collection yet (nekozame-emu steam add makes it)")
            return
        last = max([p["position"] for p in t.values()] + [0])
        every = 1 | 2 | 8192  # games, software, music
        t["nekozame-apps"] = {"id": "nekozame-apps", "title": "Apps", "position": last + 1,
                              "filters": [{"type": "platform", "inverted": False, "params": {"platform": "nonSteam"}},
                                          {"type": "collection", "inverted": True, "params": {"id": coll, "name": EVERYTHING}}]
                              + ([{"type": "collection", "inverted": True, "params": {"id": emus, "name": EMULATORS_COLLECTION}}]
                                 if emus else [])
                              + ([{"type": "collection", "inverted": True, "params": {"id": ports, "name": PORTS_COLLECTION}}]
                                 if ports else []),
                              "filtersMode": "and", "categoriesToInclude": every, "autoHide": False}
        t["nekozame-emulation"] = {"id": "nekozame-emulation", "title": "Emulation", "position": last + 2,
                                   "filters": [{"type": "collection", "inverted": False, "params": {"id": coll, "name": EVERYTHING}}]
                                   + ([{"type": "collection", "inverted": False, "params": {"id": emus, "name": EMULATORS_COLLECTION}}]
                                      if emus else []),
                                   "filtersMode": "or", "categoriesToInclude": every, "autoHide": False}
        if ports:
            t["nekozame-ports"] = {"id": "nekozame-ports", "title": "Ports", "position": last + 3,
                                   "filters": [{"type": "collection", "inverted": False,
                                                "params": {"id": ports, "name": PORTS_COLLECTION}}],
                                   "filtersMode": "and", "categoriesToInclude": every, "autoHide": False}
    # positions in order again, the hidden ones staying hidden
    shown = sorted((p for p in t.values() if p["position"] >= 0), key=lambda p: p["position"])
    for i, p in enumerate(shown):
        p["position"] = i
    me["tabs"] = t
    os.makedirs(os.path.dirname(TABMASTER), exist_ok=True)
    with open(TABMASTER + ".new", "w") as f:
        json.dump(cfg, f, indent=4)
    os.replace(TABMASTER + ".new", TABMASTER)
    say("  tabmaster's tabs " + ("taken out" if remove else "are set: Apps, Emulation" + (" and Ports" if ports else ""))
        + " (they show once decky restarts: reboot, or sudo systemctl restart plugin_loader)")


def fetch_art(systems=None):
    """covers, title screens and screenshots from libretro's thumbnail library for the
    games that have none, matched by file name (your versions included; a hack or a
    translation falls back to its original's), saved where es-de keeps its art."""
    from concurrent.futures import ThreadPoolExecutor
    s = settings()
    media = next((m for m in s["media"] if os.path.isdir(os.path.dirname(m.rstrip("/"))) and os.access(os.path.dirname(m.rstrip("/")), os.W_OK)), None)
    if not media:
        say("  no folder for art (settings: media)")
        return 1
    try:
        misses = set(json.load(open(MISSES)))
    except (OSError, ValueError):
        misses = set()
    todo = []
    for root in s["roms"]:
        for system in SYSTEMS:
            if (systems and system not in systems) or system not in LIBRETRO:
                continue
            for rom in games(root, system):
                base = os.path.splitext(os.path.basename(rom))[0]
                if f"{system}/{base}" in misses or art(system, rom, s).get("p"):
                    continue
                todo.append((system, base))
    say(f"  {len(todo)} games without art; asking libretro's thumbnail library")
    kinds = [("Named_Boxarts", "covers"), ("Named_Titles", "titlescreens"), ("Named_Snaps", "screenshots")]

    def candidates(base):
        """the name as it is, then without its trailing tags one by one (keeping the
        title and first region)."""
        names, name = [base], base
        while True:
            shorter = re.sub(r"\s*[\(\[][^\(\)\[\]]*[\)\]]\s*$", "", name)
            if shorter == name or not re.search(r"\(", shorter):
                break
            names.append(shorter)
            name = shorter
        return names

    def one(job):
        system, base = job
        got = False
        for remote, folder in kinds:
            dest = os.path.join(media, system, folder, base + ".png")
            if os.path.exists(dest):
                got = True
                continue
            for name in candidates(base):
                safe = re.sub(r'[&*/:`<>?\\|"]', "_", name)
                url = f"{THUMBNAILS}/{urllib.parse.quote(LIBRETRO[system])}/{remote}/{urllib.parse.quote(safe)}.png"
                try:
                    with urllib.request.urlopen(url, timeout=30) as r:
                        data = r.read()
                except (OSError, ValueError):
                    continue
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest + ".part", "wb") as f:
                    f.write(data)
                os.replace(dest + ".part", dest)
                got = True
                break
        return job, got

    found, got_systems = 0, set()
    with ThreadPoolExecutor(6) as pool:
        for i, ((system, base), got) in enumerate(pool.map(one, todo), 1):
            if got:
                found += 1
                got_systems.add(system)
            else:
                misses.add(f"{system}/{base}")
            if i % 200 == 0:
                say(f"  {i}/{len(todo)}, art for {found}")
                os.makedirs(os.path.dirname(MISSES), exist_ok=True)
                json.dump(sorted(misses), open(MISSES, "w"))
    os.makedirs(os.path.dirname(MISSES), exist_ok=True)
    json.dump(sorted(misses), open(MISSES, "w"))
    say(f"  art for {found} of {len(todo)} (nekozame-emu steam refresh puts it in steam)")
    if got_systems and settings().get("autoBoxes", False):
        make_boxes(sorted(got_systems))  # 3d boxes from the new covers, if you want them made


# --- es-de ---------------------------------------------------------------------------

ESDE = os.path.join(HOME, ".local/share/nekozame/es-de")
ESDE_HOME = os.path.join(HOME, "ES-DE")
ESDE_NAME = "nekozame-emu-frontend"
ESDE_STATE = os.path.join(HOME, ".local/state/nekozame/es-de.json")
# nekozame-emu-frontend: nekozame's build of es-de (its menu colours, its theme)
ESDE_RELEASES = "https://api.github.com/repos/purplekairi1312/nekozame-emu-frontend/releases/latest"


def esde_settings(values):
    """es-de's settings file: these values set, everything else as it was."""
    path = os.path.join(ESDE_HOME, "settings/es_settings.xml")
    from xml.sax.saxutils import quoteattr
    lines = open(path, errors="replace").read().splitlines() if os.path.exists(path) else ['<?xml version="1.0"?>']
    out = []
    for line in lines:
        m = re.match(r'\s*<(\w+) name="([^"]+)" value=', line)
        if m and m.group(2) in values:
            continue
        out.append(line)
    for k, (kind, v) in values.items():
        out.append(f"<{kind} name={quoteattr(k)} value={quoteattr(str(v))} />")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(path + ".new", path)


# one console in its regions, kept together in the frontend's list: maker, the year the
# family began, the family, then its regions in the order they came out
REGIONS = {"JP": ("Japan", "日本"), "US": ("North America", "北米"), "EU": ("Europe", "欧州"), "World": ("World", "世界")}
FAMILIES = {  # maker, the family's first year, the family, region, when that region got it
    "famicom": ("Nintendo", 1983, "Famicom", "JP", "1983-07-15"), "nes": ("Nintendo", 1983, "Famicom", "US", "1985-10-18"),
    "sfc": ("Nintendo", 1990, "Super Famicom", "JP", "1990-11-21"),
    "snesna": ("Nintendo", 1990, "Super Famicom", "US", "1991-08-23"),
    "snes": ("Nintendo", 1990, "Super Famicom", "World", "1991-08-23"),
    "megadrivejp": ("Sega", 1988, "Mega Drive", "JP", "1988-10-29"),
    "genesis": ("Sega", 1988, "Mega Drive", "US", "1989-08-14"),
    "megadrive": ("Sega", 1988, "Mega Drive", "EU", "1990-11-30"),
    "megacdjp": ("Sega", 1991, "Mega-CD", "JP", "1991-12-12"), "segacd": ("Sega", 1991, "Mega-CD", "US", "1992-10-15"),
    "megacd": ("Sega", 1991, "Mega-CD", "EU", "1993-04-02"),
    "sega32xna": ("Sega", 1994, "32X", "US", "1994-11-21"), "sega32xjp": ("Sega", 1994, "32X", "JP", "1994-12-03"),
    "sega32x": ("Sega", 1994, "32X", "EU", "1994-12-04"),
    "saturnjp": ("Sega", 1994, "Saturn", "JP", "1994-11-22"), "saturn": ("Sega", 1994, "Saturn", "World", "1995-05-11"),
    "pcengine": ("NEC", 1987, "PC Engine", "JP", "1987-10-30"), "tg16": ("NEC", 1987, "PC Engine", "US", "1989-08-29"),
    "pcenginecd": ("NEC", 1988, "PC Engine CD", "JP", "1988-12-04"), "tg-cd": ("NEC", 1988, "PC Engine CD", "US", "1989-11-01"),
}


def esde_sorting(appimage):
    """the frontend's systems in order: by maker and year (es-de's own list), a console's
    regions together (FAMILIES); es-de reads it with its systems sorting on its default"""
    import tempfile
    from xml.sax.saxutils import escape
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run([appimage, "--appimage-extract",
                        "usr/share/es-de/resources/sorting/manufacturer_year/es_systems_sorting.xml"],
                       cwd=tmp, capture_output=True)
        found = [os.path.join(d, f) for d, _, fs in os.walk(tmp) for f in fs if f == "es_systems_sorting.xml"]
        if not found:
            return False
        xml = open(found[0], errors="replace").read()
    rank = {r: i for i, r in enumerate(LOOK_REGIONS, 1)}
    began = {}  # each family from its first region's release
    for maker, _, family, _, released in FAMILIES.values():
        began[family] = min(began.get(family, released), released)
    entries = []
    for name, sortname in re.findall(r"<name>(.*?)</name>\s*<systemsortname>(.*?)</systemsortname>", xml):
        if name in FAMILIES:
            maker, _, family, region, released = FAMILIES[name]
            key = f"{maker} - {began[family]} - {family} - {released} - {rank[region]}"
        else:
            key = f"{sortname} - {name}"
        entries.append(f"    <system>\n        <name>{escape(name)}</name>\n"
                       f"        <systemsortname>{escape(key)}</systemsortname>\n    </system>")
    with open(os.path.join(ESDE_HOME, "custom_systems", "es_systems_sorting.xml"), "w") as f:
        f.write('<?xml version="1.0"?>\n<!-- nekozame: by maker and year, a console\'s regions together '
                '(nekozame-emu esde) -->\n<systemList>\n' + "\n".join(entries) + "\n</systemList>\n")
    return True


def esde_systems(appimage):
    """es-de's own system list, with nekozame's launcher as each system's first
    emulator (so saves sync); es-de's other emulators stay choosable."""
    import tempfile
    from xml.sax.saxutils import escape
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run([appimage, "--appimage-extract", "usr/share/es-de/resources/systems/linux/es_systems.xml"],
                       cwd=tmp, capture_output=True)
        found = [os.path.join(d, f) for d, _, fs in os.walk(tmp) for f in fs if f == "es_systems.xml"]
        if not found:
            raise OSError("es-de's system list isn't in the appimage")
        xml = open(found[0], errors="replace").read()
    exe = shutil.which("nekozame-emu") or os.path.realpath(__file__)

    def ours(m):
        block = m.group(0)
        name = re.search(r"<name>(.*?)</name>", block).group(1)
        if name == "ports":  # the ports this machine has (nekozame-ports), not a folder of the share's
            return re.sub(r"<path>.*?</path>", f"<path>{escape(PORT_LAUNCHERS)}</path>", block)
        if name not in SYSTEMS:
            return block
        cmd = f'<command label="nekozame">{escape(exe)} launch {name} %ROM%</command>'
        return re.sub(r"(\s*)(<command)", lambda c: f"{c.group(1)}{cmd}{c.group(1)}{c.group(2)}", block, count=1)
    custom = re.sub(r"<system>.*?</system>", ours, xml, flags=re.S)
    folder = os.path.join(ESDE_HOME, "custom_systems")
    os.makedirs(folder, exist_ok=True)
    for f in ("es_systems.xml", "es_find_rules.xml"):  # what was there (emudeck's): kept aside
        old = os.path.join(folder, f)
        if os.path.exists(old) and "nekozame" not in open(old, errors="replace").read():
            os.replace(old, old + ".before-nekozame")
    with open(os.path.join(folder, "es_systems.xml"), "w") as f:
        f.write(custom.replace("<!-- This is the ES-DE Frontend game systems configuration file for Linux -->",
                               "<!-- nekozame: es-de's systems, with nekozame's launcher first (nekozame-emu esde) -->"))


# --- where the game lists live (what's scraped, favourites, play counts) ----------
# "gamelists" in emulation.json:
#   "library": with your games, next to their art (media): on a share or a disk every
#              machine reaches, what one scrapes, all see. ~/ES-DE/gamelists points there
#   "local":   on this machine only
#   "both":    this machine's own copy, synced with the library's when the frontend opens
#              and closes (the newest wins; the one it replaces is kept as .bak): it
#              still works when the library isn't there (away, the disk unplugged)
# the default: "library", wherever the library is (a share, a disk, or ~/Emulation)


def gamelists_mode(s):
    mode = s.get("gamelists")
    return mode if mode in ("library", "local", "both") else "library"


def gamelists_shared(s):
    return os.path.join(os.path.dirname(s["media"][0].rstrip("/")), "gamelists")


def gamelists_sync(here, there):
    """each system's list, both ways: the newer one wins, the one it replaces kept as .bak."""
    import filecmp
    names = set()
    for root in (here, there):
        if os.path.isdir(root):
            names |= {d for d in os.listdir(root) if os.path.isfile(os.path.join(root, d, "gamelist.xml"))}
    for name in sorted(names):
        a, b = os.path.join(here, name, "gamelist.xml"), os.path.join(there, name, "gamelist.xml")
        if os.path.exists(a) and os.path.exists(b) and filecmp.cmp(a, b, shallow=False):
            continue
        newer, older = (a, b) if not os.path.exists(b) or (os.path.exists(a) and os.path.getmtime(a) > os.path.getmtime(b)) else (b, a)
        os.makedirs(os.path.dirname(older), exist_ok=True)
        if os.path.exists(older):
            shutil.copy2(older, older + ".bak")
        shutil.copy2(newer, older + ".part")
        os.replace(older + ".part", older)


def esde_gamelists(s):
    """the game lists where the setting says: moved, linked or synced; nothing is lost
    (a list that's replaced is kept as .bak, and this machine's are kept aside when they
    move to the library)."""
    mode, local, shared = gamelists_mode(s), os.path.join(ESDE_HOME, "gamelists"), gamelists_shared(s)
    if mode != "local" and not os.path.isdir(os.path.dirname(shared)):
        say(f"  game lists: {os.path.dirname(shared)} isn't there right now: left as they are")
        return mode
    if mode == "library":
        os.makedirs(shared, exist_ok=True)
        if os.path.islink(local) and os.path.realpath(local) == os.path.realpath(shared):
            return mode
        if os.path.isdir(local) and not os.path.islink(local):
            gamelists_sync(local, shared)  # this machine's lists join the library's
            os.replace(local, aside(local, ".here-before-library"))
        elif os.path.islink(local):
            os.remove(local)
        os.symlink(shared, local)
        say(f"  game lists: with the library, {shared}")
    else:
        if os.path.islink(local):  # was with the library: a copy here now
            os.remove(local)
            if os.path.isdir(shared):
                shutil.copytree(shared, local)
        os.makedirs(local, exist_ok=True)
        if mode == "both":
            gamelists_sync(local, shared)
            say(f"  game lists: here and with the library ({shared}), synced as the frontend opens and closes")
        else:
            say("  game lists: on this machine")
    return mode


def aside(path, suffix):
    """a free name next to PATH for keeping it aside: PATH.SUFFIX-DATE, numbered if taken"""
    import time
    base = path + suffix + time.strftime("-%Y%m%d-%H%M%S")
    n, out = 1, base
    while os.path.lexists(out):
        n += 1
        out = f"{base}-{n}"
    return out


GAME_INFO = ("name", "desc", "rating", "releasedate", "developer", "publisher", "genre", "players",
             "lastplayed", "playcount", "favorite", "hidden", "kidgame")


def gamelists_import(folder, s):
    """game lists from FOLDER (es-de's layout, SYSTEM/gamelist.xml, or the old one inside
    the rom folders, roms/SYSTEM/gamelist.xml) merged into yours, game by game: games
    yours don't have are added, the ones it has only get what's missing filled in. each
    list that changes is kept as .bak first."""
    from xml.etree import ElementTree as ET
    folder = os.path.expanduser(folder)
    mine = os.path.join(ESDE_HOME, "gamelists")
    found = {}
    for base in (folder, os.path.join(folder, "gamelists"), os.path.join(folder, "roms")):
        if os.path.isdir(base):
            for system in os.listdir(base):
                f = os.path.join(base, system, "gamelist.xml")
                if os.path.isfile(f) and system in SYSTEMS:
                    found.setdefault(system, f)
    if not found:
        say(f"no game lists in {folder} (SYSTEM/gamelist.xml, or roms/SYSTEM/gamelist.xml)")
        return 1
    added = filled = 0
    for system, src in sorted(found.items()):
        try:
            theirs = ET.parse(src).getroot()
        except ET.ParseError as err:
            say(f"  {system}: couldn't read it ({err})")
            continue
        dest = os.path.join(mine, system, "gamelist.xml")
        try:
            tree = ET.parse(dest)
        except (OSError, ET.ParseError):
            tree = ET.ElementTree(ET.Element("gameList"))
        root = tree.getroot()
        have = {g.findtext("path"): g for g in root.findall("game")}
        changed = 0
        for g in theirs.findall("game"):
            path = g.findtext("path")
            if not path:
                continue
            if path not in have:
                root.append(g)
                added += 1
                changed += 1
                continue
            for field in GAME_INFO:  # only what's missing; yours stays
                value = g.findtext(field)
                if value and not (have[path].findtext(field) or "").strip():
                    e = have[path].find(field)
                    if e is None:
                        e = ET.SubElement(have[path], field)
                    e.text = value
                    filled += 1
                    changed += 1
        if changed:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            if os.path.exists(dest):
                shutil.copy2(dest, dest + ".bak")
            ET.indent(tree, "\t")
            tree.write(dest + ".part", encoding="utf-8", xml_declaration=True)
            os.replace(dest + ".part", dest)
            say(f"  {SYSTEMS[system][0]}: {changed} changes")
    say(f"imported from {folder}: {added} games added, {filled} details filled in")
    return 0


def esde_run(args):
    """the frontend, with the game lists synced before it opens and after it closes when
    they're kept in both places (gamelists: both)."""
    s = settings()
    appimage = os.path.join(ESDE, "ES-DE.AppImage")
    local, shared = os.path.join(ESDE_HOME, "gamelists"), gamelists_shared(s)
    both = gamelists_mode(s) == "both" and os.path.isdir(os.path.dirname(shared))
    if both:
        gamelists_sync(local, shared)
    code = subprocess.call([appimage, *args])
    if both and os.path.isdir(os.path.dirname(shared)):
        gamelists_sync(local, shared)
    return code


def esde_names():
    """your file names as the games' names: the names scraped in before are cleared
    (the game lists are kept aside first, once)."""
    lists = os.path.join(ESDE_HOME, "gamelists")
    if not os.path.isdir(lists):
        return 0
    backup = lists + ".before-nekozame"
    if not os.path.exists(backup):
        shutil.copytree(lists, backup)
    cleared = 0
    for d, _, files in os.walk(lists):
        for f in files:
            if f != "gamelist.xml":
                continue
            path = os.path.join(d, f)
            xml, n = re.subn(r"\s*<name>.*?</name>", "", open(path, errors="replace").read(), flags=re.S)
            cleared += n
            open(path, "w").write(xml)
    return cleared


# nekozame's theme, its page printer (nekozame-theme) and its music are the frontend's own
# (they're in its repo and its appimage): taken out of the appimage, again with each new one
THEME_TOOLS = os.path.join(ESDE, "nekozame")
FRONTEND_REPO = "https://github.com/purplekairi1312/nekozame-emu-frontend"


def theme_tools(appimage, fresh=False):
    """the frontend's nekozame folder, here: from its appimage, or (a release from before
    it carried it) from its repo. its path, or None."""
    import tempfile
    printer = os.path.join(THEME_TOOLS, "nekozame-theme")
    if os.path.exists(printer) and not fresh:
        return THEME_TOOLS
    with tempfile.TemporaryDirectory() as tmp:
        found = None
        if os.path.exists(appimage):
            subprocess.run([appimage, "--appimage-extract", "usr/share/es-de/nekozame/*"], cwd=tmp, capture_output=True)
            if os.path.exists(os.path.join(tmp, "squashfs-root/usr/share/es-de/nekozame/nekozame-theme")):
                found = os.path.join(tmp, "squashfs-root/usr/share/es-de/nekozame")
        if not found:
            try:
                import tarfile
                with urllib.request.urlopen(f"{FRONTEND_REPO}/archive/refs/heads/main.tar.gz", timeout=120) as r, \
                        tarfile.open(fileobj=r, mode="r|gz") as tar:
                    for m in tar:
                        if "/nekozame/" in m.name and ".." not in m.name:
                            tar.extract(m, tmp, filter="data")
                found = next((os.path.join(tmp, d, "nekozame") for d in os.listdir(tmp)
                              if os.path.exists(os.path.join(tmp, d, "nekozame/nekozame-theme"))), None)
            except (OSError, tarfile.TarError) as err:
                say(f"  couldn't get nekozame's theme ({err})")
        if not found:
            return THEME_TOOLS if os.path.exists(printer) else None
        shutil.rmtree(THEME_TOOLS, ignore_errors=True)
        shutil.copytree(found, THEME_TOOLS)
    return THEME_TOOLS


def esde_theme(s, appimage, again=False, fresh=False):
    """nekozame's theme in es-de: the frontend's printer, on your games (its pages need
    pygame; without it the theme still goes in, without pages)."""
    tools = theme_tools(appimage, fresh)
    if not tools:
        return False
    cmd = [sys.executable, os.path.join(tools, "nekozame-theme"), "install", "--es-de", ESDE_HOME,
           "--roms", *s["roms"], "--media", *s["media"], "--drawings", s.get("drawings", "sharks"),
           "--ports", PORT_LAUNCHERS] + (["--again"] if again else [])
    return subprocess.run(cmd).returncode == 0


def esde_music(on=True):
    """the music's event scripts in es-de (the frontend's nekozame-theme music on|off)."""
    printer = os.path.join(THEME_TOOLS, "nekozame-theme")
    if os.path.exists(printer):
        subprocess.run([sys.executable, printer, "music", "on" if on else "off", "--es-de", ESDE_HOME])


def esde(off=False):
    try:
        st = json.load(open(ESDE_STATE))
    except (OSError, ValueError):
        st = {}
    appimage = os.path.join(ESDE, "ES-DE.AppImage")
    desktop = os.path.join(HOME, ".local/share/applications/org.es_de.frontend.desktop")
    if off:
        try:
            if st.get("appid"):
                steam_js()("SteamClient.Apps.RemoveShortcut(%d)" % st["appid"])
        except (OSError, StopIteration):
            say("  (steam isn't running: take ES-DE out of it by hand)")
        esde_music(on=False)  # (and the music stopped)
        shutil.rmtree(ESDE, ignore_errors=True)
        for f in (desktop, ESDE_STATE, os.path.join(ESDE_HOME, "custom_systems/es_systems.xml")):
            if os.path.exists(f):
                os.remove(f)
        say("ES-DE is gone (your game lists, art and saves stay)")
        return 0
    s = settings()
    # nekozame-emu-frontend itself: the newest release (its steam deck build on a deck);
    # when github can't be asked (offline, or its hourly limit), the one installed stays
    try:
        with urllib.request.urlopen(ESDE_RELEASES, timeout=30) as r:
            release = json.load(r)
    except (OSError, ValueError) as err:
        if not os.path.exists(appimage):
            raise
        say(f"  couldn't look for a newer {ESDE_NAME} ({err}): keeping {st.get('version', 'the one installed')}")
        release = {"tag_name": st.get("version", ""), "assets": []}
    deck = open("/sys/devices/virtual/dmi/id/sys_vendor").read().strip() == "Valve" \
        if os.path.exists("/sys/devices/virtual/dmi/id/sys_vendor") else False
    want = f"nekozame-emu-frontend_x64{'_SteamDeck' if deck else ''}.AppImage"
    link = next((a["browser_download_url"] for a in release["assets"] if a["name"] == want), None)
    fresh = False
    if link and (st.get("version") != release["tag_name"] or not os.path.exists(appimage)):
        say(f"getting nekozame-emu-frontend {release['tag_name']}")
        os.makedirs(ESDE, exist_ok=True)
        urllib.request.urlretrieve(link, appimage + ".part")
        os.chmod(appimage + ".part", 0o755)
        os.replace(appimage + ".part", appimage)
        st["version"] = release["tag_name"]
        fresh = True  # its icon and steam art made again from the new release
    esde_systems(appimage)
    esde_sorting(appimage)
    values = {"ROMDirectory": ("string", s["roms"][0]), "MediaDirectory": ("string", s["media"][0]),
              "ApplicationUpdaterFrequency": ("string", "never"),
              # the slideshow: the video screensaver hunts game after game for a video,
              # and most have none (over a network share, it hangs)
              "ScreensaverType": ("string", "slideshow"),
              "SystemsSorting": ("string", "default")}  # the order esde_sorting wrote
    if s["steam"].get("names") == "file":
        values["ScrapeGameNames"] = ("bool", "false")
        say(f"  {esde_names()} scraped names cleared: es-de shows your file names")
    if esde_theme(s, appimage, again="--again" in sys.argv, fresh=fresh):
        values["Theme"] = ("string", "nekozame")
    # the music (es-de has none of its own yet): its event scripts, on
    esde_music(on=s.get("music", True))
    values["CustomEventScripts"] = ("bool", "true")
    esde_settings(values)
    mode = esde_gamelists(s)
    # started through nekozame-emu when the game lists are kept in both places (it syncs them)
    exe = shutil.which("nekozame-emu") or os.path.realpath(__file__)
    run, run_args = (exe, "esde run") if mode == "both" else (appimage, "")
    # in the menu, and in steam with nekozame's art
    icon = os.path.join(ESDE, "es-de.svg")
    if fresh and os.path.exists(icon):
        os.remove(icon)
    if not os.path.exists(icon):
        import tempfile
        with tempfile.TemporaryDirectory() as tmp:
            subprocess.run([appimage, "--appimage-extract", "usr/share/icons/*"], cwd=tmp, capture_output=True)
            found = [os.path.join(d, f) for d, _, fs in os.walk(tmp) for f in fs
                     if f.endswith(".svg") and "es_de" in f and os.path.isfile(os.path.join(d, f))]
            if found:
                shutil.copyfile(found[0], icon)
    os.makedirs(os.path.dirname(desktop), exist_ok=True)
    with open(desktop, "w") as f:
        f.write(f"[Desktop Entry]\nType=Application\nName={ESDE_NAME}\nComment=Your whole game library\n"
                f"Exec={run}{' ' + run_args if run_args else ''}\nIcon={icon}\nCategories=Game;Emulator;\nTerminal=false\n")
    try:
        js = steam_js()
        if not st.get("appid") or not js("appStore.GetAppOverviewByAppID(%d)?.appid" % st["appid"]):
            st["appid"] = js("SteamClient.Apps.AddShortcut(%s, %s, %s, %s)" % (
                json.dumps(ESDE_NAME), json.dumps(run), json.dumps(ESDE), json.dumps(run_args)), wait=True)
            import time
            time.sleep(10)  # steam writes the shortcut down; then its art
        elif fresh:  # nekozame's art from the last release's icon: made again
            for grid in grids():
                for suffix in ("p.png", "_hero.png", "_logo.png", ".png", "_icon.png"):
                    old = os.path.join(grid, f"{st['appid']}{suffix}")
                    if os.path.exists(old):
                        os.remove(old)
        js("SteamClient.Apps.SetShortcutName(%d, %s)" % (st["appid"], json.dumps(ESDE_NAME)))
        js("SteamClient.Apps.SetShortcutExe(%d, %s)" % (st["appid"], json.dumps(run)))
        js("SteamClient.Apps.SetShortcutLaunchOptions(%d, %s)" % (st["appid"], json.dumps(run_args)))
        subprocess.run([f"{USR}/libexec/nekozame-steam-art", desktop], capture_output=True)
    except (OSError, StopIteration):
        say(f"  (steam isn't running: {ESDE_NAME} goes in its library next time)")
    os.makedirs(os.path.dirname(ESDE_STATE), exist_ok=True)
    json.dump(st, open(ESDE_STATE, "w"))
    say(f"{ESDE_NAME} {st['version']} is ready: in steam, and in your apps menu")
    return 0


def systems_list():
    s = settings()
    for system, (name, emu, _) in SYSTEMS.items():
        n = sum(len(games(r, system)) for r in s["roms"])
        say(f"  {'●' if n else '○'} {system:16} {name:24} {emu.replace('core:', 'retroarch: '):28} {n or ''}")


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "launch" and len(argv) == 3:
        return launch(argv[1], argv[2])
    if cmd == "setup":
        return setup("--all" in argv)
    if cmd == "steam" and argv[1:2] == ["add"]:
        return steam_add(argv[2:] or None)
    if cmd == "steam" and argv[1:2] == ["remove"]:
        return steam_remove()
    if cmd == "steam" and argv[1:2] == ["refresh"]:
        return steam_refresh()
    if cmd == "steam" and argv[1:2] == ["watch"]:
        return steam_watch()
    if cmd == "steam" and argv[1:2] == ["tabs"]:
        return tabs()
    if cmd == "systems":
        return systems_list()
    if cmd == "art":
        return fetch_art(argv[1:] or None)
    if cmd == "video":
        return video(argv[1:])
    if cmd == "achievements":
        return achievements(argv[1:])
    if cmd == "boxes":
        return make_boxes([a for a in argv[1:] if not a.startswith("--")] or None, again="--again" in argv)
    if cmd == "esde" and argv[1:2] in ([], ["on"]):
        return esde()
    if cmd == "esde" and argv[1:2] == ["run"]:
        return esde_run(argv[2:])
    if cmd == "esde" and argv[1:2] == ["gamelists"] and argv[2:3] == ["import"]:
        if not argv[3:]:
            say("nekozame-emu esde gamelists import FOLDER")
            return 1
        return gamelists_import(argv[3], settings())
    if cmd == "esde" and argv[1:2] == ["gamelists"]:
        mode = argv[2] if argv[2:3] else None
        if mode is None and shutil.which("gum") and sys.stdin.isatty():
            say(f"now: {gamelists_mode(settings())}")
            pick = gum("choose", "--header", "Where should the frontend keep its game lists (what's scraped, favourites, play counts)?",
                       "library: with the games, next to their art (every machine using the library sees them)",
                       "local: on this machine only",
                       "both: on this machine and with the library, synced when the frontend opens and closes",
                       "import: add game lists from another folder (an old ES-DE or EmuDeck, a backup)")
            mode = pick.split(":")[0] if pick else None
            if mode == "import":
                folder = gum("input", "--header", "The folder with the game lists", "--placeholder", "~/ES-DE/gamelists")
                return gamelists_import(folder, settings()) if folder else 1
        if mode not in ("library", "local", "both"):
            say("nekozame-emu esde gamelists library|local|both")
            return 1
        save_setting("gamelists", mode)
        esde_gamelists(settings())
        return esde()
    if cmd == "esde" and argv[1:2] == ["off"]:
        return esde(off=True)
    say(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
