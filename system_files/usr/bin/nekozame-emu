# a few machines that were plugged in their own way
BY_SYSTEM = {
    ("megadrivejp", "jp"): "jp-rgb", ("megadrive", "jp"): "jp-rgb", ("genesis", "jp"): "jp-rgb",  # sega's own 21-pin RGB cable
    ("pcengine", "jp"): "composite", ("pcenginecd", "jp"): "composite",  # RF, or the AV booster's composite
    ("zxspectrum", "us"): "pal", ("zxspectrum", "jp"): "pal",  # a UK machine: a PAL TV
}
# a folder's own region (the rest: yours)
FOLDER_REGION = {
    **{x: "us" for x in ("genesis", "segacd", "sega32xna", "tg16", "tg-cd", "apple2")},
    **{x: "jp" for x in ("sfc", "fds", "megadrivejp", "megacdjp", "sega32xjp", "saturnjp", "pcengine",
                         "pcenginecd", "pcfx", "pc88", "pc98")},
    **{x: "eu" for x in ("megacd", "zxspectrum", "amstradcpc", "amiga")},
}
LOOK_REGIONS = {"eu": "Europe", "us": "USA", "jp": "Japan"}
EU_TAGS = {"europe", "germany", "france", "spain", "italy", "uk", "united kingdom", "australia", "sweden",
           "netherlands", "scandinavia", "nordic", "denmark", "finland", "norway", "portugal", "greece",
           "pal", "austria", "switzerland", "belgium", "poland", "russia", "new zealand"}
US_TAGS = {"usa", "us", "canada", "brazil", "korea", "asia", "hong kong", "taiwan", "ntsc", "ntsc-u", "mexico"}
JP_TAGS = {"japan", "jp", "ntsc-j"}


def home_region(v=None):
    """yours: the setting, or a guess from the system's language (en_US, ja_JP...)."""
    if v and v.get("region") in LOOK_REGIONS:
        return v["region"]
    lang = os.environ.get("LC_ALL") or os.environ.get("LANG") or ""
    if lang.startswith("ja"):
        return "jp"
    if re.match(r"(en_US|en_CA|es_MX|es_US|pt_BR|ko|zh_TW)", lang):
        return "us"
    return "eu"


def region_of(name, system, home):
    """a game's region from its name's tags ("(USA, Europe)": yours if it's one of them),
    or its folder's, or yours."""
    found = []
    for tag in re.findall(r"\(([^)]*)\)", name):
        for part in (x.strip().lower() for x in tag.split(",")):
            r = "eu" if part in EU_TAGS else "us" if part in US_TAGS else "jp" if part in JP_TAGS else None
            if r and r not in found:
                found.append(r)
        if found:
            break  # the first tag with a region is the region
    if found:
        return home if home in found else found[0]
    return FOLDER_REGION.get(system, home)


def game_region(name, system, v):
    """the region a game is shown in: its own, or yours ("imports": "home", as an import
    played on your own display)"""
    home = home_region(v)
    return home if v.get("imports") == "home" else region_of(name, system, home)


def folder_region(system, v):
    home = home_region(v)
    return home if v.get("imports") == "home" else FOLDER_REGION.get(system, home)


def display_for(system, region):
    """the display this system's games were seen on in REGION, or None."""
    era, width = ERAS.get(system, (None, 0))
    if era is None:
        return None
    if era == "lcd":
        return width  # the handheld's own screen
    if era in ("arcade", "c64", "rgb-monitor", "sharp-monitor", "vector"):
        return era
    kind = BY_SYSTEM.get((system, region)) or BY_ERA.get(era, {}).get(region, "composite")
    return f"{kind}-{width}" if kind in ("composite", "svideo") else kind


def is_crt_look(system, v):
    """whether SYSTEM is drawn with a crt (made for the console's own resolution)."""
    look = v.get("look", "manual")
    if look == "real":
        d = display_for(system, home_region(v))
        return bool(d) and d not in ("sharp-monitor", "vector") and not d.startswith(("lcd", "gameboy"))
    if look == "manual":
        return SHADERS.get(v["shaders"].get(system), ("", "", False))[2]
    return False


# the 3d consoles' own picture height, and the scales their emulators offer
NATIVE = {"psx": 240, "n64": 240, "ps2": 448, "gc": 528, "wii": 528, "psp": 272}
SCALES = {"psx": [1, 2, 4, 8, 16], "n64": list(range(1, 9)), "ps2": list(range(1, 9)),
          "gc": list(range(1, 9)), "wii": list(range(1, 9)), "psp": list(range(1, 11))}
# how far each kind of machine goes at full speed
CAPS = {"handheld": {"psx": 2, "n64": 3, "ps2": 1, "gc": 2, "wii": 2, "psp": 3},
        "igpu": {"psx": 4, "n64": 4, "ps2": 2, "gc": 2, "wii": 2, "psp": 4},
