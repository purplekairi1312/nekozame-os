def date_en(date):
    """1994年12月3日発売（北米） → December 3, 1994 (North America)"""
    m = re.match(r"(\d{4})年(?:(\d+)月)?(?:(\d+)日)?", date)
    if not m:
        return ""
    y, mo, d = m.groups()
    out = f"{MONTHS[int(mo) - 1]} {d}, {y}" if d else f"{MONTHS[int(mo) - 1]} {y}" if mo else y
    return out + (" (North America)" if "北米" in date else "")


SCHEMES = {
    # sky top and bottom, the headline's two inks, the spine and its block, the
    # body's ink, and the gradient map the photos are printed through
    "nekozame": dict(sky=((248, 242, 232), (255, 192, 229)), ink1=(176, 46, 104), ink2=(92, 62, 116),
                     spine=(176, 46, 104), block=(40, 26, 52), body=(40, 26, 52), paper=(248, 242, 232),
                     map=[(0.0, (24, 26, 70)), (0.3, (34, 78, 150)), (0.55, (70, 150, 210)), (0.72, (150, 214, 226)),
                          (0.86, (255, 214, 232)), (1.0, (255, 250, 244))]),
    "ocean": dict(sky=((246, 249, 250), (186, 224, 246)), ink1=(26, 60, 124), ink2=(24, 112, 140),
                  spine=(26, 60, 124), block=(10, 22, 48), body=(16, 28, 52), paper=(246, 249, 250),
                  map=[(0.0, (6, 20, 52)), (0.3, (14, 66, 140)), (0.55, (40, 140, 206)), (0.72, (130, 210, 236)),
                       (0.86, (220, 244, 252)), (1.0, (255, 255, 255))]),
}


def magazine(system, s, scheme, dest, bare=False, lang="en"):
    """a 90s japanese game magazine page for a system: the picture at the bottom, fading
    into a sky; with bare, only that (the game lists' background). otherwise also the
    headline, copy written for the system, a column of your games' screens, a data
    box, the page's small print. the spine's words are es-de's (they move)."""
    import random
    pg = pygame_ready()
    if not pg or not os.path.isdir(PHOTOS):
        return False
    c = SCHEMES[scheme]
    rnd = random.Random(system)
    W, H = 1920, 1200

    def f(pattern, px):
        return pg.font.Font(subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True).stdout or None, px)

    def fill(img, w, h, fx=0.5, fy=0.5):
        iw, ih = img.get_size(); k = max(w / iw, h / ih)
        img = pg.transform.smoothscale(img, (int(iw * k) + 1, int(ih * k) + 1))
        return img.subsurface((int((img.get_width() - w) * fx), int((img.get_height() - h) * fy), w, h)).copy()

    def grade(img, keep=0.3):
        small = pg.transform.smoothscale(img, (img.get_width() // 3, img.get_height() // 3))
        px = pg.PixelArray(small)
        for y in range(small.get_height()):
            for x in range(small.get_width()):
                r, g, b, _ = small.unmap_rgb(px[x, y])
                lum = (r * 30 + g * 59 + b * 11) / 25500
                for i in range(1, len(c["map"])):
                    if lum <= c["map"][i][0]:
                        t0, c0 = c["map"][i - 1]; t1, c1 = c["map"][i]; t = (lum - t0) / (t1 - t0)
                        break
                px[x, y] = tuple(int((c0[j] + (c1[j] - c0[j]) * t) * (1 - keep) + (r, g, b)[j] * keep) for j in range(3))
        del px
        return pg.transform.smoothscale(small, img.get_size())

    page = pg.Surface((W, H))
    for y in range(H):  # the sky
        t = min(1, y / H / 0.45)
        page.fill([int(c["sky"][0][i] + (c["sky"][1][i] - c["sky"][0][i]) * t) for i in range(3)], (0, y, W, 1))
    base, feature, fx, mode, caption, caption_en = PAIRS[rnd.randrange(len(PAIRS))]
    pic = grade(fill(pg.image.load(f"{PHOTOS}/{base}.jpg").convert(), 1800, 760, 0.5, 0.45)).convert_alpha()
    fe = grade(fill(pg.image.load(f"{PHOTOS}/{feature}.jpg").convert(), 640, 640, 0.5, 0.42), keep=0.2) if feature else None
    mask = pg.Surface((640, 640), pg.SRCALPHA)  # soft all round, so no edge shows
    for r in range(320, 0, -4):
        pg.draw.circle(mask, (255, 255, 255, int(255 * min(1, (1 - r / 320) * 2.4))), (320, 320), r)
    if not feature:
        pass
    elif mode == "multiply":
        # white where the mask fades out (multiplying by white changes nothing), the
        # creature where it's solid; its bright water barely touches the scene
        lift = fe.copy(); lift.fill((95, 95, 95), special_flags=pg.BLEND_ADD)  # its water to white
        lay = pg.Surface((640, 640)); lay.fill((255, 255, 255))
        m = lift.convert_alpha(); m.blit(mask, (0, 0), special_flags=pg.BLEND_RGBA_MULT)
        lay.blit(m, (0, 0))
        pic.blit(lay, (fx, 20), special_flags=pg.BLEND_MULT)
    else:
        # only its light: the dark water taken away, the glow added, faded at the edge
        glow = fe.copy(); glow.fill((150, 150, 150), special_flags=pg.BLEND_SUB)  # only what's bright
        glow.blit(glow.copy(), (0, 0), special_flags=pg.BLEND_ADD)  # and brought back up
        g = glow.convert_alpha(); g.blit(mask, (0, 0), special_flags=pg.BLEND_RGBA_MULT)
        lay = pg.Surface((640, 640)); lay.fill((0, 0, 0)); lay.blit(g, (0, 0))
        pic.blit(lay, (fx, 40), special_flags=pg.BLEND_ADD)
    fade = pg.Surface(pic.get_size(), pg.SRCALPHA)
    for y in range(760):
        fade.fill((255, 255, 255, int(255 * min(1, y / 300) ** 1.4)), (0, y, 1800, 1))
    pic.blit(fade, (0, 0), special_flags=pg.BLEND_RGBA_MULT)
    page.blit(pic, (0, H - 760))
    dots = pg.Surface((W, H), pg.SRCALPHA)  # printed: fine halftone
    for y in range(0, H, 6):
        for x in range((y // 6 % 2) * 3, W, 6):
            dots.fill((30, 20, 44, 18), (x, y, 2, 2))
    page.blit(dots, (0, 0))
    page.fill(c["spine"], (W - 120, 0, 120, H))  # the spine (its words are es-de's)
    if not bare:
        # a shark as 川原慶賀 painted it for siebold (1820s): printed onto the sky, a
        # different one now and then; the ネコザメ most often
        drawings = [d for d in DRAWINGS if os.path.exists(f"{PHOTOS}/{d[0]}.jpg")] or DRAWINGS
        name_, ja_cap, en_cap = drawings[rnd.randrange(len(drawings))]
        try:
            art = pg.image.load(f"{PHOTOS}/{name_}.jpg").convert()
            iw, ih = art.get_size(); k = min(470 / iw, 230 / ih)
            art = pg.transform.smoothscale(art, (int(iw * k), int(ih * k)))
            art.fill((14, 14, 14), special_flags=pg.BLEND_ADD)  # its paper to white, so it vanishes
            page.blit(art, (880 + (470 - art.get_width()) // 2, 30 + (230 - art.get_height()) // 2), special_flags=pg.BLEND_MULT)
            cap = (f"▲{ja_cap}　川原慶賀画" if lang == "ja" else f"▲ {en_cap} · painted by Kawahara Keiga")
            cf = pg.font.Font(subprocess.run(["fc-match", "-f", "%{file}", "Noto Sans CJK JP:regular"], capture_output=True,
                                             text=True).stdout or None, 18)
            parts = [cap]
            if cf.size(cap)[0] > 470:  # two lines, split where it reads well
                cut = cap.rfind("　") if lang == "ja" else cap.rfind(" · ")
                parts = [cap[:cut], "　" + cap[cut:].strip(" ·　")] if cut > 0 else [cap]
            for i, part in enumerate(parts):
                page.blit(cf.render(part, True, c["body"]), (930, 268 + i * 24))
        except (pg.error, OSError):
            pass
        ja, release = POSTER.get(system, (SYSTEMS[system][0] if system in SYSTEMS else system, ""))
        date, _, maker = release.partition("　")
        if not maker:
            date, maker = "", release
        count = sum(len(games(r, system)) for r in s["roms"]) if system in SYSTEMS else sum(
            len([x for x in os.listdir(os.path.join(r, system)) if not x.startswith(".")])
            for r in s["roms"] if os.path.isdir(os.path.join(r, system)))
        # a column of screens from your games
        shots = []
        for media in s["media"]:
            d = os.path.join(media, system, "screenshots")
            if os.path.isdir(d):
                shots += [os.path.join(d, x) for x in sorted(os.listdir(d)) if x.endswith((".png", ".jpg")) and not x.startswith(".")]
        for i, shot in enumerate(rnd.sample(shots, min(4, len(shots)))):
            x, y = 1430, 50 + i * 214
            try:
                im = fill(pg.image.load(shot).convert(), 340, 190)
            except Exception:
                continue
            page.fill(c["block"], (x - 4, y - 4, 348, 198)); page.blit(im, (x, y))
        # the headline (japanese, always), the copy and its caption (english, or japanese)
        fh = f("Noto Sans CJK JP:black", 92)
        page.blit(fh.render("深く、青く。", True, c["ink1"]), (90, 50))
        page.blit(fh.render("あの夏の海へ", True, c["ink2"]), (90, 158))
        en_name = SYSTEMS[system][0] if system in SYSTEMS else system
        maker_en = MAKERS_EN.get(maker, maker)
        arcade = "稼働" in date or system in ("arcade", "mame", "fbneo", "naomi", "atomiswave", "cps1", "cps2", "cps3", "neogeo")
        if lang == "ja":
            intro = f"{date}、{maker}から登場した{ja}。" if date.endswith(("発売", "稼働")) else f"{ja}。"
            body = (f"　{intro}あれから長い時間が流れたけれど、あの頃のゲームたちは、いまも深い青の底で静かに"
                    f"君を待っている。収録タイトルは全{count}本。コントローラーを握れば、画面の向こうにはあの夏の"
                    f"海がひろがる。光の差す水面から、誰も知らない海の底まで、もう一度、深く潜ってみよう……。")
            fb = f("Noto Sans CJK JP:regular", 27)
            lines, line = [], ""
            for ch in body:  # 禁則: no line starts with 、。」…
                if len(line) >= 30 and ch not in "、。」』）…ー":
                    lines.append(line); line = ""
                line += ch
            lines.append(line)
        else:
            when = date_en(date)
            intro = (f"The {en_name}, {'in arcades from' if arcade else 'released'} {when}"
                     f"{' by ' + maker_en if maker_en else ''}. " if when else f"The {en_name}. ")
            body = (f"{intro}Years have passed, but the games of those days are still waiting quietly at the "
                    f"bottom of the deep blue: {count} titles in all. Pick up the controller, and that summer sea "
                    f"opens up beyond the screen. From the sunlit surface down to depths no one has seen, "
                    f"let's dive deep, once more…")
            fb = f("Noto Sans", 28)
            lines, line = [], ""
            for word in body.split():
                trial = f"{line} {word}".strip()
                if fb.size(trial)[0] > 800 and line:
                    lines.append(line); line = word
                else:
                    line = trial
            lines.append(line)
        for i, ln in enumerate(lines):
            page.blit(fb.render(ln, True, c["body"]), (96, 300 + i * 44))
        cy = 300 + len(lines) * 44 + 18
        if lang == "ja":
            page.blit(f("Noto Sans CJK JP:regular", 21).render(caption, True, c["body"]), (96, cy))
        else:  # the ▲ from the japanese font (the italic has none)
            mark = f("Noto Sans CJK JP:regular", 21).render("▲", True, c["body"]); page.blit(mark, (96, cy))
            page.blit(f("Noto Sans:italic", 22).render(caption_en.lstrip("▲ "), True, c["body"]), (96 + mark.get_width() + 6, cy - 1))
        # the data box
        bx, by, bw, bh = 900, 860, 500, 270
        page.fill(c["paper"], (bx, by, bw, bh)); pg.draw.rect(page, c["block"], (bx, by, bw, bh), 3)
        pg.draw.rect(page, c["block"], (bx + 8, by + 8, bw - 16, 90), 2)
        title = ja if lang == "ja" else en_name
        size = 64
        while f("Noto Sans CJK JP:black", size).size(title)[0] > bw - 60:
            size -= 4
        t = f("Noto Sans CJK JP:black", size).render(title, True, c["block"])
        page.blit(t, (bx + 26, by + 53 - t.get_height() // 2))
        if lang == "ja":
            rows = [("機種", "アーケード" if arcade else "家庭用ゲーム機")]
            rows += [(k, v) for k, v in (("メーカー", maker), ("発売日", date.replace("発売", "").replace("稼働", ""))) if v]
            rows.append(("収録", f"{count}本"))
            sep, face = "／", "Noto Sans CJK JP:regular"
        else:
            rows = [("System", "Arcade" if arcade else "Home console")]
            rows += [(k, v) for k, v in (("Maker", maker_en), ("Released", date_en(date))) if v]
            rows.append(("Titles", f"{count}"))
            sep, face = ": ", "Noto Sans"
        for i, (k, v) in enumerate(rows):
            text = f"{k}{sep}{v}"
            px = 23
            while f(face, px).size(text)[0] > bw - 70:
                px -= 1
            pg.draw.circle(page, c["ink1"], (bx + 32, by + 128 + i * 34), 8)
            page.blit(f(face, px).render(text, True, c["body"]), (bx + 48, by + 112 + i * 34))
        page.blit(f("Noto Sans:bold", 30).render(str(rnd.randint(12, 98)), True, (255, 255, 255)), (90, H - 70))
        note = ("©nekozame　※画面は開発中のものです　写真：NOAA（パブリックドメイン）" if lang == "ja" else
                "© nekozame   * screens are from the games   photos: NOAA (public domain)")
        page.blit(f("Noto Sans CJK JP:regular", 20).render(note, True, (255, 255, 255)), (150, H - 62))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    pg.image.save(page, dest)
    return True


def esde_theme(s, pages=True, again=False):
    """nekozame's theme in es-de: its files, your fonts, each system's names and spine,
    and its magazine pages, printed here (again: print them all anew)."""
    if not os.path.isdir(THEME_SRC):
        return False
    dest = os.path.join(ESDE_HOME, "themes/nekozame")
    os.makedirs(dest, exist_ok=True)
    for old in ("core", "collages", "systems"):
        shutil.rmtree(os.path.join(dest, old), ignore_errors=True)
    shutil.copytree(os.path.join(THEME_SRC, "core"), os.path.join(dest, "core"))
    shutil.copyfile(os.path.join(THEME_SRC, "capabilities.xml"), os.path.join(dest, "capabilities.xml"))

    def font(pattern):
        return subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True).stdout
    xml = open(os.path.join(THEME_SRC, "theme.xml")).read()
    for key, pattern in (("JA_BLACK", "Noto Sans CJK JP:black"), ("JA_BOLD", "Noto Sans CJK JP:bold"),
                         ("JA_REGULAR", "Noto Sans CJK JP:regular"), ("SANS_BOLD", "Noto Sans:bold"),
                         ("SANS", "Noto Sans")):
        xml = xml.replace(f"@FONT_{key}@", font(pattern))
    open(os.path.join(dest, "theme.xml"), "w").write(xml)
    from xml.sax.saxutils import escape
    os.makedirs(os.path.join(dest, "systems"), exist_ok=True)
    vertical = {"ー": "丨", "、": "︑", "。": "︒", "・": "・", " ": "　"}
    for system, (name, _, _) in SYSTEMS.items():
        ja, release = POSTER.get(system, (name, ""))
        year = re.match(r"\d{4}", release)
        # down the spine: the name, a gap, the page's little line, again and again
        spine = "\n".join(vertical.get(ch, ch) for ch in f"{ja}　●深い青への誘い　") * 3
        en = f"{name}  ·  {year.group(0) if year else 'nekozame'}  ·  memories of the deep  ·  " * 3
        open(os.path.join(dest, "systems", f"{system}.xml"), "w").write(
            f"<theme>\n    <variables>\n        <nkJa>{escape(ja)}</nkJa>\n        <nkEn>{escape(name)}</nkEn>\n"
            f"        <nkSpine>{escape(spine)}</nkSpine>\n        <nkSpineEn>{escape(en)}</nkSpineEn>\n"
            f"    </variables>\n</theme>\n")
    made = 0
    if pages:
        # every system es-de shows: each folder with something in it (games nekozame
        # can't play itself too, like zipped ones)
        shown = set()
        for root in s["roms"]:
            for d in (os.listdir(root) if os.path.isdir(root) else []):
                path = os.path.join(root, d)
                if not d.startswith(".") and os.path.isdir(path) and any(
                        not f.startswith(".") and not f.lower().endswith((".txt", ".xml"))
                        for f in os.listdir(path)):
                    shown.add(d)
        for system in sorted(shown):
            for scheme in SCHEMES:
                for name, bare, lang in ((f"{system}-{scheme}-en", False, "en"), (f"{system}-{scheme}-ja", False, "ja"),
                                         (f"{system}-{scheme}-bare", True, "en")):
                    out = os.path.join(dest, "pages", f"{name}.jpg")
                    if (again or not os.path.exists(out)) and magazine(system, s, scheme, out, bare, lang):
                        made += 1
    say(f"  the nekozame theme is in es-de ({made} pages printed)")
    return True


def esde(off=False):
    try:
        st = json.load(open(ESDE_STATE))
    except (OSError, ValueError):
        st = {}
    appimage = os.path.join(ESDE, "ES-DE.AppImage")
    desktop = os.path.join(HOME, ".local/share/applications/org.es_de.frontend.desktop")
    if off:
        try:
            if st.get("appid"):
                steam_js()("SteamClient.Apps.RemoveShortcut(%d)" % st["appid"])
        except (OSError, StopIteration):
            say("  (steam isn't running: take ES-DE out of it by hand)")
        shutil.rmtree(ESDE, ignore_errors=True)
        for f in (desktop, ESDE_STATE, os.path.join(ESDE_HOME, "custom_systems/es_systems.xml")):
            if os.path.exists(f):
                os.remove(f)
        say("ES-DE is gone (your game lists, art and saves stay)")
        return 0
    s = settings()
    # es-de itself: the newest release (its steam deck build on a deck)
    with urllib.request.urlopen(ESDE_RELEASES, timeout=30) as r:
        release = json.load(r)[0]
    deck = open("/sys/devices/virtual/dmi/id/sys_vendor").read().strip() == "Valve" \
        if os.path.exists("/sys/devices/virtual/dmi/id/sys_vendor") else False
    want = "ES-DE_x64_SteamDeck.AppImage" if deck else "ES-DE_x64.AppImage"
    link = next(l["url"] for l in release["assets"]["links"] if l["name"] == want)
    if st.get("version") != release["tag_name"] or not os.path.exists(appimage):
        say(f"getting ES-DE {release['tag_name']}")
        os.makedirs(ESDE, exist_ok=True)
        urllib.request.urlretrieve(link, appimage + ".part")
        os.chmod(appimage + ".part", 0o755)
        os.replace(appimage + ".part", appimage)
        st["version"] = release["tag_name"]
    esde_systems(appimage)
    values = {"ROMDirectory": ("string", s["roms"][0]), "MediaDirectory": ("string", s["media"][0]),
              "ApplicationUpdaterFrequency": ("string", "never")}
    if s["steam"].get("names") == "file":
        values["ScrapeGameNames"] = ("bool", "false")
        say(f"  {esde_names()} scraped names cleared: es-de shows your file names")
    if esde_theme(s, again="--again" in sys.argv):
        values["Theme"] = ("string", "nekozame")
    esde_settings(values)
    # in the menu, and in steam with nekozame's art
    icon = os.path.join(ESDE, "es-de.svg")
    if not os.path.exists(icon):
        import tempfile
        with tempfile.TemporaryDirectory() as tmp:
            subprocess.run([appimage, "--appimage-extract", "usr/share/icons/*"], cwd=tmp, capture_output=True)
            found = [os.path.join(d, f) for d, _, fs in os.walk(tmp) for f in fs
                     if f.endswith(".svg") and "es_de" in f and os.path.isfile(os.path.join(d, f))]
            if found:
                shutil.copyfile(found[0], icon)
    os.makedirs(os.path.dirname(desktop), exist_ok=True)
    with open(desktop, "w") as f:
        f.write(f"[Desktop Entry]\nType=Application\nName=ES-DE\nComment=Your whole game library\n"
                f"Exec={appimage}\nIcon={icon}\nCategories=Game;Emulator;\nTerminal=false\n")
    try:
        js = steam_js()
        if not st.get("appid") or not js("appStore.GetAppOverviewByAppID(%d)?.appid" % st["appid"]):
            st["appid"] = js("SteamClient.Apps.AddShortcut(%s, %s, %s, %s)" % (
                json.dumps("ES-DE"), json.dumps(appimage), json.dumps(ESDE), json.dumps("")), wait=True)
            js("SteamClient.Apps.SetShortcutName(%d, %s)" % (st["appid"], json.dumps("ES-DE")))
            import time
            time.sleep(10)  # steam writes the shortcut down; then its art
        subprocess.run(["/usr/libexec/nekozame-steam-art", desktop], capture_output=True)
    except (OSError, StopIteration):
        say("  (steam isn't running: ES-DE goes in its library next time)")
    os.makedirs(os.path.dirname(ESDE_STATE), exist_ok=True)
    json.dump(st, open(ESDE_STATE, "w"))
    say(f"ES-DE {st['version']} is ready: in steam, and in your apps menu")
    return 0


def systems_list():
    s = settings()
    for system, (name, emu, _) in SYSTEMS.items():
        n = sum(len(games(r, system)) for r in s["roms"])
        say(f"  {'●' if n else '○'} {system:16} {name:24} {emu.replace('core:', 'retroarch: '):28} {n or ''}")


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "launch" and len(argv) == 3:
        return launch(argv[1], argv[2])
    if cmd == "setup":
        return setup("--all" in argv)
    if cmd == "steam" and argv[1:2] == ["add"]:
        return steam_add(argv[2:] or None)
    if cmd == "steam" and argv[1:2] == ["remove"]:
        return steam_remove()
    if cmd == "steam" and argv[1:2] == ["refresh"]:
        return steam_refresh()
    if cmd == "steam" and argv[1:2] == ["tabs"]:
        return tabs()
    if cmd == "systems":
        return systems_list()
    if cmd == "art":
        return fetch_art(argv[1:] or None)
    if cmd == "esde" and argv[1:2] in ([], ["on"]):
        return esde()
    if cmd == "esde" and argv[1:2] == ["off"]:
        return esde(off=True)
    say(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
