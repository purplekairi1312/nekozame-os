#!/usr/bin/python3
"""nekozame-emu: nekozame's emulation. your games in folders per system (the layout
es-de, emudeck and most nas setups use: roms/<system>), emulators from flathub,
your saves synced everywhere (nekozame-saves).

  nekozame-emu setup              the emulators for the systems you have games for,
                                  pointed at your folders (run again any time)
  nekozame-emu launch SYSTEM ROM  play: syncs that emulator's saves before and after
  nekozame-emu steam add          every game as its own entry in steam, with its art
  nekozame-emu steam remove       take all of them out of steam again
  nekozame-emu steam refresh      their art and collections again
  nekozame-emu steam tabs         tabmaster's tabs: Apps (without the games), Emulation
  nekozame-emu steam watch        the collections back each time steam starts (steam
                                  forgets big ones; nekozame-emu-collections.service)
  nekozame-emu esde [on|off]      ES-DE, for browsing your whole library: nekozame's
                                  launcher first (saves sync), your names kept, its
                                  magazine theme and music; off takes it away again
                                  (lists and art stay)
  nekozame-emu systems            what's supported, and what you have
  nekozame-emu art [SYSTEM...]    covers and screenshots for games without (libretro's
                                  thumbnail library, matched by your file names)
  nekozame-emu boxes [SYSTEM...]  3d boxes made from the covers, for games with a cover
                                  and no scraped box (--again: the made ones redone)
  nekozame-emu esde gamelists [library|local|both]
                                  where the frontend's game lists live (what's
                                  scraped, favourites, play counts): with the
                                  library (the default), here, or both (a menu)
  nekozame-emu esde gamelists import FOLDER
                                  game lists from elsewhere (an old es-de or
                                  emudeck, a backup) merged into yours
  nekozame-emu video              how games look on this machine: aspect ratio,
                                  resolution, shaders (a menu)
  nekozame-emu achievements       retroachievements: login, hardcore, on or off

settings (~/.config/nekozame/emulation.json), all optional:
  "roms":  ["~/Emulation/roms", "/mnt/mynas/Emulation/roms"]   where your games are
  "bios":  "~/Emulation/bios"                                 bios and firmware
  "media": ["~/Emulation/tools/downloaded_media"]             es-de's scraped art
  "steam": {"roms": ["~/Emulation/roms"],     whose games go in steam (big libraries
                                              on a nas are better browsed in es-de)
            "names": "file",                  game names: "file" (your file names, with
                                              their regions and versions) or "scraped"
            "labels": true}                   the name under each cover, so versions of
                                              a game tell apart in the library
  "music": true, "musicVolume": 40            es-de's music ("dolphin sanctuary" by
                                              purplekairi1312, © 2026, all rights reserved)
  "drawings": "sharks"                        what's printed on each page's sky: 川原慶賀's
                                              "sharks", the "machines" themselves (museum
                                              photos, patent drawings), or "both" (the
                                              machine, a smaller shark below it)
  "gamelists": "library"                      the frontend's game lists: "library" (next to
                                              the art, the default), "local", or "both"
  "video": {"aspect": "console", "resolution": "recommended", "shaders": {"psx": "crt-pal"}}
                                              how games look (nekozame-emu video)
  "achievements": {"enabled": true, "hardcore": false}
                                              retroachievements (nekozame-emu achievements)
  "loadToRam": true                           discs read into memory before a game starts
                                              (ps1, saturn, pc engine cd, ps2, psp), so
                                              one on a network share never stalls
"""
