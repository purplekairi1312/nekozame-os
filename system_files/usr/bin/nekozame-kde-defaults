#!/bin/bash
# on kde plasma (the deck's desktop mode): the nekozame look (its colors, kvantum,
# the panel on top with the nekozame menu, the loading screen), the wallpaper and
# nekozame in gtk and qt apps. once per version of the look, which resets the
# panel to nekozame's; --force runs it again.
set -euo pipefail
VERSION=6
DONE="${XDG_STATE_HOME:-$HOME/.local/state}/nekozame/kde-defaults"
[ "${1:-}" = --force ] || [ "$(cat "$DONE" 2>/dev/null)" != "$VERSION" ] || exit 0
plasma-apply-lookandfeel --apply org.nekozame.desktop --resetLayout || true
plasma-apply-colorscheme nekozame || true
# tela circle once it's been fetched (nekozame-icons), tela pink until then
[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/icons/Tela-circle-pink-dark" ] \
    && /usr/libexec/plasma-changeicons Tela-circle-pink-dark || true
plasma-apply-wallpaperimage /usr/share/wallpapers/nekozame-small || true
# the catshark moving: the video wallpaper (the still one above is its fallback)
Q=$(command -v qdbus-qt6 qdbus6 qdbus 2>/dev/null | head -1)
[ -d /usr/share/plasma/wallpapers/luisbocanegra.smart.video.wallpaper.reborn ] && [ -n "$Q" ] && "$Q" org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript '
desktops().forEach(function (d) {
    d.wallpaperPlugin = "luisbocanegra.smart.video.wallpaper.reborn"
    d.currentConfigGroup = ["Wallpaper", "luisbocanegra.smart.video.wallpaper.reborn", "General"]
    d.writeConfig("VideoUrls", JSON.stringify([{ filename: "file:///usr/share/backgrounds/nekozame/small-16x10.mkv", enabled: true, loop: true }]))
    d.writeConfig("FillMode", 2)
    d.reloadConfig()
})' || true
nekozame-look || true
kwriteconfig6 --file kdeglobals --group KDE --key SingleClick true || true  # one click opens
mkdir -p "$(dirname "$DONE")" && echo "$VERSION" > "$DONE"
# plasma keeps the colors it started with: restart the panel and desktop to show them
systemctl --user restart plasma-plasmashell.service || true
