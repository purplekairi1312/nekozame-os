#!/usr/bin/python3
"""nekozame music: music while you play, picked with the controller.

  your library    a navidrome (or any subsonic) server, e.g. at home over tailscale
  youtube         searched and played without ads (yt-dlp, kept up to date for you)
  this deck       the music in ~/Music

pick something and go back to your games: it keeps playing (nekozame-tunes-player),
and steam's quick access menu (the ··· button) has play/pause and skip.

  controller   d-pad: move   A: play   X: add to the queue   B: back
               Y: play/pause   L1/R1: previous/next   left/right on the top: library, youtube, deck
"""
import hashlib
import json
import os
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.environ.get("NEKOZAME_ROOT", "") + "/usr/share/nekozame-os/python")
import nekoui as ui  # noqa: E402
from nekoui import pygame  # noqa: E402

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "nekozame", "music.json")
YTDLP = os.path.join(HOME, ".local/share/nekozame/yt-dlp")
API = "http://127.0.0.1:47820"
AUDIO = (".mp3", ".flac", ".ogg", ".opus", ".m4a", ".aac", ".wav", ".wv", ".ape", ".alac", ".aiff")


# --- the player (nekozame-tunes-player) -------------------------------------------

def player(path, items=None, append=False):
    try:
        if items is None:
            with urllib.request.urlopen(API + path, timeout=3) as r:
                return json.load(r)
        token = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nekozame-tunes.token")).read().strip()
        req = urllib.request.Request(API + "/play", data=json.dumps({"items": items, "append": append}).encode(),
                                     headers={"Content-Type": "application/json", "X-Nekozame-Token": token})
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.load(r)
    except (OSError, ValueError):
        return None


# --- navidrome / subsonic ------------------------------------------------------------

def conf():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def save_conf(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    fd = os.open(CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, json.dumps(c, indent=2).encode())
    os.close(fd)


def sub_url(method, **params):
    c = conf()
    q = {"u": c.get("user", ""), "t": c.get("token", ""), "s": c.get("salt", ""), "v": "1.16.1", "c": "nekozame", "f": "json"}
    q.update({k: v for k, v in params.items() if v is not None})
    return f'{c.get("server", "").rstrip("/")}/rest/{method}.view?{urllib.parse.urlencode(q)}'


def sub(method, **params):
    with urllib.request.urlopen(sub_url(method, **params), timeout=10) as r:
        data = json.load(r)["subsonic-response"]
    if data.get("status") != "ok":
        raise OSError(data.get("error", {}).get("message", "the server said no"))
    return data


def song_item(s):
    return {"url": sub_url("stream", id=s["id"]), "title": s.get("title", ""), "artist": s.get("artist", "")}


# --- youtube ---------------------------------------------------------------------------

def ytdlp_ready():
    """yt-dlp for you, from its own releases (youtube changes often, so it updates itself)."""
    if not os.path.exists(YTDLP):
        os.makedirs(os.path.dirname(YTDLP), exist_ok=True)
        urllib.request.urlretrieve("https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp", YTDLP)
        os.chmod(YTDLP, 0o755)
    elif time.time() - os.path.getmtime(YTDLP) > 7 * 86400:
        subprocess.Popen([YTDLP, "-U"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.utime(YTDLP)


def youtube_search(q):
    ytdlp_ready()
    out = subprocess.run([YTDLP, f"ytsearch25:{q}", "--flat-playlist", "-J", "--no-warnings"],
                         capture_output=True, text=True, timeout=60).stdout
    rows = []
    for e in json.loads(out or "{}").get("entries", []):
        if not e.get("id"):
            continue
        d = int(e.get("duration") or 0)
        rows.append(Row(e.get("title", ""), f'{e.get("channel") or e.get("uploader") or ""}   {d // 60}:{d % 60:02d}' if d else
                        (e.get("channel") or ""), item={"url": f'https://www.youtube.com/watch?v={e["id"]}',
                                                        "title": e.get("title", ""), "artist": e.get("channel") or ""}))
    return rows


# --- rows and lists -----------------------------------------------------------------------

class Row:
    """one line in a list: a song (item), something to open (open), or an action (act)."""
    def __init__(self, title, sub="", item=None, open=None, act=None, items=None):
        self.title, self.sub, self.item, self.open, self.act, self.items = title, sub, item, open, act, items


class Busy:
    """a list that fills in the background (the network can be slow)."""
    def __init__(self, title, load):
        self.title, self.rows, self.error, self.focus, self.top = title, None, None, 0, 0
        threading.Thread(target=self.run, args=(load,), daemon=True).start()

    def run(self, load):
        try:
            self.rows = load()
        except Exception as e:  # shown, not raised: it's a list on a screen
            self.error = str(e)[:90] or "that didn't work"
            self.rows = []


def library_home():
    c = conf()
    if not (c.get("server") and c.get("token")):
        return [Row("connect to your music server", "navidrome, or any subsonic server (gonic, airsonic…)", act="setup")]
    return [
        Row("search", "artists, albums and songs", act="search-library"),
        Row("recently added", "the newest albums", open=lambda: Busy("recently added", lambda: albums("newest"))),
        Row("random albums", "something you haven't heard in a while", open=lambda: Busy("random albums", lambda: albums("random"))),
        Row("most played", "your favourites", open=lambda: Busy("most played", lambda: albums("frequent"))),
        Row("playlists", "", open=lambda: Busy("playlists", playlists)),
        Row("server", c.get("server", ""), act="setup"),
    ]


def albums(kind):
    out = sub("getAlbumList2", type=kind, size=60)["albumList2"].get("album", [])
    return [Row(a.get("name", ""), f'{a.get("artist", "")}   {a.get("year", "")}'.strip(),
                open=(lambda a=a: Busy(a.get("name", ""), lambda: album(a["id"])))) for a in out]


def album(aid):
    songs = sub("getAlbum", id=aid)["album"].get("song", [])
    items = [song_item(s) for s in songs]
    rows = [Row("play the album", f"{len(songs)} songs", items=items), Row("add it to the queue", "", items=items, act="append")]
    return rows + [Row(s.get("title", ""), s.get("artist", ""), item=song_item(s), items=items[i:]) for i, s in enumerate(songs)]


def playlists():
    out = sub("getPlaylists")["playlists"].get("playlist", [])
    return [Row(p.get("name", ""), f'{p.get("songCount", 0)} songs',
                open=(lambda p=p: Busy(p.get("name", ""), lambda: playlist(p["id"])))) for p in out]


def playlist(pid):
    songs = sub("getPlaylist", id=pid)["playlist"].get("entry", [])
    items = [song_item(s) for s in songs]
    return [Row("play it", f"{len(songs)} songs", items=items)] + \
        [Row(s.get("title", ""), s.get("artist", ""), item=song_item(s), items=items[i:]) for i, s in enumerate(songs)]


def search_library(q):
    r = sub("search3", query=q, artistCount=0, albumCount=20, songCount=40)["searchResult3"]
    rows = [Row(a.get("name", ""), "album · " + a.get("artist", ""),
                open=(lambda a=a: Busy(a.get("name", ""), lambda: album(a["id"])))) for a in r.get("album", [])]
    songs = r.get("song", [])
    return rows + [Row(s.get("title", ""), s.get("artist", ""), item=song_item(s)) for s in songs]


def deck_folder(path):
    try:
        names = sorted(os.listdir(path), key=str.lower)
    except OSError:
        return [Row("no music here yet", "put some in ~/Music")]
    dirs = [n for n in names if os.path.isdir(os.path.join(path, n)) and not n.startswith(".")]
    files = [n for n in names if n.lower().endswith(AUDIO)]
    everything = []
    for root, ds, fs in os.walk(path):
        ds.sort(key=str.lower)
        everything += [os.path.join(root, f) for f in sorted(fs, key=str.lower) if f.lower().endswith(AUDIO)]
    item = lambda f: {"url": f, "title": os.path.splitext(os.path.basename(f))[0], "artist": ""}
    rows = [Row("play everything here", f"{len(everything)} songs", items=[item(f) for f in everything])] if everything else []
    rows += [Row(d, "folder", open=(lambda d=d: Busy(d, lambda: deck_folder(os.path.join(path, d))))) for d in dirs]
    full = [os.path.join(path, f) for f in files]
    rows += [Row(os.path.splitext(f)[0], "", item=item(p), items=[item(x) for x in full[i:]]) for i, (f, p) in enumerate(zip(files, full))]
    return rows


TABS = [("your library", library_home), ("youtube", lambda: [Row("search youtube", "played without ads", act="search-youtube")]),
        ("this deck", lambda: deck_folder(os.path.join(HOME, "Music")))]


# --- the app ---------------------------------------------------------------------------------

class App:
    def __init__(self, look):
        self.look, self.tab, self.stack, self.kb, self.kb_for = look, 0, [], None, None
        self.state, self.note, self.note_until = {}, "", 0
        self.reset_tab()
        threading.Thread(target=self.poll, daemon=True).start()

    def reset_tab(self):
        self.stack = [Busy(TABS[self.tab][0], TABS[self.tab][1])]

    def poll(self):
        while True:
            self.state = player("/state") or {}
            time.sleep(1)

    def say(self, text):
        self.note, self.note_until = text, time.time() + 3

    # what A does on a row
    def choose(self, row, append=False):
        if row.act == "setup":
            self.start_setup()
        elif row.act in ("search-library", "search-youtube"):
            self.kb, self.kb_for = ui.Keyboard("search " + ("youtube" if row.act == "search-youtube" else "your library")), row.act
        elif row.open:
            self.stack.append(row.open())
        elif row.items or row.item:
            items = row.items if (row.items and not append) else [row.item] if row.item else row.items
            ok = player("/play", items=items, append=append or row.act == "append")
            self.say(("added to the queue" if append or row.act == "append" else "playing") if ok else
                     "the player isn't answering")

    def start_setup(self):
        c = conf()
        self.setup = {"server": c.get("server", "http://"), "user": c.get("user", "")}
        self.kb, self.kb_for = ui.Keyboard("your music server's address", self.setup["server"]), "server"

    def typed(self, text):
        kind, self.kb, self.kb_for = self.kb_for, None, None
        if kind == "search-library":
            self.stack.append(Busy(f"“{text}”", lambda: search_library(text)))
        elif kind == "search-youtube":
            self.stack.append(Busy(f"“{text}” on youtube", lambda: youtube_search(text)))
        elif kind == "server":
            self.setup["server"] = text.strip()
            self.kb, self.kb_for = ui.Keyboard("your user name", self.setup["user"]), "user"
        elif kind == "user":
            self.setup["user"] = text.strip()
            self.kb, self.kb_for = ui.Keyboard("your password", secret=True), "password"
        elif kind == "password":
            # subsonic's way: a salted md5, so the password itself isn't kept
            salt = os.urandom(6).hex()
            save_conf({**self.setup, "salt": salt, "token": hashlib.md5((text + salt).encode()).hexdigest()})
            try:
                sub("ping")
                self.say("connected <3")
            except Exception as e:
                self.say("couldn't connect: " + str(e)[:60])
            self.reset_tab()

    def handle(self, acts, text, clicks):
        if self.kb:
            r = self.kb.handle(acts, text, clicks, self.look)
            if r == "cancel":
                self.kb = None
            elif isinstance(r, tuple) and r[0] == "done":
                self.typed(r[1])
            return True
        if ui.PAUSE in acts:
            player("/toggle")
        if ui.PREV in acts:
            player("/prev")
        if ui.NEXT in acts:
            player("/next")
        view = self.stack[-1]
        rows = view.rows or []
        if len(self.stack) == 1 and (ui.LEFT in acts or ui.RIGHT in acts):
            self.tab = (self.tab + (1 if ui.RIGHT in acts else -1)) % len(TABS)
            self.reset_tab()
            return True
        if rows:
            if ui.UP in acts:
                view.focus = (view.focus - 1) % len(rows)
            if ui.DOWN in acts:
                view.focus = (view.focus + 1) % len(rows)
            if ui.OK in acts:
                self.choose(rows[view.focus])
            if ui.DEL in acts:
                self.choose(rows[view.focus], append=True)
            for pos in clicks:
                for i, r in getattr(view, "rects", []):
                    if r.collidepoint(pos):
                        view.focus = i
                        self.choose(rows[i])
        if ui.BACK in acts:
            if len(self.stack) > 1:
                self.stack.pop()
            else:
                return False  # back to your games; the music keeps going
        return True

    def draw(self, t):
        look, s = self.look, self.look.s
        if self.kb:
            self.kb.draw(look, t)
            return
        # tabs
        x = int(look.w * 0.08)
        for i, (name, _) in enumerate(TABS):
            img = look.mid.render(name, True, ui.DEEP if i == self.tab else ui.WHITE)
            r = pygame.Rect(x, int(24 * s), img.get_width() + int(36 * s), int(46 * s))
            look.panel(r, ui.PINK if i == self.tab else ui.PANEL, None, radius=23)
            look.screen.blit(img, (r.x + int(18 * s), r.y + int(8 * s)))
            x = r.right + int(14 * s)
        view = self.stack[-1]
        if len(self.stack) > 1:
            look.label(view.title, look.text, ui.SOFT, (int(look.w * 0.08), int(84 * s)))
        top, rowh = int(118 * s), int(58 * s)
        if view.rows is None:
            look.label("loading…", look.mid, ui.DIM, (look.w // 2, look.h // 2 - int(40 * s)), center=True)
        elif view.error:
            look.label(view.error, look.text, ui.ROSE, (look.w // 2, look.h // 2 - int(40 * s)), center=True)
        else:
            visible = max(1, (look.h - top - int(150 * s)) // (rowh + int(6 * s)))
            view.top = min(max(view.top, view.focus - visible + 1), view.focus)
            view.rects = []
            for k, row in enumerate(view.rows[view.top:view.top + visible]):
                i = view.top + k
                r = pygame.Rect(int(look.w * 0.08), top + k * (rowh + int(6 * s)), int(look.w * 0.84), rowh)
                view.rects.append((i, r))
                on = i == view.focus
                look.panel(r, ui.RAISED if on else ui.PANEL, ui.PINK if on else None, radius=14)
                look.label(row.title[:70], look.text, ui.WHITE, (r.x + int(18 * s), r.y + int(6 * s)))
                if row.sub:
                    look.label(row.sub[:90], look.small, ui.DIM, (r.x + int(18 * s), r.y + int(32 * s)))
        # now playing
        st = self.state
        bar = pygame.Rect(0, look.h - int(104 * s), look.w, int(104 * s))
        look.panel(bar, ui.DEEP, None, radius=0, alpha=245)
        if st and not st.get("idle"):
            look.label(("paused · " if st.get("paused") else "") + (st.get("title") or "")[:60], look.mid, ui.PINK,
                       (int(look.w * 0.05), bar.y + int(14 * s)))
            look.label(st.get("artist", "")[:60], look.text, ui.WHITE, (int(look.w * 0.05), bar.y + int(52 * s)))
            d, p = st.get("duration") or 0, st.get("position") or 0
            if d:
                w = int(look.w * 0.9)
                pygame.draw.rect(look.screen, ui.RAISED, (int(look.w * 0.05), bar.y + int(88 * s), w, int(5 * s)), border_radius=3)
                pygame.draw.rect(look.screen, ui.PINK, (int(look.w * 0.05), bar.y + int(88 * s), int(w * min(1, p / d)), int(5 * s)), border_radius=3)
        else:
            look.label("nothing playing", look.mid, ui.DIM, (int(look.w * 0.05), bar.y + int(30 * s)))
        hint = self.note if time.time() < self.note_until else \
            "A: play   X: queue   Y: pause   L1/R1: skip   B: back" + ("" if len(self.stack) > 1 else " to your games (it keeps playing)")
        img = look.small.render(hint, True, ui.SOFT if time.time() < self.note_until else ui.DIM)
        look.screen.blit(img, (look.w - img.get_width() - int(look.w * 0.05), bar.y + int(18 * s)))


def main():
    subprocess.run(["systemctl", "--user", "start", "nekozame-tunes-player.service"], capture_output=True)
    pygame.init()
    screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
    pygame.display.set_caption("nekozame music")
    ui.show_in_game_mode()
    look, inp, clock = ui.Look(screen), ui.Input(), pygame.time.Clock()
    app, t0 = App(look), time.time()
    running = True
    while running:
        events = pygame.event.get()
        if any(e.type == pygame.QUIT for e in events):
            break
        acts, text, clicks = inp.actions(events)
        look.background(time.time() - t0)
        app.draw(time.time() - t0)
        pygame.display.flip()
        running = app.handle(acts, text, clicks)
        clock.tick(30)
    pygame.quit()


if __name__ == "__main__":
    main()
