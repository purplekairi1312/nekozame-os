#!/bin/bash
# nekozame-setup: setting up nekozame os for your user. opens by itself on the first
# login; run it again any time with ujust nekozame-setup. what's done stays done.
#   on for everyone: zen with the privacy extensions, tailscale, sunshine,
#   doom emacs, the theme and wallpaper, and the theme in zen, discord and bitwig
#   asked: your screens and the dock (niri), fonts, logging in automatically, emulation, evil mode or another editor, music
#   production, helium
set -uo pipefail
[ -r /usr/share/nekozame-os/colors.sh ] && . /usr/share/nekozame-os/colors.sh  # gum in nekozame's colours
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nekozame"
DONE="$STATE/setup-done"

if [ "${1:-}" = --first-run ]; then
    [ -e "$DONE" ] && exit 0
    if [ ! -t 0 ]; then  # from autostart: open in a terminal
        for t in ghostty konsole; do
            command -v "$t" >/dev/null && exec "$t" -e "$0" --first-run
        done
        exit 0
    fi
fi
mkdir -p "$STATE"

pink() { gum style --foreground "#ffc0e5" --bold "$*"; }
step() { echo; pink "▸ $*"; }
ask() { gum confirm --default="${2:-true}" "$1"; }  # ask QUESTION [false]
ok() { echo "  ✓ $*"; }

gum style --border rounded --border-foreground "#ffc0e5" --padding "0 2" \
    "nekozame os setup 🦈" "" "the defaults are already picked: press enter to keep them."
if ! ask "Set up now? (later: ujust nekozame-setup)"; then
    touch "$DONE"; exit 0
fi

step "Shortcuts"
if [ -f /etc/greetd/config.toml ]; then
    nekozame-keys
    echo "  Super works like Cmd (Super+C/V/X), Ctrl+Alt moves windows. Super+Shift+/ shows them all"
fi

if [ -n "${NIRI_SOCKET:-}" ] || ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/niri.wayland-*.sock >/dev/null 2>&1; then
    step "Your screens: scale, refresh rate, the pointer's and the bar's size"
    if [ -e "$STATE/display-done" ]; then
        ok "set (change it: ujust nekozame-display)"
    else
        nekozame-display && touch "$STATE/display-done"
    fi
fi

step "Fonts: the interface's and code's"
if [ -s "${XDG_CONFIG_HOME:-$HOME/.config}/nekozame/fonts" ]; then
    ok "set (change them: ujust nekozame-fonts)"
else
    nekozame-fonts || true
fi

# the dock: dms's own, off unless you want it (dms remembers the choice). with one, its
# icons grow under the mouse (magnification: dms's commands can't set it; dms reads its
# settings file again when it changes)
dock_magnify() {
    python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/dms/settings.json" <<'PY'
import json, sys
p = sys.argv[1]
try:
    s = json.load(open(p))
except (OSError, ValueError):
    sys.exit(0)
docks = s.get("dockConfigs") or []
for d in docks:
    d["magnification"] = True
if docks:
    json.dump(s, open(p, "w"), indent=2)
PY
}
if [ -n "${NIRI_SOCKET:-}" ] || ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/niri.wayland-*.sock >/dev/null 2>&1; then
    step "The dock"
    NODOCK="No dock (recommended)"; DOCK="A dock at the bottom"; HIDING="A dock that hides until the mouse reaches it"
    case "$(dms ipc call dock status 2>/dev/null)" in visible) now="$DOCK" ;; *) now="$NODOCK" ;; esac
    case "$(gum choose --header "A dock for your apps?" --selected="$now" "$NODOCK" "$DOCK" "$HIDING")" in
        "$DOCK") dms ipc call dock reveal >/dev/null && dms ipc call dock manualHide >/dev/null && sleep 1 && dock_magnify &&
            ok "a dock at the bottom, its icons growing under the mouse" ;;
        "$HIDING") dms ipc call dock reveal >/dev/null && dms ipc call dock autoHide >/dev/null && sleep 1 && dock_magnify &&
            ok "a dock that hides, its icons growing under the mouse" ;;
        "$NODOCK") dms ipc call dock hide >/dev/null; ok "no dock (change it: DMS's settings, Super+,)" ;;
    esac
fi

step "Zen browser"
if flatpak info app.zen_browser.zen >/dev/null 2>&1; then
    ok "installed"
else
    flatpak install --system -y flathub app.zen_browser.zen && ok "installed"
fi
echo "  dark reader, ublock origin, privacy badger, libredirect and"
echo "  consent-o-matic come with it; duckduckgo, https-only, no telemetry."

step "Music: Tauon, the player for your music"
if flatpak info com.github.taiko2k.tauonmb >/dev/null 2>&1; then
    ok "installed"
else
    flatpak install --system -y flathub com.github.taiko2k.tauonmb && ok "installed"
fi
# it opens your music files
xdg-mime default com.github.taiko2k.tauonmb.desktop audio/mpeg audio/flac audio/ogg audio/x-vorbis+ogg \
    audio/opus audio/mp4 audio/x-m4a audio/aac audio/wav audio/x-wav audio/x-ape audio/x-wavpack 2>/dev/null
echo "  your navidrome or jellyfin goes in its settings. in game mode, ujust nekozame-decky"
echo "  puts it (and youtube without ads) in the quick access menu"

if [ "$(cat /usr/share/nekozame-os/variant 2>/dev/null)" != deck ]; then  # the deck asks in its first boot
    step "Steam: Decky and its plugins (in Steam's Big Picture and Game Mode)"
    if [ -d "$HOME/homebrew/plugins" ] && [ -n "$(ls "$HOME/homebrew/plugins" 2>/dev/null)" ]; then
        ok "installed (update: ujust nekozame-decky)"
    elif ask "Install Decky with nekozame's plugins? (nekozame music, SteamGridDB for art, TabMaster for your library's tabs, ProtonDB Badges)" false; then
        pkexec /usr/libexec/nekozame-decky && ok "installed: in Steam's quick access menu (Big Picture, or Game Mode from the login screen)"
    fi
fi

step "Tailscale"
if tailscale status >/dev/null 2>&1; then
    ok "logged in"
elif ask "Log in to Tailscale? (Sunshine and SSH between your machines go through it)"; then
    sudo systemctl enable --now tailscaled
    sudo tailscale set --operator="$USER"  # tailscale works without sudo after this
    tailscale login && ok "logged in"
fi

step "Sunshine (stream this machine to Moonlight)"
sunshine_on() {
    local u
    for u in app-dev.lizardbyte.app.Sunshine.service sunshine.service; do
        systemctl --user is-enabled -q "$u" 2>/dev/null && return 0
    done
    return 1
}
if sunshine_on; then
    ok "on"
elif ask "Turn on Sunshine, always running over Tailscale?"; then
    NEKOZAME_SETUP=1 nekozame-sunshine
fi

if [ "$(cat /usr/share/nekozame-os/variant 2>/dev/null)" = deck ]; then
    step "Moonlight (play your other machines' games here)"
    if flatpak info com.moonlight_stream.Moonlight >/dev/null 2>&1; then
        ok "installed"
    elif ask "Install Moonlight, to stream games from your PCs to the Deck?"; then
        flatpak install --system -y flathub com.moonlight_stream.Moonlight \
            && steamos-add-to-steam /var/lib/flatpak/exports/share/applications/com.moonlight_stream.Moonlight.desktop 2>/dev/null
        ok "installed, and in steam's library"
    fi
fi

if [ -f /etc/greetd/config.toml ]; then  # the deck starts in game mode by itself
    step "Logging in automatically"
    if nekozame-autologin status >/dev/null; then
        ok "on"
    else
        sunshine_on && d=true || d=false
        if ask "Log in automatically at boot? (good for streaming: there's always a desktop)" $d; then
            nekozame-autologin on
        fi
    fi
fi

step "Emulation: your whole game library, from a folder or a NAS, on every machine"
if [ -s "$HOME/.config/nekozame/emulation.json" ]; then
    ok "set up (more: ujust nekozame-emulation)"
elif ask "Set up emulation? (where your games are, the emulators, saves synced, Steam, the frontend)" false; then
    nekozame-emulation
fi

step "Editor"
if [ -x "$HOME/.config/emacs/bin/doom" ]; then
    ok "doom emacs (change it: ujust nekozame-editor)"
elif [ -s "$HOME/.config/nekozame/editor" ]; then
    ok "$(cat "$HOME/.config/nekozame/editor") (change it: ujust nekozame-editor)"
else
    DOOM="Doom Emacs (emacs keys)"; EVIL="Doom Emacs with evil mode (vim keys)"; OWN="Another editor"
    case "$(gum choose --header "Your editor (\$EDITOR):" --selected="$DOOM" "$DOOM" "$EVIL" "$OWN")" in
        "$DOOM") nekozame-doom ;;
        "$EVIL") nekozame-doom --evil ;;
        "$OWN") nekozame-editor ;;
    esac
fi

step "Music production"
if command -v yabridgectl >/dev/null || [ -x "$HOME/.local/bin/yabridgectl" ]; then
    ok "set up (more DAWs: ujust nekozame-music-production)"
elif ask "Set up music production? (DAWs, plugins, Windows plugins)" false; then
    nekozame-music-production
fi

step "nekozame in your apps: Zen, Discord, Bitwig, gtk and qt apps, yazi"
nekozame-apps-theme
nekozame-look

step "Helium (a second browser, optional)"
if [ -x "$HOME/.local/bin/helium" ]; then
    ok "installed"
elif ask "Install Helium? It gets the same extensions and settings as Zen" false; then
    nekozame-helium
fi

touch "$DONE"
echo; pink "all set <3"
echo "  everything nekozame: ujust (the [nekozame] ones)"
if [ "${1:-}" = --first-run ]; then read -r -p "  press enter to close " _; fi
