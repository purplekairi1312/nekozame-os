    <!-- the covers along the foot of the page, like a strip of film -->
    <variant name="filmstrip, filmstrip-title, filmstrip-cover, filmstrip-box, filmstrip-media, filmstrip-video">
        <view name="gamelist">
            <image name="flag">
                <pos>0.903 0.49</pos>
            </image>
            <image name="flag2">
                <pos>0.856 0.49</pos>
            </image>
            <image name="screenFrame">
                <pos>0.045 0.17</pos>
                <size>0.45 0.48</size>
            </image>
            <image name="screen">
                <pos>0.27 0.41</pos>
                <maxSize>0.442 0.466</maxSize>
            </image>
            <video name="screenVideo">
                <pos>0.27 0.41</pos>
                <maxSize>0.442 0.466</maxSize>
            </video>
            <image name="dataBox">
                <pos>0.53 0.17</pos>
                <size>0.383 0.33</size>
            </image>
            <image name="descBox">
                <pos>0.53 0.515</pos>
                <size>0.383 0.135</size>
                <path>./core/block.svg</path>
                <color>${paper}</color>
                <zIndex>10</zIndex>
            </image>
            <text name="description">
                <pos>0.54 0.523</pos>
                <size>0.363 0.12</size>
            </text>
            <image name="boxArt">
                <pos>0.1507 0.4100</pos>
                <maxSize>0.1980 0.4560</maxSize>
            </image>
