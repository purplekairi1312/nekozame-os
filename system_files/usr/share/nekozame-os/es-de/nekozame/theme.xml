            </image>
            <textlist name="gamelist">
                <regionFlags>true</regionFlags>
                <pos>0.607 0.43</pos>
                <size>0.299 0.49</size>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.024</fontSize>
                <lineSpacing>1.5</lineSpacing>
                <primaryColor>${body}</primaryColor>
                <secondaryColor>${ink1}</secondaryColor>
                <selectedColor>${selText}</selectedColor>
                <selectedSecondaryColor>${selText}</selectedSecondaryColor>
                <selectedBackgroundColor>${ink1}</selectedBackgroundColor>
                <selectedSecondaryBackgroundColor>${ink1}</selectedSecondaryBackgroundColor>
