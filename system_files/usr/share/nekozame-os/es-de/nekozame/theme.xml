<!-- nekozame for ES-DE, by purplekairi1312 (GPL-3.0, like nekozame-os). each system is a
     page from a 90s japanese game magazine; the spine's words move. the fonts
     (@FONT_*@) are filled in by nekozame-emu esde from the machine's own. -->
<theme>
    <variables>
        <jaBlack>@FONT_JA_BLACK@</jaBlack>
        <jaBold>@FONT_JA_BOLD@</jaBold>
        <jaRegular>@FONT_JA_REGULAR@</jaRegular>
        <sansBold>@FONT_SANS_BOLD@</sansBold>
        <sans>@FONT_SANS@</sans>
        <!-- each system: its japanese and english names, and what its spine says
             (./systems/<system>.xml) -->
        <nkJa>${system.fullName}</nkJa>
        <nkEn>${system.fullName}</nkEn>
        <nkSpine>${system.fullName}</nkSpine>
        <nkSpineEn>${system.fullName}</nkSpineEn>
        <nkSystemFile>./systems/${system.theme}.xml</nkSystemFile>
    </variables>

    <colorScheme name="nekozame">
        <variables>
            <nkScheme>nekozame</nkScheme>
            <ink1>5a4f6e</ink1>
            <ink2>8a76a8</ink2>
            <block>433a55</block>
            <paper>fff4fa</paper>
            <body>433a55</body>
            <frame>433a55</frame>
            <boxInk>433a55</boxInk>
            <spineInk>433a55</spineInk>
            <selText>ffffff</selText>
        </variables>
    </colorScheme>
    <colorScheme name="lilac">
        <variables>
            <nkScheme>lilac</nkScheme>
            <ink1>7c6a9a</ink1>
            <ink2>5a4f6e</ink2>
            <block>433a55</block>
            <paper>fff4fa</paper>
            <body>433a55</body>
            <frame>433a55</frame>
            <boxInk>433a55</boxInk>
            <spineInk>ffffff</spineInk>
            <selText>ffffff</selText>
        </variables>
    </colorScheme>
    <colorScheme name="sakura">
        <variables>
            <nkScheme>sakura</nkScheme>
            <ink1>b02e68</ink1>
            <ink2>5c3e74</ink2>
            <block>281a34</block>
            <paper>f8f2e8</paper>
            <body>281a34</body>
            <frame>281a34</frame>
            <boxInk>281a34</boxInk>
            <spineInk>ffffff</spineInk>
            <selText>ffffff</selText>
        </variables>
    </colorScheme>
    <colorScheme name="ocean">
        <variables>
            <nkScheme>ocean</nkScheme>
            <ink1>1a3c7c</ink1>
            <ink2>18708c</ink2>
            <block>0a1630</block>
            <paper>f6f9fa</paper>
            <body>101c34</body>
            <frame>0a1630</frame>
            <boxInk>0a1630</boxInk>
            <spineInk>ffffff</spineInk>
            <selText>ffffff</selText>
        </variables>
    </colorScheme>
    <colorScheme name="sunset">
        <variables>
            <nkScheme>sunset</nkScheme>
            <ink1>d66078</ink1>
            <ink2>6e4882</ink2>
            <block>3c2846</block>
            <paper>fff8e8</paper>
            <body>3c2846</body>
            <frame>3c2846</frame>
            <boxInk>3c2846</boxInk>
            <spineInk>ffffff</spineInk>
            <selText>ffffff</selText>
        </variables>
    </colorScheme>

    <!-- the longer texts: english by default, japanese with ui settings > theme language -->
    <language name="en_US">
        <variables>
            <nkLang>en</nkLang>
            <lblDate>● Released</lblDate>
            <lblMaker>● Publisher</lblMaker>
            <lblGenre>● Genre</lblGenre>
            <lblPlayers>● Players</lblPlayers>
            <!-- numbers only: the frontend has no month names (%B) -->
            <dateFormat>%Y-%m-%d</dateFormat>
        </variables>
    </language>
    <language name="ja_JP">
        <variables>
            <nkLang>ja</nkLang>
            <lblDate>●発売日／</lblDate>
            <lblMaker>●メーカー／</lblMaker>
            <lblGenre>●ジャンル／</lblGenre>
            <lblPlayers>●プレイ人数／</lblPlayers>
            <dateFormat>%Y年%m月%d日</dateFormat>
        </variables>
    </language>

    <include>${nkSystemFile}</include>

    <variant name="all">
        <view name="system, gamelist">
            <!-- the spine: its block, the system's names moving down it -->
            <image name="spineBlock">
                <pos>0.9375 0.06</pos>
                <size>0.0625 0.58</size>
                <path>./core/block.svg</path>
                <color>${block}</color>
                <zIndex>30</zIndex>
            </image>
            <text name="spineJa">
                <pos>0.9375 0.075</pos>
                <size>0.0625 0.55</size>
                <text>${nkSpine}</text>
                <container>true</container>
                <containerType>vertical</containerType>
                <containerScrollSpeed>0.6</containerScrollSpeed>
                <containerStartDelay>1.5</containerStartDelay>
                <containerResetDelay>0</containerResetDelay>
                <fontPath>${jaBlack}</fontPath>
                <fontSize>0.046</fontSize>
                <color>ffffff</color>
                <horizontalAlignment>center</horizontalAlignment>
                <lineSpacing>1.3</lineSpacing>
                <zIndex>31</zIndex>
            </text>
            <!-- the spine printed on paper: 川原慶賀's paper (naturalis, public domain), its
                 grain and the fold, over the spine and its words -->
            <image name="spinePaper">
                <pos>0.9375 0</pos>
                <size>0.0625 1</size>
                <path>./core/spine-paper.png</path>
                <zIndex>33</zIndex>
            </image>
            <text name="spineEn">
                <pos>0.96875 0.82</pos>
                <origin>0.5 0.5</origin>
                <size>0.19 0.04</size>
                <rotation>90</rotation>
                <text>${nkSpineEn}</text>
                <container>true</container>
                <containerType>horizontal</containerType>
                <containerScrollSpeed>0.6</containerScrollSpeed>
                <containerStartDelay>1.5</containerStartDelay>
                <containerScrollGap>2</containerScrollGap>
                <fontPath>${sansBold}</fontPath>
                <fontSize>0.03</fontSize>
                <color>${spineInk}</color>
                <letterCase>uppercase</letterCase>
                <zIndex>31</zIndex>
            </text>
            <helpsystem name="help">
                <pos>0.925 0.975</pos>
                <origin>1 0.5</origin>
                <textColor>ffffffdd</textColor>
                <iconColor>ffffff</iconColor>
                <textColorDimmed>ffffff99</textColorDimmed>
                <iconColorDimmed>ffffff99</iconColorDimmed>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.02</fontSize>
            </helpsystem>
            <clock name="clock">
                <pos>0.925 0.008</pos>
                <origin>1 0</origin>
                <fontPath>${sans}</fontPath>
                <fontSize>0.022</fontSize>
                <color>${body}</color>
                <format>%H:%M</format>
            </clock>
            <systemstatus name="systemStatus">
                <pos>0.88 0.009</pos>
                <origin>1 0</origin>
                <height>0.022</height>
                <color>${body}</color>
            </systemstatus>
        </view>

        <!-- systems: the page, printed for each (nekozame-emu esde) -->
        <view name="system">
            <image name="page">
                <pos>0 0</pos>
                <size>1 1</size>
                <path>./pages/${system.theme}-${nkScheme}-${nkLang}.jpg</path>
                <default>./core/sky-${nkScheme}.svg</default>
                <zIndex>0</zIndex>
            </image>
            <carousel name="systemCarousel">
                <type>horizontal</type>
                <pos>0.05 0.86</pos>
                <size>0.4 0.05</size>
                <staticImage>./logos/${system.theme}.svg</staticImage>
                <text>${nkJa}</text>
                <color>00000000</color>
                <textColor>ffffff</textColor>
                <textBackgroundColor>00000000</textBackgroundColor>
                <fontPath>${jaBold}</fontPath>
                <fontSize>0.026</fontSize>
                <itemHorizontalAlignment>left</itemHorizontalAlignment>
                <maxItemCount>3</maxItemCount>
                <itemSize>0.14 0.045</itemSize>
                <itemScale>1.15</itemScale>
                <unfocusedItemOpacity>0.45</unfocusedItemOpacity>
                <zIndex>20</zIndex>
            </carousel>
        </view>

        <!-- a system's games: the page's picture and sky, its name as the headline -->
        <view name="gamelist">
            <image name="page">
                <pos>0 0</pos>
                <size>1 1</size>
                <path>./pages/${system.theme}-${nkScheme}-bare.jpg</path>
                <default>./core/sky-${nkScheme}.svg</default>
                <zIndex>0</zIndex>
            </image>
            <text name="headline">
                <pos>0.045 0.03</pos>
                <size>0.6 0.09</size>
                <text>${nkJa}</text>
                <fontPath>${jaBlack}</fontPath>
                <fontSize>0.07</fontSize>
                <color>${ink1}</color>
                <zIndex>20</zIndex>
            </text>
            <gamelistinfo name="gamelistInfo">
                <pos>0.048 0.12</pos>
                <size>0.4 0.03</size>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.022</fontSize>
                <color>${ink2}</color>
                <zIndex>20</zIndex>
            </gamelistinfo>
            <!-- the game's own page: its screen framed, its data in a box -->
            <image name="screenFrame">
                <pos>0.557 0.064</pos>
                <size>0.356 0.37</size>
                <path>./core/block.svg</path>
                <color>${frame}</color>
                <zIndex>10</zIndex>
            </image>
            <image name="screen">
                <pos>0.735 0.249</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.348 0.356</maxSize>
                <imageType>screenshot, titlescreen</imageType>
                <default>./core/default-cover.svg</default>
                <scrollFadeIn>true</scrollFadeIn>
                <zIndex>11</zIndex>
            </image>
            <video name="screenVideo">
                <pos>0.735 0.249</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.348 0.356</maxSize>
                <imageType>screenshot, titlescreen</imageType>
                <defaultImage>./core/default-cover.svg</defaultImage>
                <delay>1.2</delay>
                <audio>false</audio>
                <scrollFadeIn>true</scrollFadeIn>
                <visible>false</visible>
                <zIndex>11</zIndex>
            </video>
            <image name="dataBox">
                <pos>0.557 0.47</pos>
                <size>0.356 0.46</size>
                <path>./core/block.svg</path>
                <color>${paper}</color>
                <zIndex>10</zIndex>
            </image>
            <image name="dataRule">
                <pos>0.567 0.58</pos>
                <size>0.336 0.004</size>
                <path>./core/block.svg</path>
                <color>${boxInk}</color>
                <zIndex>11</zIndex>
            </image>
            <text name="gameName">
                <pos>0.567 0.48</pos>
                <size>0.336 0.095</size>
                <metadata>name</metadata>
                <!-- one line, sliding sideways when the name doesn't fit -->
                <container>true</container>
                <containerType>horizontal</containerType>
                <containerStartDelay>2</containerStartDelay>
                <containerResetDelay>3</containerResetDelay>
                <fontPath>${jaBlack}</fontPath>
                <fontSize>0.034</fontSize>
                <color>${boxInk}</color>
                <verticalAlignment>center</verticalAlignment>
                <zIndex>12</zIndex>
            </text>
            <text name="labelDate">
                <pos>0.567 0.6</pos>
                <size>0.11 0.04</size>
                <text>${lblDate}</text>
                <fontPath>${jaBold}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${ink1}</color>
                <zIndex>12</zIndex>
            </text>
            <datetime name="date">
                <pos>0.667 0.6</pos>
                <size>0.236 0.04</size>
                <metadata>releasedate</metadata>
                <format>${dateFormat}</format>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${body}</color>
                <zIndex>12</zIndex>
            </datetime>
            <text name="labelMaker">
                <pos>0.567 0.645</pos>
                <size>0.11 0.04</size>
                <text>${lblMaker}</text>
                <fontPath>${jaBold}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${ink1}</color>
                <zIndex>12</zIndex>
            </text>
            <text name="maker">
                <pos>0.667 0.645</pos>
                <size>0.236 0.04</size>
                <metadata>publisher</metadata>
                <defaultValue>―</defaultValue>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${body}</color>
                <zIndex>12</zIndex>
            </text>
            <text name="labelGenre">
                <pos>0.567 0.69</pos>
                <size>0.11 0.04</size>
                <text>${lblGenre}</text>
                <fontPath>${jaBold}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${ink1}</color>
                <zIndex>12</zIndex>
            </text>
            <text name="genre">
                <pos>0.667 0.69</pos>
                <size>0.236 0.04</size>
                <metadata>genre</metadata>
                <defaultValue>―</defaultValue>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${body}</color>
                <zIndex>12</zIndex>
            </text>
            <text name="labelPlayers">
                <pos>0.567 0.735</pos>
                <size>0.11 0.04</size>
                <text>${lblPlayers}</text>
                <fontPath>${jaBold}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${ink1}</color>
                <zIndex>12</zIndex>
            </text>
            <text name="players">
                <pos>0.667 0.735</pos>
                <size>0.236 0.04</size>
                <metadata>players</metadata>
                <defaultValue>―</defaultValue>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.024</fontSize>
                <color>${body}</color>
                <zIndex>12</zIndex>
            </text>
            <!-- the game's description (from scraping), scrolling slowly when it's long -->
            <text name="description">
                <pos>0.567 0.79</pos>
                <size>0.336 0.125</size>
                <metadata>description</metadata>
                <container>true</container>
                <containerType>vertical</containerType>
                <containerStartDelay>4.5</containerStartDelay>
                <containerResetDelay>7</containerResetDelay>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.02</fontSize>
                <lineSpacing>1.4</lineSpacing>
                <color>${body}</color>
                <zIndex>12</zIndex>
            </text>
            <!-- with a cover, box or disc: it on the left, a screenshot on the right -->
            <image name="boxArt">
                <pos>0.6407 0.249</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.1566 0.3515</maxSize>
                <imageType>cover</imageType>
                <default>./core/default-cover.svg</default>
                <scrollFadeIn>true</scrollFadeIn>
                <visible>false</visible>
                <zIndex>11</zIndex>
            </image>
            <image name="boxShot">
                <pos>0.8151 0.249</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.1851 0.3515</maxSize>
                <imageType>screenshot, titlescreen</imageType>
                <scrollFadeIn>true</scrollFadeIn>
                <visible>false</visible>
                <zIndex>11</zIndex>
            </image>
            <!-- the game's region (from its file name), its flags stamped in the data box's corner -->
            <image name="flag">
                <pos>0.903 0.775</pos>
                <origin>1 1</origin>
                <maxSize>0.04 0.034</maxSize>
                <imageType>flag</imageType>
                <zIndex>13</zIndex>
            </image>
            <image name="flag2">
                <pos>0.856 0.775</pos>
                <origin>1 1</origin>
                <maxSize>0.04 0.034</maxSize>
                <imageType>flag2</imageType>
                <zIndex>13</zIndex>
            </image>
        </view>
    </variant>

    <!-- the games in a column of the page, the selected one inked -->
    <variant name="list, list-title, list-cover, list-box, list-media, list-video">
        <view name="gamelist">
            <image name="column">
                <pos>0.04 0.17</pos>
                <size>0.48 0.76</size>
                <path>./core/block.svg</path>
                <color>${paper}E8</color>
                <zIndex>10</zIndex>
            </image>
            <textlist name="gamelist">
                <regionFlags>true</regionFlags>
                <pos>0.05 0.18</pos>
                <size>0.46 0.74</size>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.028</fontSize>
                <lineSpacing>1.6</lineSpacing>
                <primaryColor>${body}</primaryColor>
                <secondaryColor>${ink1}</secondaryColor>
                <selectedColor>${selText}</selectedColor>
                <selectedSecondaryColor>${selText}</selectedSecondaryColor>
                <selectedBackgroundColor>${ink1}</selectedBackgroundColor>
                <selectedSecondaryBackgroundColor>${ink1}</selectedSecondaryBackgroundColor>
                <selectedBackgroundMargins>0.004 0.004</selectedBackgroundMargins>
                <horizontalMargin>0.01</horizontalMargin>
                <letterCase>none</letterCase>
                <zIndex>20</zIndex>
            </textlist>
        </view>
    </variant>

    <!-- the covers in a grid on the page -->
    <variant name="grid, grid-title, grid-cover, grid-box, grid-media, grid-video">
        <view name="gamelist">
            <image name="column">
                <pos>0.04 0.17</pos>
                <size>0.48 0.76</size>
                <path>./core/block.svg</path>
                <color>${paper}E8</color>
                <zIndex>10</zIndex>
            </image>
            <grid name="gamelist">
                <pos>0.05 0.185</pos>
                <size>0.46 0.73</size>
                <itemSize>0.1 0.22</itemSize>
                <itemScale>1.08</itemScale>
                <itemSpacing>0.014 0.025</itemSpacing>
                <imageType>cover</imageType>
                <defaultImage>./core/default-cover.svg</defaultImage>
                <imageFit>contain</imageFit>
                <unfocusedItemOpacity>0.75</unfocusedItemOpacity>
                <textColor>${body}</textColor>
                <fontPath>${jaRegular}</fontPath>
                <fontSize>0.018</fontSize>
                <zIndex>20</zIndex>
            </grid>
        </view>
    </variant>

    <!-- a review page: the game's screen large, its data and the list beside it -->
    <variant name="review, review-title, review-cover, review-box, review-media, review-video">
        <view name="gamelist">
            <image name="flag">
                <pos>0.903 0.384</pos>
            </image>
            <image name="flag2">
                <pos>0.856 0.384</pos>
            </image>
            <text name="headline">
                <size>0.52 0.09</size>
            </text>
            <image name="screenFrame">
                <pos>0.045 0.17</pos>
                <size>0.52 0.6</size>
            </image>
            <image name="screen">
                <pos>0.305 0.47</pos>
                <maxSize>0.512 0.586</maxSize>
            </image>
            <video name="screenVideo">
                <pos>0.305 0.47</pos>
                <maxSize>0.512 0.586</maxSize>
            </video>
            <image name="dataBox">
                <pos>0.6 0.064</pos>
                <size>0.313 0.33</size>
            </image>
            <image name="descBox">
                <pos>0.045 0.79</pos>
                <size>0.52 0.14</size>
                <path>./core/block.svg</path>
                <color>${paper}</color>
                <zIndex>10</zIndex>
            </image>
            <text name="description">
                <pos>0.055 0.8</pos>
                <size>0.5 0.12</size>
            </text>
            <image name="boxArt">
                <pos>0.1672 0.4700</pos>
                <maxSize>0.2288 0.5700</maxSize>
            </image>
            <image name="boxShot">
                <pos>0.4220 0.4700</pos>
                <maxSize>0.2704 0.5700</maxSize>
            </image>
            <image name="dataRule">
                <pos>0.61 0.174</pos>
                <size>0.293 0.004</size>
            </image>
            <text name="gameName">
                <pos>0.61 0.074</pos>
                <size>0.293 0.095</size>
            </text>
            <text name="labelDate">
                <pos>0.61 0.194</pos>
            </text>
            <datetime name="date">
                <pos>0.71 0.194</pos>
                <size>0.193 0.04</size>
            </datetime>
            <text name="labelMaker">
                <pos>0.61 0.239</pos>
            </text>
            <text name="maker">
                <pos>0.71 0.239</pos>
                <size>0.193 0.04</size>
            </text>
            <text name="labelGenre">
                <pos>0.61 0.284</pos>
            </text>
            <text name="genre">
                <pos>0.71 0.284</pos>
                <size>0.193 0.04</size>
            </text>
            <text name="labelPlayers">
                <pos>0.61 0.329</pos>
            </text>
            <text name="players">
                <pos>0.71 0.329</pos>
                <size>0.193 0.04</size>
            </text>
            <image name="column">
                <pos>0.6 0.42</pos>
                <size>0.313 0.51</size>
