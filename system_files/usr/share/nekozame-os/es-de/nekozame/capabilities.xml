<!-- nekozame for ES-DE: every system a page from a 90s japanese game magazine. the
     pages are printed on your machine (nekozame-emu esde) from public-domain NOAA
     photos and your own games' screens. -->
<themeCapabilities>
    <themeName>nekozame</themeName>

    <language>en_US</language>
    <language>ja_JP</language>

    <colorScheme name="nekozame">
        <label>nekozame</label>
    </colorScheme>
    <colorScheme name="ocean">
        <label>ocean</label>
    </colorScheme>

    <variant name="list">
        <label language="en_US">game list</label>
        <label language="ja_JP">ゲームリスト</label>
        <selectable>true</selectable>
    </variant>
    <variant name="grid">
        <label language="en_US">cover grid</label>
        <label language="ja_JP">パッケージ一覧</label>
        <selectable>true</selectable>
    </variant>
</themeCapabilities>
