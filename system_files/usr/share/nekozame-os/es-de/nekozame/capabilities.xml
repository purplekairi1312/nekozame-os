<!-- nekozame for ES-DE: every system a page from a 90s japanese game magazine. the
     pages are printed on your machine (nekozame-emu esde) from public-domain NOAA
     photos and your own games' screens. -->
<themeCapabilities>
    <themeName>nekozame</themeName>

    <language>en_US</language>
    <language>ja_JP</language>

    <colorScheme name="nekozame">
        <label language="en_US">nekozame</label>
        <label language="ja_JP">ネコザメ</label>
    </colorScheme>
    <colorScheme name="lilac">
        <label language="en_US">lilac</label>
        <label language="ja_JP">ライラック</label>
    </colorScheme>
    <colorScheme name="sakura">
        <label language="en_US">sakura</label>
        <label language="ja_JP">さくら</label>
    </colorScheme>
    <colorScheme name="ocean">
        <label language="en_US">ocean</label>
        <label language="ja_JP">海</label>
    </colorScheme>
    <colorScheme name="sunset">
        <label language="en_US">sunset</label>
        <label language="ja_JP">夕焼け</label>
    </colorScheme>

    <variant name="list">
        <label language="en_US">game list</label>
        <label language="ja_JP">ゲームリスト</label>
