<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>nekozame os</vendor>
  <action id="org.nekozame.decky">
    <description>Install Decky and nekozame's plugins</description>
    <message>nekozame wants to install Decky, with nekozame music and SteamGridDB</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nekozame-decky</annotate>
  </action>
</policyconfig>
